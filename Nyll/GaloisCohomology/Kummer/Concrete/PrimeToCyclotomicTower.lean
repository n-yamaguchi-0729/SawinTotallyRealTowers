import Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.NormalCyclotomicTower
import Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.CyclotomicGaloisCard
import Mathlib.Algebra.Algebra.Tower
import Mathlib.FieldTheory.Galois.Basic
import Mathlib.FieldTheory.Normal.Basic
import Mathlib.FieldTheory.Normal.Defs
import Mathlib.FieldTheory.SeparableDegree
import Mathlib.NumberTheory.Cyclotomic.Basic
import Mathlib.LinearAlgebra.FiniteDimensional.Defs
import Mathlib.LinearAlgebra.Dimension.Free
import Mathlib.Data.Nat.Prime.Basic

/-!
# A prime-to-p cyclotomic tower and its actual restriction kernel

Start with a prime-degree Galois extension `M/F`, and adjoin the p-th roots
of unity to `M`. When the two primes differ, the resulting extension over
`F` is finite Galois with order coprime to p. This uses the tower law and
normality of the cyclotomic tower, without linear disjointness.

The cyclotomic field can be supplied by the existing
`exists_cyclotomic_intermediateField M Ω p`. Its composite `F`-algebra and
the `F/M/E` scalar tower are fixed by the caller once. No extra field,
valuation, finiteness, or comparison input is needed in this boundary.
-/

namespace KummerTheory

open ValuationTheory.DiscreteValuationField

universe u v w

variable (F : Type u) (M : Type v) (E : Type w) [Field F] [Field M] [Field E]
  [Algebra F M] [Algebra F E] [Algebra M E] [IsScalarTower F M E]

/-- The actual cyclotomic tower over a prime-degree Galois extension is
finite Galois of order prime to p, and restriction to the lower extension
is surjective. Finiteness of the lower extension is generated by its degree. -/
theorem primeTo_cyclotomic_tower_data
    [IsGalois F M] (p r : ℕ) [Fact p.Prime] [Fact r.Prime]
    [IsCyclotomicExtension {p} M E]
    (hrp : r ≠ p) (hdegree : Module.finrank F M = r) :
    FiniteDimensional F E ∧ IsGalois F E ∧
      p.Coprime (Nat.card Gal(E/F)) ∧
        Function.Surjective (AlgEquiv.restrictNormalHom M : Gal(E/F) →* Gal(M/F)) := by
  have : FiniteDimensional F M :=
    FiniteDimensional.of_finrank_pos (hdegree.symm ▸ (Fact.out : r.Prime).pos)
  have : FiniteDimensional M E := IsCyclotomicExtension.finiteDimensional {p} M E
  have : FiniteDimensional F E := FiniteDimensional.trans F M E
  have : IsGalois M E := IsCyclotomicExtension.isGalois {p} M E
  have : IsGalois F E :=
    { to_isSeparable := Algebra.IsSeparable.trans (F := F) (E := M) (K := E)
      to_normal := normal_cyclotomic_tower F M E p }
  have hFM : p.Coprime (Module.finrank F M) := by
    rw [hdegree]
    exact (Nat.coprime_primes (Fact.out : p.Prime) (Fact.out : r.Prime)).mpr hrp.symm
  have hME : p.Coprime (Module.finrank M E) := by
    rw [← IsGalois.card_aut_eq_finrank M E]
    exact prime_coprime_cyclotomicGalois_natCard M E p
  have hcard : p.Coprime (Nat.card Gal(E/F)) := by
    rw [IsGalois.card_aut_eq_finrank F E, ← Module.finrank_mul_finrank F M E]
    exact hFM.mul_right hME
  exact ⟨inferInstance, inferInstance, hcard,
    AlgEquiv.restrictNormalHom_surjective (F := F) (K₁ := M) (E := E)⟩

/-- The image of actual scalar restriction is exactly the kernel of actual
restriction to `M`. Thus this image is normal, with no comparison assumption;
the automorphism in the kernel itself supplies the M-linear representative. -/
theorem restrictScalarsHom_range_eq_normalRestrictionKer [Normal F M] :
    (AlgEquiv.restrictScalarsHom F : Gal(E/M) →* Gal(E/F)).range =
      (AlgEquiv.restrictNormalHom M : Gal(E/F) →* Gal(M/F)).ker := by
  apply le_antisymm
  · rintro σ ⟨δ, rfl⟩
    change (δ.restrictScalars F).restrictNormal M = 1
    apply AlgEquiv.ext
    intro m
    apply (algebraMap M E).injective
    change algebraMap M E ((δ.restrictScalars F).restrictNormal M m) =
      algebraMap M E m
    rw [AlgEquiv.restrictNormal_commutes]
    exact δ.commutes m
  · intro σ hσ
    have hσ' : σ.restrictNormal M = 1 := hσ
    let δ : Gal(E/M) :=
      { σ.toRingEquiv with
        commutes' := fun m => by
          change σ (algebraMap M E m) = algebraMap M E m
          rw [← σ.restrictNormal_commutes M m, hσ']
          rfl }
    refine ⟨δ, ?_⟩
    apply AlgEquiv.ext
    intro x
    rfl

end KummerTheory
