import Nyll.SchemeTheory.FiniteEtale.InverseLimitGluingRelations
import Nyll.SchemeTheory.FiniteEtale.RelativeOverlapFiniteness
import Nyll.SchemeTheory.FiniteEtale.RelativePullbackGluing
import Nyll.SchemeTheory.Gluing.RelativePullbackRecovery

/-!
# An actual inverse-limit model from recovered local charts

All finiteness properties and gluing relations are proved from finite-etale
local models and their actual recovered chart overlaps. The resulting
scheme is finite etale over an original later stage, and its literal native
pullback recovers the originally given finite-etale object.
-/

noncomputable section

universe u

open CategoryTheory Limits
open AlgebraicGeometry.Scheme.Cover

namespace AlgebraicGeometry.FiniteEtale

/-- Actual recovered local charts produce a finite-etale model at a later
original stage. Diagonal and triple laws are generated by eventual equality. -/
theorem exists_inverse_limit_model_of_recovered_charts
    {I : Type u} [Category.{u} I] [IsCofiltered I]
    (D : I ⥤ Scheme.{u}) (c : Cone D) (hc : IsLimit c)
    [∀ {i j : I} (h : i ⟶ j), IsAffineHom (D.map h)]
    [∀ i : I, CompactSpace (D.obj i)] [∀ i : I, QuasiSeparatedSpace (D.obj i)]
    (i : I) (𝒰 : (D.obj i).OpenCover.{u}) [Finite 𝒰.I₀]
    [∀ a : 𝒰.I₀, CompactSpace (𝒰.X a)]
    (A : 𝒰.I₀ → Over (D.obj i)) (V : 𝒰.I₀ × 𝒰.I₀ → Over (D.obj i))
    (d : ∀ a b : 𝒰.I₀, V (a, b) ⟶ A a)
    (y : ∀ a : 𝒰.I₀, (A a).left ⟶ 𝒰.X a)
    [∀ a : 𝒰.I₀, IsFiniteEtale (y a)]
    (hy : ∀ a : 𝒰.I₀, y a ≫ 𝒰.f a = (A a).hom)
    (ℓ : ∀ a b : 𝒰.I₀, (V (a, b)).left ⟶ 𝒰.X b)
    (hV : ∀ a b : 𝒰.I₀,
      IsPullback (d a b).left (ℓ a b) (y a ≫ 𝒰.f a) (𝒰.f b))
    (t : ∀ a b : 𝒰.I₀, V (a, b) ⟶ V (b, a))
    (ht : ∀ a b : 𝒰.I₀, (t a b).left ≫ (d b a).left ≫ y b = ℓ a b)
    (X : FiniteEtale c.pt)
    (h : ∀ a : 𝒰.I₀,
      (Over.pullback (c.π.app i)).obj (A a) ⟶ (FiniteEtale.forget c.pt).obj X)
    [∀ a : 𝒰.I₀, IsOpenImmersion (h a).left]
    (hcover : ∀ x : X.left, ∃ (a : 𝒰.I₀)
      (z : ((Over.pullback (c.π.app i)).obj (A a)).left), (h a).left z = x)
    (hoverlap : ∀ a b : 𝒰.I₀,
      IsPullback ((Over.pullback (c.π.app i)).map (d a b)).left
        ((Over.pullback (c.π.app i)).map (t a b ≫ d b a)).left (h a).left (h b).left) :
    ∃ (j : I) (_ : j ⟶ i) (N : FiniteEtale (D.obj j)),
      Nonempty ((FiniteEtale.pullback (c.π.app j)).obj N ≅ X) := by
  have : ∀ a : 𝒰.I₀, CompactSpace (V (a, a)).left :=
    fun a ↦ relativeOverlap_compactSpace 𝒰 A V d y ℓ hV a a
  have : ∀ a : 𝒰.I₀, QuasiCompact (V (a, a)).hom := fun a ↦ inferInstance
  have : ∀ a : 𝒰.I₀, LocallyOfFiniteType (V (a, a)).hom :=
    fun a ↦ relativeOverlap_locallyOfFiniteType 𝒰 A V d y ℓ hV hy a a
  have : ∀ a b d' : 𝒰.I₀, CompactSpace (relativeTriple 𝒰 A V d a b d').left :=
    relativeTriple_compactSpace 𝒰 A V d y ℓ hV
  have : ∀ a b d' : 𝒰.I₀, QuasiCompact (relativeTriple 𝒰 A V d a b d').hom :=
    fun a b d' ↦ inferInstance
  have : ∀ a b d' : 𝒰.I₀, LocallyOfFiniteType (relativeTriple 𝒰 A V d a b d').hom :=
    relativeTriple_locallyOfFiniteType 𝒰 A V d y ℓ hV hy
  let K : Over (D.obj i) ⥤ Scheme.{u} := relativeRecoveryFunctor (c.π.app i)
  have hrec (a b : 𝒰.I₀) : K.map (t a b) ≫ K.map (d b a) ≫ (h b).left =
      K.map (d a b) ≫ (h a).left := by
    have H : K.map (d a b) ≫ (h a).left = K.map (t a b ≫ d b a) ≫ (h b).left :=
      (hoverlap a b).w
    rw [K.map_comp, Category.assoc] at H
    exact H.symm
  have hmono : ∀ a : 𝒰.I₀, Mono (h a).left := fun a ↦ inferInstance
  obtain ⟨j, hji, hdiag, hcycle⟩ := exists_inverse_limit_stage_gluing_relations
    D c hc i 𝒰 A V d y ℓ hV t ht X.left (fun a ↦ (h a).left) (hmono := hmono) hrec
  obtain ⟨q, hq, hqU⟩ := exists_relativePullbackGlue_finiteEtale
    𝒰 A V d y hy ℓ hV t ht (D.map hji) hdiag hcycle
  have : IsFiniteEtale q := hq
  let N : FiniteEtale (D.obj j) := FiniteEtale.mk q
  obtain ⟨e⟩ := exists_relativePullbackGlue_recovery_iso
    𝒰 A V d y ℓ hV t ht (D.map hji) hdiag hcycle q hqU
    (c.π.app j) (c.π.app i) (c.w hji).symm ((FiniteEtale.forget c.pt).obj X)
    h hcover hoverlap
  exact ⟨j, hji, N, ⟨(FiniteEtale.forget c.pt).preimageIso e⟩⟩

end AlgebraicGeometry.FiniteEtale
