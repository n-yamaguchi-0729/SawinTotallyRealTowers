import Nyll.SchemeTheory.AbhyankarLemma.Geometry.Inertia.FieldTower
import Nyll.ValuedFieldTheory.Ramification.GaloisValuation.CompositumRestriction

/-!
# Inertia on a compositum

An automorphism of a field generated by two intermediate fields is determined
by its restrictions to the two fields.  This gives the injective map from the
inertia group of a compositum to the product of the two lower inertia groups
used in SGA 1, Expose X, Lemma 3.6.
-/

noncomputable section

universe u v

namespace TameAbhyankar.SGA1

open RamificationTheory.HilbertRamification.ValuationSubring

variable (K : Type u) {E : Type v} [Field K] [Field E] [Algebra K E]

/-- Restriction of field automorphisms to two normal intermediate fields is
jointly injective when those fields generate the ambient field. -/
theorem restrictNormalHom_prod_injective_of_sup_eq_top
    (M N : IntermediateField K E) [Normal K M] [Normal K N]
    (hsup : M ⊔ N = ⊤) :
    Function.Injective
      ((AlgEquiv.restrictNormalHom (F := K) (K₁ := E) M).prod
        (AlgEquiv.restrictNormalHom (F := K) (K₁ := E) N)) := by
  exact LocalClassFieldTheory.restrictNormalHom_prod_injective_of_sup_eq_top
    K M N hsup

/-- If `M` and `N` generate `E`, the two inertia restriction maps jointly
embed the inertia group over `K` into the product of the lower inertia
groups. -/
theorem inertiaRestriction_prod_injective_of_sup_eq_top
    (M N : IntermediateField K E) [Normal K M] [Normal K N]
    (A : _root_.ValuationSubring E) (hsup : M ⊔ N = ⊤) :
    Function.Injective
      ((inertiaRestriction K M A).prod (inertiaRestriction K N A)) := by
  intro sigma tau h
  have hM := congrArg Prod.fst h
  have hN := congrArg Prod.snd h
  have hM' : inertiaRestriction K M A sigma =
      inertiaRestriction K M A tau := by
    change inertiaRestriction K M A sigma =
      inertiaRestriction K M A tau at hM
    exact hM
  have hN' : inertiaRestriction K N A sigma =
      inertiaRestriction K N A tau := by
    change inertiaRestriction K N A sigma =
      inertiaRestriction K N A tau at hN
    exact hN
  apply Subtype.ext
  apply Subtype.ext
  apply restrictNormalHom_prod_injective_of_sup_eq_top K M N hsup
  apply Prod.ext
  · change
      AlgEquiv.restrictNormalHom (F := K) (K₁ := E) M
          ((((sigma : inertiaGroup K A) : decompositionGroup K A) :
            E ≃ₐ[K] E)) =
        AlgEquiv.restrictNormalHom (F := K) (K₁ := E) M
          ((((tau : inertiaGroup K A) : decompositionGroup K A) :
            E ≃ₐ[K] E))
    apply AlgEquiv.ext
    intro x
    have hx := congrArg
      (fun rho : inertiaGroup K (A.comap M.val.toRingHom) ↦
        (((rho : decompositionGroup K (A.comap M.val.toRingHom)) :
          M ≃ₐ[K] M) x)) hM'
    have hx' := congrArg (fun y : M ↦ (y : E)) hx
    apply Subtype.ext
    rw [AlgEquiv.restrictNormalHom_apply, AlgEquiv.restrictNormalHom_apply]
    exact (inertiaRestriction_apply_coe K M A sigma x).symm.trans
      (hx'.trans (inertiaRestriction_apply_coe K M A tau x))
  · change
      AlgEquiv.restrictNormalHom (F := K) (K₁ := E) N
          ((((sigma : inertiaGroup K A) : decompositionGroup K A) :
            E ≃ₐ[K] E)) =
        AlgEquiv.restrictNormalHom (F := K) (K₁ := E) N
          ((((tau : inertiaGroup K A) : decompositionGroup K A) :
            E ≃ₐ[K] E))
    apply AlgEquiv.ext
    intro x
    have hx := congrArg
      (fun rho : inertiaGroup K (A.comap N.val.toRingHom) ↦
        (((rho : decompositionGroup K (A.comap N.val.toRingHom)) :
          N ≃ₐ[K] N) x)) hN'
    have hx' := congrArg (fun y : N ↦ (y : E)) hx
    apply Subtype.ext
    rw [AlgEquiv.restrictNormalHom_apply, AlgEquiv.restrictNormalHom_apply]
    exact (inertiaRestriction_apply_coe K N A sigma x).symm.trans
      (hx'.trans (inertiaRestriction_apply_coe K N A tau x))

end TameAbhyankar.SGA1
