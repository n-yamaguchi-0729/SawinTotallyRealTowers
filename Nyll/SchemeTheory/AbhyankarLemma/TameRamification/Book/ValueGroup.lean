/-!
# Book value groups of tame radical extensions

This file supplies the value-group generation source needed for the classical
ramification-index form of Abhyankar's lemma.  It starts with the group-theory
comparison between the order of one value coset and the relative index of the
subgroup generated by that value.
-/

noncomputable section

universe u

namespace TameAbhyankar

open AlgebraicNumberTheory.Valuations

local instance bookValueGroupQuotientAddCommGroup
    {K L : Type*} [Field K] [Field L]
    (v : LubinTate.Valuations.ExponentialValuation K)
    (w : LubinTate.Valuations.ExponentialValuation L) :
    AddCommGroup (ExponentialValueGroupQuotient v w) := by
  unfold ExponentialValueGroupQuotient
  infer_instance

/-- The book ramification index is the relative index of the source value
subgroup in the target value subgroup, both viewed inside `ℝ`. -/
theorem bookRamificationIndex_eq_valueSubgroup_relIndex
    {K L : Type u} [Field K] [Field L]
    (v : LubinTate.Valuations.ExponentialValuation K)
    (w : LubinTate.Valuations.ExponentialValuation L) :
    exponentialRamificationIndex v w =
      (exponentialValueSubgroup v).relIndex
        (exponentialValueSubgroup w) := by
  rfl

/-- The actual value-group ramification index of a finite extension is
positive. -/
theorem bookRamificationIndex_pos
    {K L : Type u} [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L]
    (v : LubinTate.Valuations.ExponentialValuation K)
    (w : LubinTate.Valuations.ExponentialValuation L)
    (hExt : ∀ a : K, w (algebraMap K L a) = v a) :
    0 < exponentialRamificationIndex v w := by
  let : Finite (ExponentialValueGroupQuotient v w) :=
    exponentialValueGroupQuotient_finite_of_finiteDimensional v w hExt
  unfold exponentialRamificationIndex
  exact Nat.card_pos

/-- Ramification index one means equality of the actual value subgroups. -/
theorem bookExponentialValueSubgroup_eq_of_ramificationIndex_eq_one
    {K L : Type u} [Field K] [Field L] [Algebra K L]
    (v : LubinTate.Valuations.ExponentialValuation K)
    (w : LubinTate.Valuations.ExponentialValuation L)
    (hExt : ∀ a : K, w (algebraMap K L a) = v a)
    (he : exponentialRamificationIndex v w = 1) :
    exponentialValueSubgroup w = exponentialValueSubgroup v := by
  apply le_antisymm
  · apply AddSubgroup.relIndex_eq_one.mp
    rw [← bookRamificationIndex_eq_valueSubgroup_relIndex v w]
    exact he
  · exact exponentialValueSubgroup_le_of_extends v w hExt

/-- Adjoining one additive generator to a subgroup has relative index equal
to the additive order of that generator modulo the original subgroup. -/
theorem relIndex_sup_zmultiples_eq_addOrderOf
    {G : Type u} [AddCommGroup G] (H : AddSubgroup G) (x : G) :
    H.relIndex (H ⊔ AddSubgroup.zmultiples x) =
      addOrderOf (QuotientAddGroup.mk x : G ⧸ H) := by
  let Z : AddSubgroup G := AddSubgroup.zmultiples x
  let f : Z →+ G ⧸ H :=
    (QuotientAddGroup.mk' H).comp Z.subtype
  have hker : f.ker = H.addSubgroupOf Z := by
    ext z
    change ((↑(z : G) : G ⧸ H) = 0) ↔ (z : G) ∈ H
    exact QuotientAddGroup.eq_zero_iff (z : G)
  have hrange : f.range =
      AddSubgroup.zmultiples (QuotientAddGroup.mk x : G ⧸ H) := by
    calc
      f.range = Z.map (QuotientAddGroup.mk' H) := by
        rw [AddMonoidHom.range_comp, Z.range_subtype]
      _ = AddSubgroup.zmultiples
          ((QuotientAddGroup.mk' H) x) := by
        exact AddMonoidHom.map_zmultiples (QuotientAddGroup.mk' H) x
      _ = AddSubgroup.zmultiples
          (QuotientAddGroup.mk x : G ⧸ H) := rfl
  calc
    H.relIndex (H ⊔ AddSubgroup.zmultiples x) = H.relIndex Z := by
      exact AddSubgroup.relIndex_sup_left Z H
    _ = (H.addSubgroupOf Z).index := rfl
    _ = f.ker.index := by rw [hker]
    _ = Nat.card (Z ⧸ f.ker) := rfl
    _ = Nat.card f.range :=
      Nat.card_congr (QuotientAddGroup.quotientKerEquivRange f).toEquiv
    _ = Nat.card
        (AddSubgroup.zmultiples (QuotientAddGroup.mk x : G ⧸ H)) := by
      rw [hrange]
    _ = addOrderOf (QuotientAddGroup.mk x : G ⧸ H) := by
      exact Nat.card_zmultiples _

/-- A single prime-to-the-residue-characteristic radical generates the
whole target value group over the base value group.  This is the subgroup
form of the degree computation in Proposition 7.7. -/
theorem bookExponentialValueSubgroup_eq_sup_zmultiples_of_single_radical_of_separableResidue
    {K L : Type u} [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L]
    (v : LubinTate.Valuations.ExponentialValuation K)
    (w : LubinTate.Valuations.ExponentialValuation L)
    (hExt : ∀ a : K, w (algebraMap K L a) = v a)
    (hhens : ValuationTheory.DiscreteValuationField.HenselianValuationByFactorization
      (LubinTate.Valuations.exponentialValuationSubringAsValuationSubring v).valuation)
    (hp : PositiveResidueCharacteristic v)
    (hresidue : SeparableResidueRootLifts v w hExt)
    (alpha : L) (halpha0 : alpha ≠ 0)
    (hgen : IntermediateField.adjoin K ({alpha} : Set L) = ⊤)
    (m : ℕ) (hmpos : 0 < m)
    (hmcop : Nat.Coprime m (residueCharacteristic v))
    (a : K) (hpow : alpha ^ m = algebraMap K L a) :
    exponentialValueSubgroup w =
      exponentialValueSubgroup v ⊔
        AddSubgroup.zmultiples (w alpha).untop₀ := by
  classical
  let GammaV := exponentialValueSubgroup v
  let GammaW := exponentialValueSubgroup w
  have hVW : GammaV ≤ GammaW :=
    exponentialValueSubgroup_le_of_extends v w hExt
  have halphaTop : w alpha ≠ ⊤ :=
    LubinTate.Valuations.exponentialValuation_ne_top_of_ne_zero w halpha0
  let x : GammaW :=
    ⟨(w alpha).untop₀, ⟨alpha, halpha0,
      (WithTop.coe_untop₀_of_ne_top halphaTop).symm⟩⟩
  let H : AddSubgroup GammaW := GammaV.comap GammaW.subtype
  let J : AddSubgroup GammaW := H ⊔ AddSubgroup.zmultiples x
  let q := exponentialValueCoset v w alpha halpha0
  have hgenerated : H.relIndex J = addOrderOf q := by
    calc
      H.relIndex J =
          addOrderOf (QuotientAddGroup.mk x : GammaW ⧸ H) := by
        exact relIndex_sup_zmultiples_eq_addOrderOf H x
      _ = addOrderOf q := by
        rfl
  have htotal : H.relIndex ⊤ = addOrderOf q := by
    calc
      H.relIndex ⊤ = H.index := H.relIndex_top_right
      _ = exponentialRamificationIndex v w := by rfl
      _ = Module.finrank K L :=
        exponentialRamificationIndex_eq_finrank_of_single_radical_of_separableResidue
          v w hExt hhens hp hresidue alpha halpha0 hgen
            m hmpos hmcop a hpow
      _ = addOrderOf q :=
        finrank_eq_addOrderOf_valueCoset_of_single_radical_of_separableResidue
          v w hExt hhens hp hresidue alpha halpha0 hgen
            m hmpos hmcop a hpow
  have hmul := AddSubgroup.relIndex_mul_relIndex H J
    (⊤ : AddSubgroup GammaW) le_sup_left le_top
  have hqpos : 0 < addOrderOf q :=
    exponentialValueGroupQuotient_addOrderOf_pos v w hExt q
  have hJone : J.relIndex (⊤ : AddSubgroup GammaW) = 1 := by
    rw [hgenerated, htotal] at hmul
    have hcancel :
        addOrderOf q * J.relIndex (⊤ : AddSubgroup GammaW) =
          addOrderOf q * 1 := by
      simpa only [mul_one] using hmul
    exact Nat.eq_of_mul_eq_mul_left hqpos hcancel
  have hJtop : J = (⊤ : AddSubgroup GammaW) := by
    exact top_unique (AddSubgroup.relIndex_eq_one.mp hJone)
  have hmap := congrArg (fun A : AddSubgroup GammaW => A.map GammaW.subtype) hJtop
  simp only [J, H, AddSubgroup.map_sup, AddSubgroup.map_comap_eq,
    GammaW.range_subtype, inf_eq_right.mpr hVW,
    AddMonoidHom.map_zmultiples] at hmap
  have htopmap :
      (⊤ : AddSubgroup GammaW).map GammaW.subtype = GammaW := by
    rw [← AddMonoidHom.range_eq_map, GammaW.range_subtype]
  have hx : GammaW.subtype x = (w alpha).untop₀ := rfl
  rw [htopmap, hx] at hmap
  exact hmap.symm

/-- Surjective-residue-field specialization of the single-radical value
group generation theorem. -/
theorem bookExponentialValueSubgroup_eq_sup_zmultiples_of_single_radical
    {K L : Type u} [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L]
    (v : LubinTate.Valuations.ExponentialValuation K)
    (w : LubinTate.Valuations.ExponentialValuation L)
    (hExt : ∀ a : K, w (algebraMap K L a) = v a)
    (hhens : ValuationTheory.DiscreteValuationField.HenselianValuationByFactorization
      (LubinTate.Valuations.exponentialValuationSubringAsValuationSubring v).valuation)
    (hp : PositiveResidueCharacteristic v)
    (hresidue : Function.Surjective (tameResidueFieldMap v w hExt))
    (alpha : L) (halpha0 : alpha ≠ 0)
    (hgen : IntermediateField.adjoin K ({alpha} : Set L) = ⊤)
    (m : ℕ) (hmpos : 0 < m)
    (hmcop : Nat.Coprime m (residueCharacteristic v))
    (a : K) (hpow : alpha ^ m = algebraMap K L a) :
    exponentialValueSubgroup w =
      exponentialValueSubgroup v ⊔
        AddSubgroup.zmultiples (w alpha).untop₀ := by
  have hlifts : SeparableResidueRootLifts v w hExt := by
    intro y _P _hP _hy
    exact hresidue y
  exact
    bookExponentialValueSubgroup_eq_sup_zmultiples_of_single_radical_of_separableResidue
      v w hExt hhens hp hlifts alpha halpha0 hgen
        m hmpos hmcop a hpow

end TameAbhyankar

end
