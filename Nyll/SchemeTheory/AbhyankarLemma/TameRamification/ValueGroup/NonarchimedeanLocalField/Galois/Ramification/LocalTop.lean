import Nyll.SchemeTheory.AbhyankarLemma.TameRamification.ValueGroup.NonarchimedeanLocalField.FieldNormImage
import Nyll.SchemeTheory.AbhyankarLemma.TameRamification.ValueGroup.NonarchimedeanLocalField.Galois.Ramification.ValueImage

/-!
# Local-top comparisons for powered Galois ramification images

This file records the lower local-top residue-degree consequences forced by
the powered embedded-base-unit image inside a field-norm subgroup.
-/

noncomputable section

universe u

namespace TameAbhyankar

open LocalFieldTheory.DiscreteValuationField
open scoped ValuativeRel

namespace NAField

variable {K L M : Type u}
variable [Field K] [Field L] [Field M]
variable [Algebra K L] [Algebra L M]
variable [ValuativeRel K] [TopologicalSpace K]
variable [IsNonarchimedeanLocalField K]
variable [ValuativeRel L] [TopologicalSpace L]
variable [IsNonarchimedeanLocalField L]
variable [FiniteDimensional K L] [IsGalois K L]
variable [Valuation.HasExtension (ValuativeRel.valuation K)
  (ValuativeRel.valuation L)]
variable [ValuativeRel M] [TopologicalSpace M]
variable [IsNonarchimedeanLocalField M]
variable [FiniteDimensional L M] [Algebra.IsSeparable L M]
variable [Valuation.HasExtension (ValuativeRel.valuation L)
  (ValuativeRel.valuation M)]

omit [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
    [FiniteDimensional K L] [IsGalois K L]
    [Valuation.HasExtension (ValuativeRel.valuation K)
      (ValuativeRel.valuation L)] in
/-- Any value generated by the embedded-base-unit image in `L`, after
multiplication by `[M : L]`, is divisible by the Neu1999 residue degree of
`M/L`. -/
theorem residueDegree_dvd_finrank_mul_val_of_mem_baseUnitsImage_tower
    {x : Lˣ} (hx : x ∈ baseUnitsImageSubgroup (K := K) (L := L)) :
    (Module.finrank 𝓀[L] 𝓀[M] : ℤ) ∣
      (Module.finrank L M : ℤ) *
        (multiplicativeIntegerValuation L).val x := by
  have hxnorm :
      x ^ Module.finrank L M ∈ fieldNormSubgroup L M :=
    pow_finrank_mem_fieldNormSubgroup_of_mem_baseUnitsImage_tower
      (K := K) (L := L) (M := M) hx
  have hxval :
      (multiplicativeIntegerValuation L).val
          (x ^ Module.finrank L M) =
        (Module.finrank L M : ℤ) *
          (multiplicativeIntegerValuation L).val x := by
    rw [(multiplicativeIntegerValuation L).val_pow]
  exact
    (exists_mem_fieldNormSubgroup_val_iff_residueDegree_dvd
      (K := L) (L := M)
      (n := (Module.finrank L M : ℤ) *
        (multiplicativeIntegerValuation L).val x)).1
      ⟨x ^ Module.finrank L M, hxnorm, hxval⟩

/-- Source-valued form of the lower-branch comparison: for every base unit
`x`, the residue degree of `M/L` divides `[M : L] * e_gal(L/K) * v_K(x)`. -/
theorem residueDegree_dvd_finrank_mul_galoisRamificationIndex_mul_val
    (x : Kˣ) :
    (Module.finrank 𝓀[L] 𝓀[M] : ℤ) ∣
      (Module.finrank L M : ℤ) *
        (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ) *
        (multiplicativeIntegerValuation K).val x := by
  have hxmem :
      LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits K L x ∈
        baseUnitsImageSubgroup (K := K) (L := L) :=
    mapBaseUnitsToExtensionUnits_mem_baseUnitsImageSubgroup
      (K := K) (L := L) x
  have hdiv :=
    residueDegree_dvd_finrank_mul_val_of_mem_baseUnitsImage_tower
      (K := K) (L := L) (M := M) hxmem
  rw [galois_mapBaseUnitsToExtensionUnits_valuation_formula
    (K := K) (L := L) x] at hdiv
  simpa [mul_assoc] using hdiv

/-- Integer-valued form of the lower-branch comparison.  Since the Neu1999
source valuation is onto `ℤ`, the previous source-valued divisibility holds
for every integer value. -/
theorem residueDegree_dvd_finrank_mul_galoisRamificationIndex_mul_int
    (n : ℤ) :
    (Module.finrank 𝓀[L] 𝓀[M] : ℤ) ∣
      (Module.finrank L M : ℤ) *
        (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ) *
        n := by
  rcases multiplicativeIntegerValuation_surjective K n with ⟨x, hx⟩
  have hdiv :=
    residueDegree_dvd_finrank_mul_galoisRamificationIndex_mul_val
      (K := K) (L := L) (M := M) x
  rw [hx] at hdiv
  exact hdiv

omit [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
    [FiniteDimensional K L] [IsGalois K L]
    [Valuation.HasExtension (ValuativeRel.valuation K)
      (ValuativeRel.valuation L)] in
/-- The value image of the powered embedded-base-unit subgroup inherits the
Neu1999 residue-degree value step from the field-norm subgroup. -/
theorem poweredBaseUnitsImageSubgroup_valueImage_le_residueDegree :
    (multiplicativeIntegerValuation L).subgroupValueSubgroup
        (poweredBaseUnitsImageSubgroup (K := K) (L := L) (M := M)) ≤
      integerMultipleSubgroup (Module.finrank 𝓀[L] 𝓀[M] : ℤ) := by
  have hmono :
      (multiplicativeIntegerValuation L).subgroupValueSubgroup
          (poweredBaseUnitsImageSubgroup (K := K) (L := L) (M := M)) ≤
        (multiplicativeIntegerValuation L).subgroupValueSubgroup
          (fieldNormSubgroup L M) :=
    MultiplicativeIntegerValuation.subgroupValueSubgroup_mono
      (multiplicativeIntegerValuation L)
      (poweredBaseUnitsImageSubgroup_le_fieldNormSubgroup
        (K := K) (L := L) (M := M))
  have hfield :=
    fieldNormSubgroup_valueImage_eq_residueDegree (K := L) (L := M)
  simpa [hfield] using hmono

/-- Integer-multiple subgroup form of the powered lower-branch comparison:
the subgroup generated by `[M : L] * e_gal(L/K)` lies in the value-step
subgroup cut out by the residue degree of `M/L`. -/
theorem integerMultipleSubgroup_finrank_mul_galoisRamificationIndex_le_residueDegree :
    integerMultipleSubgroup
        ((Module.finrank L M : ℤ) *
          (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ)) ≤
      integerMultipleSubgroup (Module.finrank 𝓀[L] 𝓀[M] : ℤ) := by
  have hpowered_eq :=
    poweredBaseUnitsImageSubgroup_valueImage_eq_finrank_mul_galoisRamificationIndex
      (K := K) (L := L) (M := M)
  have hpowered_le :=
    poweredBaseUnitsImageSubgroup_valueImage_le_residueDegree
      (K := K) (L := L) (M := M)
  simpa [hpowered_eq] using hpowered_le

/-- The powered ramification-image norm generator forces the Neu1999 residue
degree of `M/L` to divide `[M : L] * e_gal(L/K)`. -/
theorem residueDegree_dvd_finrank_mul_galoisRamificationIndex :
    Module.finrank 𝓀[L] 𝓀[M] ∣
      Module.finrank L M *
        Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] := by
  have hgen :=
    exists_mem_fieldNormSubgroup_val_finrank_mul_galoisRamificationIndex
      (K := K) (L := L) (M := M)
  exact
    (exists_mem_fieldNormSubgroup_val_nat_iff_residueDegree_dvd
      (K := L) (L := M)
      (n := Module.finrank L M *
        Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K])).1
      (by simpa [Nat.cast_mul] using hgen)

end NAField

end TameAbhyankar

end
