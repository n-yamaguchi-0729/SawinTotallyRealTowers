import Nyll.SchemeTheory.AbhyankarLemma.TameRamification.ValueGroup.NonarchimedeanLocalField.BaseNorm

/-!
# Basic Galois ramification-image subgroups

This file contains the subgroup constructions used by the Neu1999 Galois
ramification source: embedded base units, their tower transport, their
`[M : L]`-powered lower image, and the norm-down image in the base field.
-/

noncomputable section

universe u

namespace TameAbhyankar

open LocalFieldTheory
open LocalFieldTheory.DiscreteValuationField

namespace NAField

variable {K L : Type u}
variable [Field K] [Field L] [Algebra K L]

/-- The subgroup of extension units generated by embedded base units. -/
noncomputable def baseUnitsImageSubgroup : Subgroup Lˣ :=
  (LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits K L).range

@[simp] theorem mem_baseUnitsImageSubgroup_iff (x : Lˣ) :
    x ∈ baseUnitsImageSubgroup (K := K) (L := L) ↔
      ∃ y : Kˣ,
        LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits K L y = x :=
  Iff.rfl

theorem mapBaseUnitsToExtensionUnits_mem_baseUnitsImageSubgroup
    (x : Kˣ) :
    LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits K L x ∈
      baseUnitsImageSubgroup (K := K) (L := L) :=
  ⟨x, rfl⟩

section Tower

variable {M : Type u} [Field M] [Algebra K M] [Algebra L M]
variable [IsScalarTower K L M]

/-- Embedded base units are compatible with field towers. -/
theorem mapBaseUnitsToExtensionUnits_tower
    (x : Kˣ) :
    LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits L M
        (LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits K L x) =
      LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits K M x := by
  ext
  simpa [LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits] using
    (IsScalarTower.algebraMap_apply K L M (x : K)).symm

/-- Elementwise tower transport for the subgroup of embedded base units. -/
theorem mapBaseUnitsToExtensionUnits_mem_baseUnitsImageSubgroup_tower
    {x : Lˣ} (hx : x ∈ baseUnitsImageSubgroup (K := K) (L := L)) :
    LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits L M x ∈
      baseUnitsImageSubgroup (K := K) (L := M) := by
  rcases hx with ⟨y, hy⟩
  refine ⟨y, ?_⟩
  rw [← hy]
  exact (mapBaseUnitsToExtensionUnits_tower
    (K := K) (L := L) (M := M) y).symm

/-- Subgroup-level tower transport for embedded base units. -/
theorem baseUnitsImageSubgroup_map_le_tower :
    (baseUnitsImageSubgroup (K := K) (L := L)).map
        (LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits L M) ≤
      baseUnitsImageSubgroup (K := K) (L := M) := by
  intro x hx
  rcases hx with ⟨y, hyS, hyx⟩
  rw [← hyx]
  exact mapBaseUnitsToExtensionUnits_mem_baseUnitsImageSubgroup_tower
    (K := K) (L := L) (M := M) hyS

end Tower

section LowerNormTower

variable {M : Type u} [Field M] [Algebra L M]

/-- The `[M : L]`-power endomorphism on lower-branch units. -/
noncomputable def finrankPowerUnitsHom : Lˣ →* Lˣ where
  toFun x := x ^ Module.finrank L M
  map_one' := by
    simp
  map_mul' x y := by
    simpa using mul_pow x y (Module.finrank L M)

/-- The subgroup of lower-branch units obtained by taking `[M : L]`-th powers
of embedded base units. -/
noncomputable def poweredBaseUnitsImageSubgroup : Subgroup Lˣ :=
  (baseUnitsImageSubgroup (K := K) (L := L)).map
    (finrankPowerUnitsHom (L := L) (M := M))

/-- A powered embedded base unit lies in the powered image subgroup. -/
theorem pow_mem_poweredBaseUnitsImageSubgroup_of_mem
    {x : Lˣ} (hx : x ∈ baseUnitsImageSubgroup (K := K) (L := L)) :
    x ^ Module.finrank L M ∈
      poweredBaseUnitsImageSubgroup (K := K) (L := L) (M := M) :=
  ⟨x, hx, rfl⟩

/-- A base unit embedded from `K` to `L` has its `[M : L]`-th power in the norm
subgroup for `M/L`. -/
theorem mapBase_pow_finrank_mem_fieldNormSubgroup_tower
    (x : Kˣ) :
    LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits K L x ^
        Module.finrank L M ∈
      fieldNormSubgroup L M := by
  exact pow_finrank_mem_fieldNormSubgroup
    (K := L) (L := M)
    (LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits K L x)

/-- Elementwise comparison with the norm subgroup: every element of the
`K`-base-unit image inside `L` becomes a norm from `M/L` after taking the
`[M : L]`-th power. -/
theorem pow_finrank_mem_fieldNormSubgroup_of_mem_baseUnitsImage_tower
    {x : Lˣ} (hx : x ∈ baseUnitsImageSubgroup (K := K) (L := L)) :
    x ^ Module.finrank L M ∈ fieldNormSubgroup L M := by
  rcases hx with ⟨y, hy⟩
  rw [← hy]
  exact mapBase_pow_finrank_mem_fieldNormSubgroup_tower
    (K := K) (L := L) (M := M) y

/-- The powered embedded-base-unit image is contained in the field-norm
subgroup for `M/L`. -/
theorem poweredBaseUnitsImageSubgroup_le_fieldNormSubgroup :
    poweredBaseUnitsImageSubgroup (K := K) (L := L) (M := M) ≤
      fieldNormSubgroup L M := by
  intro x hx
  rcases hx with ⟨y, hyS, hyx⟩
  rw [← hyx]
  change y ^ Module.finrank L M ∈ fieldNormSubgroup L M
  exact pow_finrank_mem_fieldNormSubgroup_of_mem_baseUnitsImage_tower
    (K := K) (L := L) (M := M) hyS

end LowerNormTower

section NormDownTower

variable {M : Type u} [Field M] [Algebra K M] [Algebra L M]
variable [IsScalarTower K L M] [Module.Free L M]

/-- The `K`-norm image of the powered embedded-base-unit subgroup in the lower
branch.  This is a concrete candidate for the common-top ramification image
inside `Kˣ`. -/
noncomputable def normPoweredBaseUnitsImageSubgroup : Subgroup Kˣ :=
  (poweredBaseUnitsImageSubgroup (K := K) (L := L) (M := M)).map
    (normUnits K L)

omit [Algebra K M] [IsScalarTower K L M] [Module.Free L M] in
/-- A powered embedded base unit, after applying `N_{L/K}`, lies in the normed
powered image subgroup. -/
theorem fieldNormUnits_pow_mem_normPoweredBaseUnitsImageSubgroup_of_mem
    {x : Lˣ} (hx : x ∈ baseUnitsImageSubgroup (K := K) (L := L)) :
    normUnits K L (x ^ Module.finrank L M) ∈
      normPoweredBaseUnitsImageSubgroup (K := K) (L := L) (M := M) :=
  ⟨x ^ Module.finrank L M,
    pow_mem_poweredBaseUnitsImageSubgroup_of_mem
      (K := K) (L := L) (M := M) hx,
    rfl⟩

/-- Norm transitivity sends the normed powered embedded-base-unit image into
the common-top field-norm subgroup `N_{M/K}(Mˣ)`. -/
theorem normPoweredBaseUnitsImageSubgroup_le_fieldNormSubgroup_top :
    normPoweredBaseUnitsImageSubgroup (K := K) (L := L) (M := M) ≤
      fieldNormSubgroup K M := by
  intro x hx
  rcases hx with ⟨y, hyS, hyx⟩
  have hyNorm :
      y ∈ fieldNormSubgroup L M :=
    poweredBaseUnitsImageSubgroup_le_fieldNormSubgroup
      (K := K) (L := L) (M := M) hyS
  rcases hyNorm with ⟨z, hz⟩
  refine ⟨z, ?_⟩
  calc
    normUnits K M z =
        normUnits K L (normUnits L M z) := by
      exact (normUnits_tower K L M z).symm
    _ = normUnits K L y := by
      rw [hz]
    _ = x := hyx

end NormDownTower

end NAField

end TameAbhyankar

end
