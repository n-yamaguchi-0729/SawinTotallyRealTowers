import Nyll.SchemeTheory.AbhyankarLemma.TameRamification.ValueGroup.NonarchimedeanLocalField.Galois.Ramification.Basic

/-!
# Galois ramification value images

This file identifies the exact value images generated by embedded base units
and their `[M : L]`-powered lower-branch images using Neu1999 Galois
valuation data.
-/

noncomputable section

universe u

namespace TameAbhyankar

open LocalFieldTheory.DiscreteValuationField
open scoped ValuativeRel

namespace NAField

variable {K L : Type u}
variable [Field K] [Field L] [Algebra K L]
variable [ValuativeRel K] [TopologicalSpace K]
variable [IsNonarchimedeanLocalField K]
variable [ValuativeRel L] [TopologicalSpace L]
variable [IsNonarchimedeanLocalField L]
variable [FiniteDimensional K L] [IsGalois K L]
variable [Valuation.HasExtension (ValuativeRel.valuation K)
  (ValuativeRel.valuation L)]

/-- Neu1999's Galois valuation data, rewritten for the packaged
`MultiplicativeIntegerValuation`: embedding a base unit into the extension
multiplies its valuation by the supplied ramification index. -/
theorem galois_mapBaseUnitsToExtensionUnits_valuation_formula
    (x : Kˣ) :
    (multiplicativeIntegerValuation L).val
        (LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits K L x) =
      (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ) *
        (multiplicativeIntegerValuation K).val x := by
  change
    LocalFieldTheory.IsNonarchimedeanLocalField.v L
        (Additive.ofMul
          (LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits K L x)) =
      (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ) *
        LocalFieldTheory.IsNonarchimedeanLocalField.v K (Additive.ofMul x)
  let : IsIntegralClosure 𝒪[L] 𝒪[K] L :=
    LocalFieldTheory.localCompleteDVF_integerRing_isIntegralClosure K L
  exact
    LocalClassFieldTheory.v_mapBaseUnitsToExtensionUnits_eq_ramificationIdx_mul
      K L x

/-- A base uniformizer maps to an extension unit whose valuation is exactly
the Galois ramification index supplied by Neu1999. -/
theorem galois_mapBaseUnitsToExtensionUnits_uniformizer_val
    {ϖ : Kˣ} (hϖ : (multiplicativeIntegerValuation K).IsUniformizer ϖ) :
    (multiplicativeIntegerValuation L).val
        (LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits K L ϖ) =
      (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ) := by
  rw [galois_mapBaseUnitsToExtensionUnits_valuation_formula
    (K := K) (L := L) ϖ, hϖ, mul_one]

/-- A concrete embedded base unit generates the Neu1999 Galois ramification
index in the extension valuation group. -/
theorem exists_baseUnitsImageSubgroup_val_galoisRamificationIndex :
    ∃ x : Lˣ,
      x ∈ baseUnitsImageSubgroup (K := K) (L := L) ∧
        (multiplicativeIntegerValuation L).val x =
          (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ) := by
  rcases multiplicativeIntegerValuation_exists_uniformizer K with ⟨ϖ, hϖ⟩
  exact ⟨LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits K L ϖ,
    mapBaseUnitsToExtensionUnits_mem_baseUnitsImageSubgroup
      (K := K) (L := L) ϖ,
    galois_mapBaseUnitsToExtensionUnits_uniformizer_val
      (K := K) (L := L) hϖ⟩

/-- Subgroup-image form of the Galois ramification generator: the integer
subgroup generated by the Neu1999 Galois ramification index lies in the value
image of embedded base units. -/
theorem integerMultipleSubgroup_galoisRamificationIndex_le_baseUnitsImage :
    integerMultipleSubgroup
        (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ) ≤
      (multiplicativeIntegerValuation L).subgroupValueSubgroup
        (baseUnitsImageSubgroup (K := K) (L := L)) :=
  MultiplicativeIntegerValuation.integerMultipleSubgroup_le_subgroupValueSubgroup_of_exists_mem_val
    (multiplicativeIntegerValuation L)
    (exists_baseUnitsImageSubgroup_val_galoisRamificationIndex
      (K := K) (L := L))

/-- Every valuation value appearing on the embedded-base-unit subgroup is a
multiple of the Neu1999 Galois ramification index. -/
theorem baseUnitsImageSubgroup_valueImage_le_galoisRamificationIndex :
    (multiplicativeIntegerValuation L).subgroupValueSubgroup
        (baseUnitsImageSubgroup (K := K) (L := L)) ≤
      integerMultipleSubgroup
        (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ) := by
  exact
    (MultiplicativeIntegerValuation.subgroupValueSubgroup_le_integerMultipleSubgroup_iff
      (multiplicativeIntegerValuation L)
      (baseUnitsImageSubgroup (K := K) (L := L))
      (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ)).2
      (fun x hx => by
        rcases hx with ⟨y, hy⟩
        rw [← hy, galois_mapBaseUnitsToExtensionUnits_valuation_formula
          (K := K) (L := L) y]
        exact dvd_mul_right
          (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ)
          ((multiplicativeIntegerValuation K).val y))

/-- Exact value image of the embedded-base-unit subgroup in a finite Galois
Neu1999 local-field extension. -/
theorem baseUnitsImageSubgroup_valueImage_eq_galoisRamificationIndex :
    (multiplicativeIntegerValuation L).subgroupValueSubgroup
        (baseUnitsImageSubgroup (K := K) (L := L)) =
      integerMultipleSubgroup
        (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ) :=
  le_antisymm
    (baseUnitsImageSubgroup_valueImage_le_galoisRamificationIndex
      (K := K) (L := L))
    (integerMultipleSubgroup_galoisRamificationIndex_le_baseUnitsImage
      (K := K) (L := L))

section NormTower

variable {M : Type u} [Field M] [Algebra L M]

/-- A base uniformizer, embedded in `L` and then powered by `[M : L]`,
produces a concrete element of `fieldNormSubgroup L M` whose `L`-valuation is
`[M : L]` times the Neu1999 Galois ramification index of `L/K`. -/
theorem exists_mem_fieldNormSubgroup_val_finrank_mul_galoisRamificationIndex :
    ∃ x : Lˣ,
      x ∈ fieldNormSubgroup L M ∧
        (multiplicativeIntegerValuation L).val x =
          (Module.finrank L M : ℤ) *
            (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ) := by
  rcases multiplicativeIntegerValuation_exists_uniformizer K with ⟨ϖ, hϖ⟩
  refine ⟨
    LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits K L ϖ ^
      Module.finrank L M,
    pow_finrank_mem_fieldNormSubgroup
      (K := L) (L := M)
      (LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits K L ϖ),
    ?_⟩
  rw [(multiplicativeIntegerValuation L).val_pow,
    galois_mapBaseUnitsToExtensionUnits_uniformizer_val
      (K := K) (L := L) hϖ]

/-- Subgroup-image form of the powered norm generator.  The integer subgroup
generated by `[M : L] * e_gal(L/K)` lies in the value image of
`fieldNormSubgroup L M`. -/
theorem integerMultipleSubgroup_finrank_mul_galoisRamificationIndex_le_fieldNormSubgroup :
    integerMultipleSubgroup
        ((Module.finrank L M : ℤ) *
          (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ)) ≤
      (multiplicativeIntegerValuation L).subgroupValueSubgroup
        (fieldNormSubgroup L M) :=
  MultiplicativeIntegerValuation.integerMultipleSubgroup_le_subgroupValueSubgroup_of_exists_mem_val
    (multiplicativeIntegerValuation L)
    (exists_mem_fieldNormSubgroup_val_finrank_mul_galoisRamificationIndex
      (K := K) (L := L) (M := M))

/-- A concrete powered embedded base unit generates the value step
`[M : L] * e_gal(L/K)`. -/
theorem exists_mem_poweredBaseUnitsImageSubgroup_val_finrank_mul_galoisRamificationIndex :
    ∃ x : Lˣ,
      x ∈ poweredBaseUnitsImageSubgroup (K := K) (L := L) (M := M) ∧
        (multiplicativeIntegerValuation L).val x =
          (Module.finrank L M : ℤ) *
            (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ) := by
  rcases multiplicativeIntegerValuation_exists_uniformizer K with ⟨ϖ, hϖ⟩
  refine ⟨
    LocalFieldTheory.IsNonarchimedeanLocalField.mapBaseUnitsToExtensionUnits K L ϖ ^
      Module.finrank L M,
    pow_mem_poweredBaseUnitsImageSubgroup_of_mem
      (K := K) (L := L) (M := M)
      (mapBaseUnitsToExtensionUnits_mem_baseUnitsImageSubgroup
        (K := K) (L := L) ϖ),
    ?_⟩
  rw [(multiplicativeIntegerValuation L).val_pow,
    galois_mapBaseUnitsToExtensionUnits_uniformizer_val
      (K := K) (L := L) hϖ]

/-- The integer subgroup generated by `[M : L] * e_gal(L/K)` lies in the value
image of the powered embedded-base-unit subgroup. -/
theorem integerMultipleSubgroup_finrank_mul_galoisRamificationIndex_le_poweredBaseUnitsImage :
    integerMultipleSubgroup
        ((Module.finrank L M : ℤ) *
          (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ)) ≤
      (multiplicativeIntegerValuation L).subgroupValueSubgroup
        (poweredBaseUnitsImageSubgroup (K := K) (L := L) (M := M)) :=
  MultiplicativeIntegerValuation.integerMultipleSubgroup_le_subgroupValueSubgroup_of_exists_mem_val
    (multiplicativeIntegerValuation L)
    (exists_mem_poweredBaseUnitsImageSubgroup_val_finrank_mul_galoisRamificationIndex
      (K := K) (L := L) (M := M))

/-- Every value appearing on the powered embedded-base-unit subgroup is a
multiple of `[M : L] * e_gal(L/K)`. -/
theorem poweredBaseUnitsImageSubgroup_valueImage_le_finrank_mul_galoisRamificationIndex :
    (multiplicativeIntegerValuation L).subgroupValueSubgroup
        (poweredBaseUnitsImageSubgroup (K := K) (L := L) (M := M)) ≤
      integerMultipleSubgroup
        ((Module.finrank L M : ℤ) *
          (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ)) := by
  exact
    (MultiplicativeIntegerValuation.subgroupValueSubgroup_le_integerMultipleSubgroup_iff
      (multiplicativeIntegerValuation L)
      (poweredBaseUnitsImageSubgroup (K := K) (L := L) (M := M))
      ((Module.finrank L M : ℤ) *
        (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ))).2
      (fun x hx => by
        rcases hx with ⟨y, hyS, hyx⟩
        have hydiv :
            (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ) ∣
              (multiplicativeIntegerValuation L).val y :=
          (MultiplicativeIntegerValuation.subgroupValueSubgroup_le_integerMultipleSubgroup_iff
            (multiplicativeIntegerValuation L)
            (baseUnitsImageSubgroup (K := K) (L := L))
            (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ)).1
            (baseUnitsImageSubgroup_valueImage_le_galoisRamificationIndex
              (K := K) (L := L)) y hyS
        rw [← hyx]
        change
          ((Module.finrank L M : ℤ) *
            (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ)) ∣
            (multiplicativeIntegerValuation L).val
              (y ^ Module.finrank L M)
        rw [(multiplicativeIntegerValuation L).val_pow]
        exact mul_dvd_mul_left (Module.finrank L M : ℤ) hydiv)

/-- Exact value image of the powered embedded-base-unit subgroup. -/
theorem poweredBaseUnitsImageSubgroup_valueImage_eq_finrank_mul_galoisRamificationIndex :
    (multiplicativeIntegerValuation L).subgroupValueSubgroup
        (poweredBaseUnitsImageSubgroup (K := K) (L := L) (M := M)) =
      integerMultipleSubgroup
        ((Module.finrank L M : ℤ) *
          (Ideal.ramificationIdx (𝓂[L] : Ideal 𝒪[L]) 𝒪[K] : ℤ)) :=
  le_antisymm
    (poweredBaseUnitsImageSubgroup_valueImage_le_finrank_mul_galoisRamificationIndex
      (K := K) (L := L) (M := M))
    (integerMultipleSubgroup_finrank_mul_galoisRamificationIndex_le_poweredBaseUnitsImage
      (K := K) (L := L) (M := M))

end NormTower

end NAField

end TameAbhyankar

end
