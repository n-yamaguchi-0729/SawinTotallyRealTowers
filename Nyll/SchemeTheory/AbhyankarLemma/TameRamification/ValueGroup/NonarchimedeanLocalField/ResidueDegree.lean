import Nyll.SchemeTheory.AbhyankarLemma.TameRamification.ValueGroup.NonarchimedeanLocalField.FieldNormImage
import Nyll.SchemeTheory.AbhyankarLemma.TameRamification.ValueGroup.NonarchimedeanLocalField.Invariants
import Nyll.SchemeTheory.AbhyankarLemma.TameRamification.ValueGroup.NonarchimedeanLocalField.BaseNorm

/-!
# Neu1999 residue-degree lcm divisibility

This file extracts concrete residue-degree divisibility from the Neu1999
field-norm value-image comparison.
-/

noncomputable section

universe u

namespace TameAbhyankar

open LocalFieldTheory.DiscreteValuationField
open scoped ValuativeRel

namespace NAField

section CommonTopResidueDegree

variable {K L L' M : Type u}
variable [Field K] [ValuativeRel K] [TopologicalSpace K]
variable [IsNonarchimedeanLocalField K]
variable [Field L] [ValuativeRel L] [TopologicalSpace L]
variable [IsNonarchimedeanLocalField L]
variable [Field L'] [ValuativeRel L'] [TopologicalSpace L']
variable [IsNonarchimedeanLocalField L']
variable [Field M] [ValuativeRel M] [TopologicalSpace M]
variable [IsNonarchimedeanLocalField M]
variable [Algebra K L] [Algebra K L']
variable [Algebra K M]
variable [Algebra L M] [Algebra L' M]
variable [IsScalarTower K L M] [IsScalarTower K L' M]
variable [Module.Free L M] [Module.Free L' M]
variable [FiniteDimensional K L] [FiniteDimensional K L']
variable [FiniteDimensional K M]
variable [Algebra.IsSeparable K L] [Algebra.IsSeparable K L']
variable [Algebra.IsSeparable K M]
variable [Valuation.HasExtension (ValuativeRel.valuation K)
  (ValuativeRel.valuation L)]
variable [Valuation.HasExtension (ValuativeRel.valuation K)
  (ValuativeRel.valuation L')]
variable [Valuation.HasExtension (ValuativeRel.valuation K)
  (ValuativeRel.valuation M)]

/-- Common-top residue-degree divisibility generated by the Neu1999
field-norm value images.  The valuation image of `N_{M/K}(Mˣ)` is generated by
`f(K,M)`, while the same image lies in the lcm value-step subgroup generated
by `f(K,L)` and `f(K,L')`. -/
theorem lcm_residueDegree_dvd_common_residueDegree_towers :
    ((((Module.finrank 𝓀[K] 𝓀[L] : ℤ).lcm
      (Module.finrank 𝓀[K] 𝓀[L'] : ℤ) : ℕ) : ℤ) ∣
        (Module.finrank 𝓀[K] 𝓀[M] : ℤ)) := by
  have himage_eq :=
    fieldNormSubgroup_valueImage_eq_residueDegree (K := K) (L := M)
  have himage_le :=
    fieldNormSubgroup_valueImage_le_lcm_towers
      (K := K) (L := L) (L' := L') (M := M)
  have hmultiple_le :
      integerMultipleSubgroup (Module.finrank 𝓀[K] 𝓀[M] : ℤ) ≤
        integerMultipleSubgroup
          ((((Module.finrank 𝓀[K] 𝓀[L] : ℤ).lcm
            (Module.finrank 𝓀[K] 𝓀[L'] : ℤ) : ℕ) : ℤ)) := by
    simpa [← himage_eq] using himage_le
  exact
    (LocalFieldTheory.DiscreteValuationField.integerMultipleSubgroup_le_iff_dvd
      ((((Module.finrank 𝓀[K] 𝓀[L] : ℤ).lcm
        (Module.finrank 𝓀[K] 𝓀[L'] : ℤ) : ℕ) : ℤ))
      (Module.finrank 𝓀[K] 𝓀[M] : ℤ)).1 hmultiple_le

/-- Nat divisibility form of
`lcm_residueDegree_dvd_common_residueDegree_towers`, keeping the same
integer-lcm source step on the left. -/
theorem intLcm_residueDegree_dvd_common_residueDegree_towers_nat :
    ((Module.finrank 𝓀[K] 𝓀[L] : ℤ).lcm
      (Module.finrank 𝓀[K] 𝓀[L'] : ℤ) : ℕ) ∣
        Module.finrank 𝓀[K] 𝓀[M] := by
  exact Int.natCast_dvd_natCast.mp
    (lcm_residueDegree_dvd_common_residueDegree_towers
      (K := K) (L := L) (L' := L') (M := M))

/-- Standard `Nat.lcm` form of the common-top Neu1999 residue-degree
divisibility. -/
theorem nat_lcm_residueDegree_dvd_common_residueDegree_towers :
    Nat.lcm (Module.finrank 𝓀[K] 𝓀[L])
        (Module.finrank 𝓀[K] 𝓀[L']) ∣
      Module.finrank 𝓀[K] 𝓀[M] := by
  simpa [Int.lcm_def] using
    intLcm_residueDegree_dvd_common_residueDegree_towers_nat
      (K := K) (L := L) (L' := L') (M := M)

/-- Element-generator proof of the common-top residue-degree divisibility:
`fieldNormSubgroup K M` contains an element of valuation `f(K,M)`, and the
common-top norm-image theorem forces that valuation to be divisible by the
lower residue-degree lcm. -/
theorem nat_lcm_residueDegree_dvd_common_residueDegree_towers_from_norm_generator :
    Nat.lcm (Module.finrank 𝓀[K] 𝓀[L])
        (Module.finrank 𝓀[K] 𝓀[L']) ∣
      Module.finrank 𝓀[K] 𝓀[M] :=
  nat_lcm_residueDegree_dvd_nat_of_exists_mem_val_of_le_fieldNormSubgroup_towers
    (K := K) (L := L) (L' := L') (M := M)
    (S := fieldNormSubgroup K M)
    (n := Module.finrank 𝓀[K] 𝓀[M])
    (exists_mem_fieldNormSubgroup_val_residueDegree (K := K) (L := M))
    (fun _ hx => hx)

/-- The common-top field degree is also divisible by the lower residue-degree
lcm, because Neu1999's common residue degree divides `[M : K]`. -/
theorem nat_lcm_residueDegree_dvd_common_finrank_towers :
    Nat.lcm (Module.finrank 𝓀[K] 𝓀[L])
        (Module.finrank 𝓀[K] 𝓀[L']) ∣
      Module.finrank K M :=
  dvd_trans
    (nat_lcm_residueDegree_dvd_common_residueDegree_towers
      (K := K) (L := L) (L' := L') (M := M))
    (residueDegree_dvd_finrank (K := K) (L := M))

/-- The common-top field degree is divisible by the common-top ramification
index times the lower residue-degree lcm.  This is the Neu1999
`e * f = [M : K]` relation applied after the norm-image theorem produces
`lcm (f K L) (f K L') ∣ f K M`. -/
theorem ramificationIndex_mul_nat_lcm_residueDegree_dvd_common_finrank_towers :
    (𝓂[M] : Ideal 𝒪[M]).ramificationIdx 𝒪[K] *
        Nat.lcm (Module.finrank 𝓀[K] 𝓀[L])
          (Module.finrank 𝓀[K] 𝓀[L']) ∣
      Module.finrank K M :=
  ramificationIndex_mul_dvd_finrank_of_dvd_residueDegree
    (K := K) (L := M)
    (d := Nat.lcm (Module.finrank 𝓀[K] 𝓀[L])
      (Module.finrank 𝓀[K] 𝓀[L']))
    (nat_lcm_residueDegree_dvd_common_residueDegree_towers
      (K := K) (L := L) (L' := L') (M := M))

omit [ValuativeRel M] [TopologicalSpace M] [IsNonarchimedeanLocalField M]
    [FiniteDimensional K M] [Algebra.IsSeparable K M]
    [Valuation.HasExtension (ValuativeRel.valuation K)
      (ValuativeRel.valuation M)] in
/-- Element-generator proof of the common-top field-degree divisibility: the
base uniformizer produces a concrete member of `fieldNormSubgroup K M` with
valuation `[M : K]`, and the common-top norm-image theorem forces the same
valuation to be divisible by the lower residue-degree lcm. -/
theorem nat_lcm_residueDegree_dvd_common_finrank_towers_from_base_norm :
    Nat.lcm (Module.finrank 𝓀[K] 𝓀[L])
        (Module.finrank 𝓀[K] 𝓀[L']) ∣
      Module.finrank K M :=
  nat_lcm_residueDegree_dvd_nat_of_exists_mem_val_of_le_fieldNormSubgroup_towers
    (K := K) (L := L) (L' := L') (M := M)
    (S := fieldNormSubgroup K M)
    (n := Module.finrank K M)
    (exists_mem_fieldNormSubgroup_val_finrank (K := K) (L := M))
    (fun _ hx => hx)

end CommonTopResidueDegree

section GaloisLowerCommonTopResidueDegree

variable {K L L' M : Type u}
variable [Field K] [ValuativeRel K] [TopologicalSpace K]
variable [IsNonarchimedeanLocalField K]
variable [Field L] [ValuativeRel L] [TopologicalSpace L]
variable [IsNonarchimedeanLocalField L]
variable [Field L'] [ValuativeRel L'] [TopologicalSpace L']
variable [IsNonarchimedeanLocalField L']
variable [Field M] [ValuativeRel M] [TopologicalSpace M]
variable [IsNonarchimedeanLocalField M]
variable [Algebra K L] [Algebra K L']
variable [Algebra K M]
variable [Algebra L M] [Algebra L' M]
variable [IsScalarTower K L M] [IsScalarTower K L' M]
variable [Module.Free L M] [Module.Free L' M]
variable [FiniteDimensional K L] [FiniteDimensional K L']
variable [IsGalois K L] [IsGalois K L']
variable [FiniteDimensional K M] [Algebra.IsSeparable K M]
variable [Valuation.HasExtension (ValuativeRel.valuation K)
  (ValuativeRel.valuation L)]
variable [Valuation.HasExtension (ValuativeRel.valuation K)
  (ValuativeRel.valuation L')]
variable [Valuation.HasExtension (ValuativeRel.valuation K)
  (ValuativeRel.valuation M)]

/-- With both lower branches supplied by Neu1999 Galois valuation data, the
common-top residue degree is divisible by the lcm of the lower Galois residue
degrees. -/
theorem nat_lcm_galoisResidueDegree_dvd_common_residueDegree_towers :
    Nat.lcm
        (Module.finrank 𝓀[K] 𝓀[L])
        (Module.finrank 𝓀[K] 𝓀[L']) ∣
      Module.finrank 𝓀[K] 𝓀[M] := by
  simpa using
    nat_lcm_residueDegree_dvd_common_residueDegree_towers
      (K := K) (L := L) (L' := L') (M := M)

/-- Field-degree form of the Galois lower-branch residue-degree lcm source. -/
theorem nat_lcm_galoisResidueDegree_dvd_common_finrank_towers :
    Nat.lcm
        (Module.finrank 𝓀[K] 𝓀[L])
        (Module.finrank 𝓀[K] 𝓀[L']) ∣
      Module.finrank K M :=
  dvd_trans
    (nat_lcm_galoisResidueDegree_dvd_common_residueDegree_towers
      (K := K) (L := L) (L' := L') (M := M))
    (residueDegree_dvd_finrank (K := K) (L := M))

/-- The common-top ramification index times the lower Galois residue-degree
lcm divides the common-top field degree. -/
theorem ramificationIndex_mul_nat_lcm_galoisResidueDegree_dvd_common_finrank_towers :
    (𝓂[M] : Ideal 𝒪[M]).ramificationIdx 𝒪[K] *
        Nat.lcm
          (Module.finrank 𝓀[K] 𝓀[L])
          (Module.finrank 𝓀[K] 𝓀[L']) ∣
      Module.finrank K M :=
  ramificationIndex_mul_dvd_finrank_of_dvd_residueDegree
    (K := K) (L := M)
    (d := Nat.lcm
      (Module.finrank 𝓀[K] 𝓀[L])
      (Module.finrank 𝓀[K] 𝓀[L']))
    (nat_lcm_galoisResidueDegree_dvd_common_residueDegree_towers
      (K := K) (L := L) (L' := L') (M := M))

end GaloisLowerCommonTopResidueDegree

end NAField

end TameAbhyankar

end
