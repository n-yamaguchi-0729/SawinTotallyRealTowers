import Nyll.SchemeTheory.AbhyankarLemma.TameRamification.ValueGroup.NonarchimedeanLocalField.Valuation

/-!
# Neu1999 field-norm value images

This file specializes the generic field-norm image lemmas to Neu1999 local
fields.  It keeps the arbitrary subgroup and generator forms close to the
frontier where the actual ramification-image subgroup will be constructed.
-/

noncomputable section

universe u

namespace TameAbhyankar

open LocalFieldTheory.DiscreteValuationField
open scoped ValuativeRel

namespace NAField

/-- For a single Neu1999 local-field extension, the valuation image of the
field-norm subgroup is exactly the integer subgroup generated by the Neu1999
residue degree. -/
theorem fieldNormSubgroup_valueImage_eq_residueDegree
    (K L : Type u)
    [Field K] [ValuativeRel K] [TopologicalSpace K]
    [IsNonarchimedeanLocalField K]
    [Field L] [ValuativeRel L] [TopologicalSpace L]
    [IsNonarchimedeanLocalField L]
    [Algebra K L] [FiniteDimensional K L] [Algebra.IsSeparable K L]
    [Valuation.HasExtension (ValuativeRel.valuation K)
      (ValuativeRel.valuation L)] :
    (multiplicativeIntegerValuation K).subgroupValueSubgroup
        (fieldNormSubgroup K L) =
      integerMultipleSubgroup (Module.finrank 𝓀[K] 𝓀[L] : ℤ) := by
  rcases multiplicativeIntegerValuation_exists_uniformizer L with ⟨ϖL, hϖL⟩
  let N :=
    valuedFieldNorm K L
      (multiplicativeIntegerValuation K)
      (multiplicativeIntegerValuation L)
      (Module.finrank 𝓀[K] 𝓀[L])
      (fieldNormUnits_valuation_formula (K := K) (L := L))
  have hnorm : N.normSubgroup = fieldNormSubgroup K L := by
    simpa [N] using
      valuedFieldNorm_normSubgroup_eq_fieldNormSubgroup
        K L
        (multiplicativeIntegerValuation K)
        (multiplicativeIntegerValuation L)
        (Module.finrank 𝓀[K] 𝓀[L])
        (fieldNormUnits_valuation_formula (K := K) (L := L))
  simpa [N, hnorm] using
    N.subgroupValueSubgroup_normSubgroup_eq_integerMultipleSubgroup hϖL

/-- Elementwise form of
`fieldNormSubgroup_valueImage_eq_residueDegree`: a base valuation value occurs
on the field-norm subgroup exactly when it is divisible by the Neu1999 residue
degree. -/
theorem exists_mem_fieldNormSubgroup_val_iff_residueDegree_dvd
    (K L : Type u)
    [Field K] [ValuativeRel K] [TopologicalSpace K]
    [IsNonarchimedeanLocalField K]
    [Field L] [ValuativeRel L] [TopologicalSpace L]
    [IsNonarchimedeanLocalField L]
    [Algebra K L] [FiniteDimensional K L] [Algebra.IsSeparable K L]
    [Valuation.HasExtension (ValuativeRel.valuation K)
      (ValuativeRel.valuation L)]
    (n : ℤ) :
    (∃ x : Kˣ, x ∈ fieldNormSubgroup K L ∧
        (multiplicativeIntegerValuation K).val x = n) ↔
      (Module.finrank 𝓀[K] 𝓀[L] : ℤ) ∣ n := by
  have himage :=
    fieldNormSubgroup_valueImage_eq_residueDegree (K := K) (L := L)
  constructor
  · intro hn
    have hmem :
        Multiplicative.ofAdd n ∈
          (multiplicativeIntegerValuation K).subgroupValueSubgroup
            (fieldNormSubgroup K L) :=
      (MultiplicativeIntegerValuation.ofAdd_mem_subgroupValueSubgroup_iff
        (multiplicativeIntegerValuation K) (fieldNormSubgroup K L) n).2 hn
    have hmultiple :
        Multiplicative.ofAdd n ∈
          integerMultipleSubgroup (Module.finrank 𝓀[K] 𝓀[L] : ℤ) := by
      simpa [himage] using hmem
    rwa [ofAdd_mem_integerMultipleSubgroup_iff] at hmultiple
  · intro hd
    have hmultiple :
        Multiplicative.ofAdd n ∈
          integerMultipleSubgroup (Module.finrank 𝓀[K] 𝓀[L] : ℤ) := by
      rw [ofAdd_mem_integerMultipleSubgroup_iff]
      exact hd
    have hmem :
        Multiplicative.ofAdd n ∈
          (multiplicativeIntegerValuation K).subgroupValueSubgroup
            (fieldNormSubgroup K L) := by
      simpa [himage] using hmultiple
    exact
      (MultiplicativeIntegerValuation.ofAdd_mem_subgroupValueSubgroup_iff
        (multiplicativeIntegerValuation K) (fieldNormSubgroup K L) n).1 hmem

/-- Natural-number form of
`exists_mem_fieldNormSubgroup_val_iff_residueDegree_dvd`. -/
theorem exists_mem_fieldNormSubgroup_val_nat_iff_residueDegree_dvd
    (K L : Type u)
    [Field K] [ValuativeRel K] [TopologicalSpace K]
    [IsNonarchimedeanLocalField K]
    [Field L] [ValuativeRel L] [TopologicalSpace L]
    [IsNonarchimedeanLocalField L]
    [Algebra K L] [FiniteDimensional K L] [Algebra.IsSeparable K L]
    [Valuation.HasExtension (ValuativeRel.valuation K)
      (ValuativeRel.valuation L)]
    (n : ℕ) :
    (∃ x : Kˣ, x ∈ fieldNormSubgroup K L ∧
        (multiplicativeIntegerValuation K).val x = (n : ℤ)) ↔
      Module.finrank 𝓀[K] 𝓀[L] ∣ n := by
  rw [exists_mem_fieldNormSubgroup_val_iff_residueDegree_dvd
    (K := K) (L := L) (n := (n : ℤ))]
  exact Int.natCast_dvd_natCast

/-- A single Neu1999 field-norm subgroup contains an element whose base
valuation is exactly the residue degree. -/
theorem exists_mem_fieldNormSubgroup_val_residueDegree
    (K L : Type u)
    [Field K] [ValuativeRel K] [TopologicalSpace K]
    [IsNonarchimedeanLocalField K]
    [Field L] [ValuativeRel L] [TopologicalSpace L]
    [IsNonarchimedeanLocalField L]
    [Algebra K L] [FiniteDimensional K L] [Algebra.IsSeparable K L]
    [Valuation.HasExtension (ValuativeRel.valuation K)
      (ValuativeRel.valuation L)] :
    ∃ x : Kˣ, x ∈ fieldNormSubgroup K L ∧
      (multiplicativeIntegerValuation K).val x =
        (Module.finrank 𝓀[K] 𝓀[L] : ℤ) :=
  (exists_mem_fieldNormSubgroup_val_iff_residueDegree_dvd
    (K := K) (L := L)
    (n := (Module.finrank 𝓀[K] 𝓀[L] : ℤ))).2 dvd_rfl

section TwoLowerTowers

variable {K L L' M : Type u}
variable [Field K] [ValuativeRel K] [TopologicalSpace K]
variable [IsNonarchimedeanLocalField K]
variable [Field L] [ValuativeRel L] [TopologicalSpace L]
variable [IsNonarchimedeanLocalField L]
variable [Field L'] [ValuativeRel L'] [TopologicalSpace L']
variable [IsNonarchimedeanLocalField L']
variable [Field M]
variable [Algebra K L] [Algebra K L']
variable [Algebra K M]
variable [Algebra L M] [Algebra L' M]
variable [IsScalarTower K L M] [IsScalarTower K L' M]
variable [Module.Free L M] [Module.Free L' M]
variable [FiniteDimensional K L] [FiniteDimensional K L']
variable [Algebra.IsSeparable K L] [Algebra.IsSeparable K L']
variable [Valuation.HasExtension (ValuativeRel.valuation K)
  (ValuativeRel.valuation L)]
variable [Valuation.HasExtension (ValuativeRel.valuation K)
  (ValuativeRel.valuation L')]

/-- Neu1999 local-field specialization of the common-top field-norm image
theorem: the base valuation image of `N_{M/K}(Mˣ)` is cut out by the lcm of
the two lower Neu1999 residue degrees. -/
theorem fieldNormSubgroup_valueImage_le_lcm_towers :
    (multiplicativeIntegerValuation K).subgroupValueSubgroup
        (fieldNormSubgroup K M) ≤
      integerMultipleSubgroup
        ((((Module.finrank 𝓀[K] 𝓀[L] : ℤ).lcm
          (Module.finrank 𝓀[K] 𝓀[L'] : ℤ) : ℕ) : ℤ)) :=
  FieldNormCommon.subgroupValueSubgroup_fieldNormSubgroup_le_lcm_towers
    (K := K) (L := L) (L' := L') (M := M)
    (multiplicativeIntegerValuation K)
    (multiplicativeIntegerValuation L)
    (multiplicativeIntegerValuation L')
    (Module.finrank 𝓀[K] 𝓀[L])
    (Module.finrank 𝓀[K] 𝓀[L'])
    (fieldNormUnits_valuation_formula (K := K) (L := L))
    (fieldNormUnits_valuation_formula (K := K) (L := L'))

/-- Any Neu1999 subgroup contained in the common-top field-norm subgroup
inherits the lcm value-step inclusion.  This is the immediate input shape for
the actual ramification-image subgroup. -/
theorem subgroupValueSubgroup_le_lcm_of_le_fieldNormSubgroup_towers
    {S : Subgroup Kˣ} (hS : S ≤ fieldNormSubgroup K M) :
    (multiplicativeIntegerValuation K).subgroupValueSubgroup S ≤
      integerMultipleSubgroup
        ((((Module.finrank 𝓀[K] 𝓀[L] : ℤ).lcm
          (Module.finrank 𝓀[K] 𝓀[L'] : ℤ) : ℕ) : ℤ)) :=
  FieldNormCommon.subgroupValueSubgroup_le_lcm_of_le_fieldNormSubgroup_towers
    (K := K) (L := L) (L' := L') (M := M)
    (multiplicativeIntegerValuation K)
    (multiplicativeIntegerValuation L)
    (multiplicativeIntegerValuation L')
    (Module.finrank 𝓀[K] 𝓀[L])
    (Module.finrank 𝓀[K] 𝓀[L'])
    (fieldNormUnits_valuation_formula (K := K) (L := L))
    (fieldNormUnits_valuation_formula (K := K) (L := L')) hS

/-- Generator form for the next ramification-image step: once an element of a
subgroup contained in `N_{M/K}(Mˣ)` has valuation `n`, that valuation is
divisible by the lcm of the two lower Neu1999 residue degrees. -/
theorem lcm_residueDegree_dvd_of_exists_mem_val_of_le_fieldNormSubgroup_towers
    {S : Subgroup Kˣ} {n : ℤ}
    (hn :
      ∃ x : Kˣ, x ∈ S ∧
        (multiplicativeIntegerValuation K).val x = n)
    (hS : S ≤ fieldNormSubgroup K M) :
    ((((Module.finrank 𝓀[K] 𝓀[L] : ℤ).lcm
      (Module.finrank 𝓀[K] 𝓀[L'] : ℤ) : ℕ) : ℤ) ∣ n) :=
  by
    rcases hn with ⟨x, hxS, hxval⟩
    have hdiv :
        ((((Module.finrank 𝓀[K] 𝓀[L] : ℤ).lcm
          (Module.finrank 𝓀[K] 𝓀[L'] : ℤ) : ℕ) : ℤ) ∣
            (multiplicativeIntegerValuation K).val x) :=
      (MultiplicativeIntegerValuation.subgroupValueSubgroup_le_integerMultipleSubgroup_iff
        (multiplicativeIntegerValuation K) S
          ((((Module.finrank 𝓀[K] 𝓀[L] : ℤ).lcm
            (Module.finrank 𝓀[K] 𝓀[L'] : ℤ) : ℕ) : ℤ))).1
        (subgroupValueSubgroup_le_lcm_of_le_fieldNormSubgroup_towers
          (K := K) (L := L) (L' := L') (M := M) hS)
        x hxS
    rw [hxval] at hdiv
    exact hdiv

/-- Nat form of
`lcm_residueDegree_dvd_of_exists_mem_val_of_le_fieldNormSubgroup_towers`,
keeping the same integer-lcm source step. -/
theorem intLcm_residueDegree_dvd_nat_of_exists_mem_val_of_le_fieldNormSubgroup_towers
    {S : Subgroup Kˣ} {n : ℕ}
    (hn :
      ∃ x : Kˣ, x ∈ S ∧
        (multiplicativeIntegerValuation K).val x = (n : ℤ))
    (hS : S ≤ fieldNormSubgroup K M) :
    ((Module.finrank 𝓀[K] 𝓀[L] : ℤ).lcm
      (Module.finrank 𝓀[K] 𝓀[L'] : ℤ) : ℕ) ∣ n := by
  exact Int.natCast_dvd_natCast.mp
    (lcm_residueDegree_dvd_of_exists_mem_val_of_le_fieldNormSubgroup_towers
      (K := K) (L := L) (L' := L') (M := M) hn hS)

/-- Standard `Nat.lcm` form of the Neu1999 subgroup-generator divisibility.
This is the shape expected by the ramification-index arithmetic layer. -/
theorem nat_lcm_residueDegree_dvd_nat_of_exists_mem_val_of_le_fieldNormSubgroup_towers
    {S : Subgroup Kˣ} {n : ℕ}
    (hn :
      ∃ x : Kˣ, x ∈ S ∧
        (multiplicativeIntegerValuation K).val x = (n : ℤ))
    (hS : S ≤ fieldNormSubgroup K M) :
    Nat.lcm (Module.finrank 𝓀[K] 𝓀[L])
        (Module.finrank 𝓀[K] 𝓀[L']) ∣ n := by
  simpa [Int.lcm_def] using
    intLcm_residueDegree_dvd_nat_of_exists_mem_val_of_le_fieldNormSubgroup_towers
      (K := K) (L := L) (L' := L') (M := M) hn hS

end TwoLowerTowers

section GaloisLowerTowers

variable {K L L' M : Type u}
variable [Field K] [ValuativeRel K] [TopologicalSpace K]
variable [IsNonarchimedeanLocalField K]
variable [Field L] [ValuativeRel L] [TopologicalSpace L]
variable [IsNonarchimedeanLocalField L]
variable [Field L'] [ValuativeRel L'] [TopologicalSpace L']
variable [IsNonarchimedeanLocalField L']
variable [Field M]
variable [Algebra K L] [Algebra K L']
variable [Algebra K M]
variable [Algebra L M] [Algebra L' M]
variable [IsScalarTower K L M] [IsScalarTower K L' M]
variable [Module.Free L M] [Module.Free L' M]
variable [FiniteDimensional K L] [FiniteDimensional K L']
variable [IsGalois K L] [IsGalois K L']
variable [Valuation.HasExtension (ValuativeRel.valuation K)
  (ValuativeRel.valuation L)]
variable [Valuation.HasExtension (ValuativeRel.valuation K)
  (ValuativeRel.valuation L')]

/-- If both lower branches are supplied by Neu1999 Galois valuation data, the
common-top field-norm value image is cut out by the lcm of the two Galois
residue degrees. -/
theorem fieldNormSubgroup_valueImage_le_galoisResidueDegree_lcm_towers :
    (multiplicativeIntegerValuation K).subgroupValueSubgroup
        (fieldNormSubgroup K M) ≤
      integerMultipleSubgroup
        ((((Module.finrank 𝓀[K] 𝓀[L] : ℤ).lcm
          (Module.finrank 𝓀[K] 𝓀[L'] : ℤ) : ℕ) : ℤ)) := by
  simpa using
    fieldNormSubgroup_valueImage_le_lcm_towers
      (K := K) (L := L) (L' := L') (M := M)

/-- Any subgroup already contained in the common-top norm subgroup inherits
the Galois-residue-degree lcm value-step inclusion. -/
theorem subgroupValueSubgroup_le_galoisResidueDegree_lcm_of_le_fieldNormSubgroup
    {S : Subgroup Kˣ} (hS : S ≤ fieldNormSubgroup K M) :
    (multiplicativeIntegerValuation K).subgroupValueSubgroup S ≤
      integerMultipleSubgroup
        ((((Module.finrank 𝓀[K] 𝓀[L] : ℤ).lcm
          (Module.finrank 𝓀[K] 𝓀[L'] : ℤ) : ℕ) : ℤ)) := by
  simpa using
    subgroupValueSubgroup_le_lcm_of_le_fieldNormSubgroup_towers
      (K := K) (L := L) (L' := L') (M := M) hS

/-- Generator form for a subgroup of the common-top norm subgroup, with both
lower residue degrees supplied by Neu1999 Galois valuation data. -/
theorem nat_lcm_galoisResidueDegree_dvd_nat_of_mem_le_fieldNormSubgroup
    {S : Subgroup Kˣ} {n : ℕ}
    (hn :
      ∃ x : Kˣ, x ∈ S ∧
        (multiplicativeIntegerValuation K).val x = (n : ℤ))
    (hS : S ≤ fieldNormSubgroup K M) :
    Nat.lcm
        (Module.finrank 𝓀[K] 𝓀[L])
        (Module.finrank 𝓀[K] 𝓀[L']) ∣ n := by
  simpa using
    nat_lcm_residueDegree_dvd_nat_of_exists_mem_val_of_le_fieldNormSubgroup_towers
      (K := K) (L := L) (L' := L') (M := M) hn hS

end GaloisLowerTowers

end NAField

end TameAbhyankar

end
