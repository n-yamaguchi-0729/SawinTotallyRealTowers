import Nyll.SchemeTheory.AbhyankarLemma.TameRamification.ValueGroup.FieldNorm.Common

/-!
# Field-norm value images

This file turns the common-top field-norm lcm divisibility from elementwise
form into the subgroup-image form needed by the ramification-image comparison.
-/

noncomputable section

namespace TameAbhyankar

open LocalFieldTheory LocalFieldTheory.DiscreteValuationField

namespace FieldNormCommon

section TwoLowerTowers

variable {K L L' M : Type _}
variable [Field K] [Field L] [Field L'] [Field M]
variable [Algebra K L] [Algebra K L']
variable [Algebra K M]
variable [Algebra L M] [Algebra L' M]
variable [IsScalarTower K L M] [IsScalarTower K L' M]
variable [Module.Free L M] [Module.Free L' M]

/-- The value image of the common-top field-norm subgroup lies in the lcm
value-step subgroup generated by the two lower valued field-norm residue
degrees. -/
theorem subgroupValueSubgroup_fieldNormSubgroup_le_lcm_towers
    (vK : MultiplicativeIntegerValuation Kˣ)
    (vL : MultiplicativeIntegerValuation Lˣ)
    (vL' : MultiplicativeIntegerValuation L'ˣ)
    (residueDegree residueDegree' : ℕ)
    (hformula :
      ∀ x : Lˣ, vK.val (normUnits K L x) =
        (residueDegree : ℤ) * vL.val x)
    (hformula' :
      ∀ x : L'ˣ, vK.val (normUnits K L' x) =
        (residueDegree' : ℤ) * vL'.val x) :
    vK.subgroupValueSubgroup (fieldNormSubgroup K M) ≤
      integerMultipleSubgroup
        ((((residueDegree : ℤ).lcm (residueDegree' : ℤ) : ℕ) : ℤ)) :=
  (MultiplicativeIntegerValuation.subgroupValueSubgroup_le_integerMultipleSubgroup_iff
    vK (fieldNormSubgroup K M)
      ((((residueDegree : ℤ).lcm (residueDegree' : ℤ) : ℕ) : ℤ))).2
    (fun _ hx =>
      lcm_dvd_val_of_mem_common_fieldNormSubgroup_towers
        (K := K) (L := L) (L' := L') (M := M)
        vK vL vL' residueDegree residueDegree' hformula hformula' hx)

/-- Any subgroup already contained in the common-top field-norm subgroup
inherits the same lcm value-step inclusion.  This is the form consumed by the
next actual ramification-image comparison. -/
theorem subgroupValueSubgroup_le_lcm_of_le_fieldNormSubgroup_towers
    (vK : MultiplicativeIntegerValuation Kˣ)
    (vL : MultiplicativeIntegerValuation Lˣ)
    (vL' : MultiplicativeIntegerValuation L'ˣ)
    (residueDegree residueDegree' : ℕ)
    (hformula :
      ∀ x : Lˣ, vK.val (normUnits K L x) =
        (residueDegree : ℤ) * vL.val x)
    (hformula' :
      ∀ x : L'ˣ, vK.val (normUnits K L' x) =
        (residueDegree' : ℤ) * vL'.val x)
    {S : Subgroup Kˣ} (hS : S ≤ fieldNormSubgroup K M) :
    vK.subgroupValueSubgroup S ≤
      integerMultipleSubgroup
        ((((residueDegree : ℤ).lcm (residueDegree' : ℤ) : ℕ) : ℤ)) :=
  MultiplicativeIntegerValuation.subgroupValueSubgroup_le_integerMultipleSubgroup_of_le
    vK hS
    (subgroupValueSubgroup_fieldNormSubgroup_le_lcm_towers
      (K := K) (L := L) (L' := L') (M := M)
      vK vL vL' residueDegree residueDegree' hformula hformula')

end TwoLowerTowers

end FieldNormCommon

end TameAbhyankar

end
