import Nyll.SchemeTheory.AbhyankarLemma.TameRamification.ValueGroup.Norm.Common
import Nyll.ValuedFieldTheory.LocalField.DiscreteValuationField.FieldNorm

/-!
# Field-norm common images

This file supplies the common-image containments used by the value-group
frontier from the concrete tower transitivity of field norms.
-/

noncomputable section

namespace TameAbhyankar

open LocalFieldTheory LocalFieldTheory.DiscreteValuationField

namespace FieldNormCommon

section SingleTower

variable {K E M : Type _}
variable [Field K] [Field E] [Field M]
variable [Algebra K E] [Algebra K M] [Algebra E M]
variable [IsScalarTower K E M] [Module.Free E M]

/-- The norm subgroup from a common top field lies in the valued field-norm
subgroup of any lower intermediate field in the tower. -/
theorem fieldNormSubgroup_le_valuedFieldNorm_normSubgroup_of_tower
    (vK : MultiplicativeIntegerValuation Kˣ)
    (vE : MultiplicativeIntegerValuation Eˣ)
    (residueDegree : ℕ)
    (hformula :
      ∀ x : Eˣ, vK.val (normUnits K E x) =
        (residueDegree : ℤ) * vE.val x) :
    fieldNormSubgroup K M ≤
      (valuedFieldNorm K E vK vE residueDegree hformula).normSubgroup := by
  rw [valuedFieldNorm_normSubgroup_eq_fieldNormSubgroup
    K E vK vE residueDegree hformula]
  exact fieldNormSubgroup_le_of_tower K M E

end SingleTower

section TwoLowerTowers

variable {K L L' M : Type _}
variable [Field K] [Field L] [Field L'] [Field M]
variable [Algebra K L] [Algebra K L']
variable [Algebra K M]
variable [Algebra L M] [Algebra L' M]
variable [IsScalarTower K L M] [IsScalarTower K L' M]
variable [Module.Free L M] [Module.Free L' M]

/-- Common-top field-norm form of the lcm value step.  The two lower norm
containments are generated by field-norm transitivity from the common top
field `M`. -/
theorem lcm_dvd_of_exists_mem_val_of_common_fieldNormSubgroup_le_towers
    (vK : MultiplicativeIntegerValuation Kˣ)
    (vL : MultiplicativeIntegerValuation Lˣ)
    (vL' : MultiplicativeIntegerValuation L'ˣ)
    (residueDegree residueDegree' : ℕ)
    (hformula :
      ∀ x : Lˣ, vK.val (normUnits K L x) =
        (residueDegree : ℤ) * vL.val x)
    (hformula' :
      ∀ x : L'ˣ, vK.val (normUnits K L' x) =
        (residueDegree' : ℤ) * vL'.val x)
    {S : Subgroup Kˣ} {n : ℤ}
    (hn : ∃ x : Kˣ, x ∈ S ∧ vK.val x = n)
    (hS : S ≤ fieldNormSubgroup K M) :
    ((((residueDegree : ℤ).lcm (residueDegree' : ℤ) : ℕ) : ℤ) ∣ n) := by
  simpa [valuedFieldNorm] using
    (ValuedNorm.lcm_dvd_of_exists_mem_val_of_common_le_normSubgroups
      (valuedFieldNorm K L vK vL residueDegree hformula)
      (valuedFieldNorm K L' vK vL' residueDegree' hformula')
      (S := S) (T := fieldNormSubgroup K M) hn hS
      (fieldNormSubgroup_le_valuedFieldNorm_normSubgroup_of_tower
        (K := K) (E := L) (M := M) vK vL residueDegree hformula)
      (fieldNormSubgroup_le_valuedFieldNorm_normSubgroup_of_tower
        (K := K) (E := L') (M := M) vK vL' residueDegree' hformula'))

/-- Field-norm element form of the common-top lcm value step.  Every element
which is visibly a norm from the common top field has base valuation divisible
by the lcm of the two lower valued field-norm residue degrees. -/
theorem lcm_dvd_val_fieldNormUnits_of_common_tower
    (vK : MultiplicativeIntegerValuation Kˣ)
    (vL : MultiplicativeIntegerValuation Lˣ)
    (vL' : MultiplicativeIntegerValuation L'ˣ)
    (residueDegree residueDegree' : ℕ)
    (hformula :
      ∀ x : Lˣ, vK.val (normUnits K L x) =
        (residueDegree : ℤ) * vL.val x)
    (hformula' :
      ∀ x : L'ˣ, vK.val (normUnits K L' x) =
        (residueDegree' : ℤ) * vL'.val x)
    (y : Mˣ) :
    ((((residueDegree : ℤ).lcm (residueDegree' : ℤ) : ℕ) : ℤ) ∣
      vK.val (normUnits K M y)) :=
  lcm_dvd_of_exists_mem_val_of_common_fieldNormSubgroup_le_towers
    (K := K) (L := L) (L' := L') (M := M)
    vK vL vL' residueDegree residueDegree' hformula hformula'
    (S := fieldNormSubgroup K M)
    (n := vK.val (normUnits K M y))
    ⟨normUnits K M y, ⟨y, rfl⟩, rfl⟩
    (fun _ hx => hx)

/-- Membership form of the common-top lcm value step.  Once an element of the
base unit group is known to lie in the common-top field-norm subgroup, its
valuation satisfies the same lcm divisibility. -/
theorem lcm_dvd_val_of_mem_common_fieldNormSubgroup_towers
    (vK : MultiplicativeIntegerValuation Kˣ)
    (vL : MultiplicativeIntegerValuation Lˣ)
    (vL' : MultiplicativeIntegerValuation L'ˣ)
    (residueDegree residueDegree' : ℕ)
    (hformula :
      ∀ x : Lˣ, vK.val (normUnits K L x) =
        (residueDegree : ℤ) * vL.val x)
    (hformula' :
      ∀ x : L'ˣ, vK.val (normUnits K L' x) =
        (residueDegree' : ℤ) * vL'.val x)
    {x : Kˣ} (hx : x ∈ fieldNormSubgroup K M) :
    ((((residueDegree : ℤ).lcm (residueDegree' : ℤ) : ℕ) : ℤ) ∣
      vK.val x) := by
  rcases hx with ⟨y, hy⟩
  rw [← hy]
  exact lcm_dvd_val_fieldNormUnits_of_common_tower
    (K := K) (L := L) (L' := L') (M := M)
    vK vL vL' residueDegree residueDegree' hformula hformula' y

end TwoLowerTowers

end FieldNormCommon

end TameAbhyankar

end
