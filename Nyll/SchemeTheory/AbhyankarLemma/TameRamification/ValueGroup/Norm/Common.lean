import Nyll.SchemeTheory.AbhyankarLemma.TameRamification.ValueGroup.Transport

/-!
# Common norm images and value steps

This file generates the two lower value-step inclusions used by the transport
layer from concrete `ValuedNorm.normSubgroup` containments.
-/

noncomputable section

namespace TameAbhyankar

open LocalFieldTheory.DiscreteValuationField

namespace ValuedNorm

variable {G H H' : Type _} [Group G] [Group H] [Group H']
variable {vG : MultiplicativeIntegerValuation G}
variable {vH : MultiplicativeIntegerValuation H}
variable {vH' : MultiplicativeIntegerValuation H'}

/-- If a subgroup of the target group lies in the norm subgroup of a
`ValuedNorm`, then every value attained on that subgroup is divisible by the
valued norm residue degree. -/
theorem subgroupValueSubgroup_le_residueDegreeMultiple_of_le_normSubgroup
    (N : ValuedNorm vG vH) {T : Subgroup G}
    (hT : T ≤ N.normSubgroup) :
    vG.subgroupValueSubgroup T ≤
      integerMultipleSubgroup (N.residueDegree : ℤ) :=
  (MultiplicativeIntegerValuation.subgroupValueSubgroup_le_integerMultipleSubgroup_iff
    vG T (N.residueDegree : ℤ)).2
    (fun _ hx => N.residueDegree_dvd_valuation_of_mem_normSubgroup (hT hx))

/-- Common-norm-image form of the lcm step: a larger common image subgroup
contained in two norm subgroups supplies the two lower value-step inclusions,
and any actual value generated by a smaller ramification image subgroup is
therefore divisible by the lcm of the two valued norm residue degrees. -/
theorem lcm_dvd_of_exists_mem_val_of_common_le_normSubgroups
    (N : ValuedNorm vG vH) (N' : ValuedNorm vG vH')
    {S T : Subgroup G} {n : ℤ}
    (hn : ∃ x : G, x ∈ S ∧ vG.val x = n)
    (hST : S ≤ T)
    (hT : T ≤ N.normSubgroup)
    (hT' : T ≤ N'.normSubgroup) :
    ((((N.residueDegree : ℤ).lcm (N'.residueDegree : ℤ) : ℕ) : ℤ) ∣ n) :=
  MultiplicativeIntegerValuation.int_lcm_dvd_of_exists_mem_val_of_le_of_subgroupValueSubgroup_le
    vG hn hST
    (subgroupValueSubgroup_le_residueDegreeMultiple_of_le_normSubgroup N hT)
    (subgroupValueSubgroup_le_residueDegreeMultiple_of_le_normSubgroup N' hT')

end ValuedNorm

end TameAbhyankar

end
