import Nyll.SchemeTheory.Divisors.NormalCrossings.Basic
import Mathlib.RingTheory.Ideal.Height

/-!
# Selecting a branch from a height-one prime

A height-one prime containing a split normal-crossings equation is exactly
one of the labelled branch ideals.  This identifies a geometric divisorial
prime with the branch index required by the local Kummer theorem.
-/

noncomputable section

namespace EtaleFundamentalGroups

universe u

/-- A height-one prime containing the product of a finite family of prime
elements is the principal prime generated by one of the factors occurring
in that product.  This is the branch-selection core which does not require
regularity of the other branch quotients. -/
theorem exists_activeBranch_eq_of_heightOnePrime_mem_boundaryProduct
    {R : Type u} [CommRing R] [IsDomain R] [IsLocalRing R]
    {d r : ℕ} {t : Fin d → R}
    (hprime : ∀ i : Fin d, i.1 < r → Prime (t i))
    (q : Ideal R) [q.IsPrime] (hqheight : q.height = 1)
    (hprod : boundaryProduct t r ∈ q) :
    ∃ i : Fin d, i.1 < r ∧ q = Ideal.span ({t i} : Set R) := by
  classical
  have hfactor : ∀ s : Finset (Fin d),
      (∏ i ∈ s, t i) ∈ q → ∃ i ∈ s, t i ∈ q := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
        simp only [Finset.prod_empty, Finset.notMem_empty,
          false_and, exists_false, imp_false]
        exact (inferInstance : q.IsPrime).ne_top ∘ q.eq_top_iff_one.mpr
    | @insert i s hi ih =>
        rw [Finset.prod_insert hi]
        intro hmem
        rcases (inferInstance : q.IsPrime).mem_or_mem hmem with hit | hs
        · exact ⟨i, Finset.mem_insert_self i s, hit⟩
        · obtain ⟨j, hjs, hjq⟩ := ih hs
          exact ⟨j, Finset.mem_insert_of_mem hjs, hjq⟩
  obtain ⟨i, hi, htiq⟩ := hfactor (boundaryIndices d r) (by
    simpa only [boundaryProduct] using hprod)
  have hir : i.1 < r := by
    simpa only [boundaryIndices, Finset.mem_filter, Finset.mem_univ,
      true_and] using hi
  exact ⟨i, hir,
    q.eq_span_singleton_of_height_eq_one hqheight htiq
      (hprime i hir)⟩

/-- A height-one prime containing a split strict-normal-crossings equation
is the principal prime of one of its active parameters. -/
theorem exists_activeBranch_eq_of_heightOnePrime_mem_boundary
    {R : Type u} [CommRing R] [IsDomain R] [IsLocalRing R]
    {d r : ℕ} {f : R} {t : Fin d → R}
    (hNC : IsSplitStrictNormalCrossingsAt f t r)
    (q : Ideal R) [q.IsPrime] (hqheight : q.height = 1)
    (hfq : f ∈ q) :
    ∃ i : Fin d, i.1 < r ∧ q = Ideal.span ({t i} : Set R) := by
  classical
  have hprod : boundaryProduct t r ∈ q :=
    (Ideal.mem_iff_of_associated hNC.2.2.2.2.1).mp hfq
  have hfactor : ∀ s : Finset (Fin d),
      (∏ i ∈ s, t i) ∈ q → ∃ i ∈ s, t i ∈ q := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
        simp only [Finset.prod_empty, Finset.notMem_empty,
          false_and, exists_false, imp_false]
        exact (inferInstance : q.IsPrime).ne_top ∘ q.eq_top_iff_one.mpr
    | @insert i s hi ih =>
        rw [Finset.prod_insert hi]
        intro hmem
        rcases (inferInstance : q.IsPrime).mem_or_mem hmem with hit | hs
        · exact ⟨i, Finset.mem_insert_self i s, hit⟩
        · obtain ⟨j, hjs, hjq⟩ := ih hs
          exact ⟨j, Finset.mem_insert_of_mem hjs, hjq⟩
  obtain ⟨i, hi, htiq⟩ := hfactor (boundaryIndices d r) (by
    simpa only [boundaryProduct] using hprod)
  have hir : i.1 < r := by
    simpa only [boundaryIndices, Finset.mem_filter, Finset.mem_univ,
      true_and] using hi
  exact ⟨i, hir,
    q.eq_span_singleton_of_height_eq_one hqheight htiq
      (hNC.2.2.2.1 i hir)⟩

end EtaleFundamentalGroups

end
