import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
import Mathlib.AlgebraicGeometry.Morphisms.Etale
import Mathlib.RingTheory.Regular.RegularSequence
import Mathlib.RingTheory.RegularLocalRing.Defs

/-!
# Effective Cartier divisors and normal crossings

This file supplies scheme-theoretic boundary data using
`Scheme.IdealSheafData`.  The stalk ideal is constructed canonically as the
supremum of the images of the ideal on affine neighbourhoods.  Effective
Cartier and normal-crossings conditions are then stated as local properties
of this actual ideal-sheaf data.

The closed support and radical of an ideal sheaf are already provided by
`Scheme.IdealSheafData.support` and `Scheme.IdealSheafData.radical`.
-/

open CategoryTheory
open scoped BigOperators

namespace AlgebraicGeometry

universe u

namespace Scheme

/-- A scheme is regular at a point when its local ring there is regular. -/
def IsRegularAt (X : Scheme.{u}) (x : X) : Prop :=
  IsRegularLocalRing (X.presheaf.stalk x)

/-- A scheme is regular along a set when it is regular at every point of it. -/
def IsRegularAlong (X : Scheme.{u}) (Z : Set X) : Prop :=
  ∀ x ∈ Z, X.IsRegularAt x

/-- A finite family in a local ring is a regular system of parameters when it
is a regular sequence and generates the maximal ideal. -/
def IsRegularSystemOfParameters
    {R : Type u} [CommRing R] [IsLocalRing R] {d : ℕ}
    (t : Fin d → R) : Prop :=
  RingTheory.Sequence.IsRegular R (List.ofFn t) ∧
    Ideal.ofList (List.ofFn t) = IsLocalRing.maximalIdeal R

/-- The product of the first `r` members of a parameter family. -/
def initialParameterProduct
    {R : Type u} [CommMonoid R] {d : ℕ}
    (t : Fin d → R) (r : ℕ) (hr : r ≤ d) : R :=
  ∏ i : Fin r, t (Fin.castLE hr i)

namespace IdealSheafData

variable {X : Scheme.{u}}

/-- The ideal in the local ring obtained from an ideal sheaf.

It is the supremum of the images of the ideals on all affine neighbourhoods
of the point.  This avoids choosing a particular affine chart and is the
direct ideal-theoretic analogue of forming the stalk of a subsheaf. -/
noncomputable def stalkIdeal (I : X.IdealSheafData) (x : X) :
    Ideal (X.presheaf.stalk x) :=
  ⨆ (U : X.affineOpens) (hx : x ∈ U.1),
    (I.ideal U).map (X.presheaf.germ U.1 x hx).hom

/-- The contribution of any affine neighbourhood is contained in the stalk ideal. -/
lemma map_ideal_le_stalkIdeal (I : X.IdealSheafData) (x : X)
    (U : X.affineOpens) (hx : x ∈ U.1) :
    (I.ideal U).map (X.presheaf.germ U.1 x hx).hom ≤ I.stalkIdeal x :=
  le_iSup_of_le U <| le_iSup_of_le hx le_rfl

/-- Taking the stalk ideal is monotone in the ideal sheaf. -/
lemma stalkIdeal_mono {I J : X.IdealSheafData} (h : I ≤ J) (x : X) :
    I.stalkIdeal x ≤ J.stalkIdeal x := by
  refine iSup_le fun U ↦ iSup_le fun hx ↦ ?_
  exact (Ideal.map_mono (h U)).trans (J.map_ideal_le_stalkIdeal x U hx)

/-- The stalk ideal of the unit ideal sheaf is the unit ideal. -/
@[simp]
lemma stalkIdeal_top (x : X) :
    (⊤ : X.IdealSheafData).stalkIdeal x = ⊤ := by
  apply top_unique
  obtain ⟨U, hU, hxU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (X := X) (U := ⊤) (x := x) (by simp)
  let V : X.affineOpens := ⟨U, hU⟩
  have h := map_ideal_le_stalkIdeal (⊤ : X.IdealSheafData) x V hxU
  simpa only [ideal_top, Pi.top_apply, Ideal.map_top] using h

/-- An ideal sheaf is radical when it agrees with its sheafwise radical.
Equivalently, it carries the reduced closed-subscheme structure on its
support. -/
def IsReduced (I : X.IdealSheafData) : Prop :=
  I.radical = I

/-- An ideal sheaf is an effective Cartier divisor at `x` if it is generated
on an affine neighbourhood of `x` by a non-zero-divisor. -/
def IsEffectiveCartierAt (I : X.IdealSheafData) (x : X) : Prop :=
  ∃ (U : X.affineOpens) (_hx : x ∈ U.1) (f : Γ(X, U.1)),
    IsRegular f ∧ I.ideal U = Ideal.span {f}

/-- An ideal sheaf defines an effective Cartier divisor if it does so at
every point. -/
def IsEffectiveCartier (I : X.IdealSheafData) : Prop :=
  ∀ x, I.IsEffectiveCartierAt x

/-- The unit ideal sheaf is the empty effective Cartier divisor. -/
lemma isEffectiveCartier_top :
    IsEffectiveCartier (⊤ : X.IdealSheafData) := by
  intro x
  obtain ⟨U, hU, hxU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (X := X) (U := ⊤) (x := x) (by simp)
  refine ⟨⟨U, hU⟩, hxU, 1, isRegular_one, ?_⟩
  simp

/-- An ideal sheaf has strict normal crossings at `x` when the ambient local
ring is regular and its stalk ideal is generated by a product of an initial
segment of a regular system of parameters.
This pointwise predicate is intended for points in the support. -/
def IsStrictNormalCrossingsAt (I : X.IdealSheafData) (x : X) : Prop :=
  X.IsRegularAt x ∧
    ∃ (d r : ℕ) (t : Fin d → X.presheaf.stalk x),
      0 < r ∧ ∃ (hr : r ≤ d), IsRegularSystemOfParameters t ∧
        I.stalkIdeal x = Ideal.span {initialParameterProduct t r hr}

/-- An ideal sheaf has strict normal crossings if it has strict normal
crossings at every point of its support. -/
def IsStrictNormalCrossings (I : X.IdealSheafData) : Prop :=
  ∀ x ∈ I.support, I.IsStrictNormalCrossingsAt x

/-- An ideal sheaf has normal crossings at `x` when an étale neighbourhood
whose image contains `x` makes its pullback a strict-normal-crossings ideal
sheaf. -/
def IsNormalCrossingsAt (I : X.IdealSheafData) (x : X) : Prop :=
  ∃ (U : Scheme.{u}) (f : U ⟶ X) (u : U),
    Etale f ∧ f u = x ∧ (I.comap f).IsStrictNormalCrossings

/-- An ideal sheaf has normal crossings if it does so at every point of its
support. -/
def IsNormalCrossings (I : X.IdealSheafData) : Prop :=
  ∀ x ∈ I.support, I.IsNormalCrossingsAt x

/-- The ambient scheme is regular along the support of an ideal sheaf. -/
def IsAmbientRegularAlongSupport (I : X.IdealSheafData) : Prop :=
  X.IsRegularAlong I.support

/-- Strict normal crossings force regularity of the ambient scheme along the
support. -/
lemma IsStrictNormalCrossings.isAmbientRegularAlongSupport
    {I : X.IdealSheafData} (hI : I.IsStrictNormalCrossings) :
    I.IsAmbientRegularAlongSupport :=
  fun x hx ↦ (hI x hx).1

/-- Strict normal crossings are normal crossings, using the identity étale
neighbourhood. -/
lemma IsStrictNormalCrossings.isNormalCrossings
    {I : X.IdealSheafData} (hI : I.IsStrictNormalCrossings) :
    I.IsNormalCrossings := by
  intro x hx
  refine ⟨X, 𝟙 X, x, by infer_instance, by simp, ?_⟩
  simpa using hI

end IdealSheafData

/-- An effective Cartier divisor on a scheme, represented by its ideal
sheaf. -/
def EffectiveCartierDivisor (X : Scheme.{u}) :=
  { I : X.IdealSheafData // I.IsEffectiveCartier }

namespace EffectiveCartierDivisor

variable {X : Scheme.{u}}

instance : Coe (EffectiveCartierDivisor X) X.IdealSheafData :=
  ⟨Subtype.val⟩

/-- The empty effective Cartier divisor. -/
def empty (X : Scheme.{u}) : EffectiveCartierDivisor X :=
  ⟨⊤, IdealSheafData.isEffectiveCartier_top⟩

/-- The closed support of an effective Cartier divisor. -/
def support (D : EffectiveCartierDivisor X) : TopologicalSpace.Closeds X :=
  D.1.support

/-- The empty divisor has empty support. -/
@[simp]
lemma support_empty (X : Scheme.{u}) :
    (empty X).support = ⊥ :=
  IdealSheafData.support_top

/-- A reduced effective Cartier divisor has radical ideal sheaf. -/
def IsReduced (D : EffectiveCartierDivisor X) : Prop :=
  D.1.IsReduced

/-- The empty effective Cartier divisor is reduced. -/
@[simp]
lemma isReduced_empty (X : Scheme.{u}) :
    (empty X).IsReduced := by
  simp [IsReduced, empty, IdealSheafData.IsReduced]

/-- Strict normal crossings at a point of an effective Cartier divisor. -/
def IsStrictNormalCrossingsAt (D : EffectiveCartierDivisor X) (x : X) : Prop :=
  D.1.IsStrictNormalCrossingsAt x

/-- Strict normal crossings for an effective Cartier divisor. -/
def IsStrictNormalCrossings (D : EffectiveCartierDivisor X) : Prop :=
  D.1.IsStrictNormalCrossings

/-- Normal crossings at a point of an effective Cartier divisor. -/
def IsNormalCrossingsAt (D : EffectiveCartierDivisor X) (x : X) : Prop :=
  D.1.IsNormalCrossingsAt x

/-- Normal crossings for an effective Cartier divisor. -/
def IsNormalCrossings (D : EffectiveCartierDivisor X) : Prop :=
  D.1.IsNormalCrossings

/-- The ambient scheme is regular along the support of an effective Cartier divisor. -/
def IsAmbientRegularAlongSupport (D : EffectiveCartierDivisor X) : Prop :=
  D.1.IsAmbientRegularAlongSupport

/-- A strict-normal-crossings effective Cartier divisor is a
normal-crossings divisor. -/
lemma IsStrictNormalCrossings.isNormalCrossings
    {D : EffectiveCartierDivisor X} (hD : D.IsStrictNormalCrossings) :
    D.IsNormalCrossings :=
  Scheme.IdealSheafData.IsStrictNormalCrossings.isNormalCrossings hD

end EffectiveCartierDivisor

end Scheme

end AlgebraicGeometry
