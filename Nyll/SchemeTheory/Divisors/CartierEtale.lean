import Mathlib.RingTheory.Flat.Basic
import Nyll.SchemeTheory.Divisors.ArithmeticBoundaryEtale

/-!
# Effective Cartier divisors under affine flat pullback

The pullback ideal of a locally principal non-zero-divisor remains locally
principal and is generated by the image of that non-zero-divisor.  Flatness
preserves its regularity.
-/

noncomputable section

open CategoryTheory

namespace AlgebraicGeometry

universe u

namespace Scheme

namespace IdealSheafData

variable {X Y : Scheme.{u}}

/-- Effective Cartier ideal sheaves remain effective Cartier after affine
flat pullback. -/
theorem IsEffectiveCartier.comap_of_flat_of_isAffineHom
    (I : X.IdealSheafData) (hI : I.IsEffectiveCartier)
    (f : Y ⟶ X) [Flat f] [IsAffineHom f] :
    (I.comap f).IsEffectiveCartier := by
  intro y
  obtain ⟨U, hfyU, a, ha, hIa⟩ := hI (f y)
  let V : Y.affineOpens := ⟨f ⁻¹ᵁ U.1, U.2.preimage f⟩
  have hyV : y ∈ V.1 := hfyU
  let a' : Γ(Y, V.1) := (f.app U.1).hom a
  refine ⟨V, hyV, a', ?_, ?_⟩
  · let : Algebra Γ(X, U.1) Γ(Y, V.1) := (f.app U.1).hom.toAlgebra
    have hflat : (f.app U.1).hom.Flat := by
      simpa only [V, f.appLE_eq_app] using
        f.flat_appLE U.2 V.2 (show V.1 ≤ f ⁻¹ᵁ U.1 from le_rfl)
    let : Module.Flat Γ(X, U.1) Γ(Y, V.1) := hflat
    have ha' := IsSMulRegular.of_flat (S := Γ(Y, V.1)) ha.left
    change IsSMulRegular Γ(Y, V.1) a' at ha'
    exact (Commute.isRegular_iff (Commute.all a')).mpr ha'
  · rw [ideal_comap_preimage_of_isAffineHom I f U, hIa,
      Ideal.map_span, Set.image_singleton]

end IdealSheafData

namespace EffectiveCartierDivisor

variable {X Y : Scheme.{u}}

/-- Pullback of an effective Cartier divisor along an affine flat morphism. -/
noncomputable def comap (D : EffectiveCartierDivisor X)
    (f : Y ⟶ X) [Flat f] [IsAffineHom f] : EffectiveCartierDivisor Y :=
  ⟨D.1.comap f,
    IdealSheafData.IsEffectiveCartier.comap_of_flat_of_isAffineHom
      D.1 D.2 f⟩

@[simp]
lemma coe_comap (D : EffectiveCartierDivisor X)
    (f : Y ⟶ X) [Flat f] [IsAffineHom f] :
    (D.comap f : Y.IdealSheafData) = D.1.comap f :=
  rfl

/-- Pullback along a finite-etale object, with all morphism-property
instances supplied by the object itself. -/
noncomputable def comapFiniteEtale (D : EffectiveCartierDivisor X)
    (Y' : FiniteEtale X) : EffectiveCartierDivisor Y'.left := by
  letI hY : IsFiniteEtale Y'.hom := Y'.prop
  letI : IsFinite Y'.hom := hY.toIsFinite
  exact @comap X Y'.left D Y'.hom
    (Etale.iff_flat_and_formallyUnramified.mp hY.toEtale).1
    (IsFinite.toIsAffineHom (f := Y'.hom))

@[simp]
lemma coe_comapFiniteEtale (D : EffectiveCartierDivisor X)
    (Y' : FiniteEtale X) :
    (D.comapFiniteEtale Y' : Y'.left.IdealSheafData) = D.1.comap Y'.hom := by
  rfl

end EffectiveCartierDivisor

end Scheme

end AlgebraicGeometry

end
