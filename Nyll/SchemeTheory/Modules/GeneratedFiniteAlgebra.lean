import Nyll.SchemeTheory.Modules.GeneratedAlgebraLocalization
import Nyll.SchemeTheory.RingTheory.SubmoduleAdjoinLocalization
import Mathlib.AlgebraicGeometry.Morphisms.Finite
import Mathlib.AlgebraicGeometry.Morphisms.AffineAnd
import Mathlib.RingTheory.RingHom.Finite

/-!
# A finite relative scheme generated by a finite quasicoherent submodule

The section algebra is generated inside the given integral ambient algebra.
Finitely generated module sections therefore give finite section algebras.
The native cartesian affine charts of the previously constructed gluing
then prove finiteness of its actual structure morphism.
-/

noncomputable section

universe u

open CategoryTheory Opposite

namespace AlgebraicGeometry.Scheme.GeneratedAlgebra

private theorem finite_codRestrict_of_eq
    {R B : Type u} [CommRing R] [CommRing B] (ι : R →+* B)
    (C C' : Subring B) (hC : C = C')
    (hι : ∀ r, ι r ∈ C) (hι' : ∀ r, ι r ∈ C')
    (hfinite : (ι.codRestrict C' hι').Finite) :
    (ι.codRestrict C hι).Finite := by
  subst C'
  exact hfinite

private theorem isFinite_comp_iso {Y Z W : Scheme.{u}}
    (f : Y ⟶ Z) (e : Z ≅ W) (hf : IsFinite f)
    (hRespect : MorphismProperty.RespectsIso (@IsFinite : MorphismProperty Scheme.{u})) :
    IsFinite (f ≫ e.hom) :=
  hRespect.toRespectsRight.postcomp e.hom e.isIso_hom f hf

variable {X : Scheme.{u}} {A : TopCat.Sheaf CommRingCat.{u} X}
variable (α : X.sheaf ⟶ A)
variable (N : SheafOfModules.Submodule (RelativeSpec.underlyingModule α))

/-- Finite module generators inside the actual integral section algebra
produce a finite structure map to the generated section ring. -/
theorem finite_structureMap (U : X.AffineZariskiSite)
    (hIntegral : (α.hom.app (op U.1)).hom.IsIntegral)
    (hFinite : (N.toSubmodule.obj (op U.1)).FG) :
    ((structureMap α N.toSubmodule).app (op U.1)).hom.Finite := by
  let R : CommRingCat.{u} := Γ(X, U.1)
  let B : CommRingCat.{u} := A.obj.obj (op U.1)
  let ι : R →+* B := (α.hom.app (op U.1)).hom
  let : Algebra R B := ι.toAlgebra
  have : Algebra.IsIntegral R B := algebraMap_isIntegral_iff.mp hIntegral
  let P : Submodule R B := N.toSubmodule.obj (op U.1)
  have hFiniteAdjoin : Module.Finite R (Algebra.adjoin R (P : Set B)) :=
    Submodule.finite_adjoin_of_fg P hFinite
  have hC : sectionSubring α N.toSubmodule (op U.1) =
      (Algebra.adjoin R (P : Set B)).toSubring :=
    sectionSubring_eq_adjoin α N.toSubmodule (op U.1)
  change (ι.codRestrict (sectionSubring α N.toSubmodule (op U.1))
    (fun x => Subring.subset_closure (Or.inl ⟨x, rfl⟩))).Finite
  exact finite_codRestrict_of_eq ι (sectionSubring α N.toSubmodule (op U.1))
    (Algebra.adjoin R (P : Set B)).toSubring hC
    (fun x => Subring.subset_closure (Or.inl ⟨x, rfl⟩))
    (fun x => (Algebra.adjoin R (P : Set B)).algebraMap_mem x)
    (RingHom.finite_algebraMap.mpr hFiniteAdjoin)

variable [(RelativeSpec.underlyingModule α).IsQuasicoherent]
variable [(show X.Modules from N.toSheafOfModules).IsQuasicoherent]

/-- The actual glued relative scheme generated by a finite quasicoherent
submodule of an integral algebra is finite over the original base. -/
theorem isFinite_toBase
    (hIntegral : ∀ U : X.AffineZariskiSite, (α.hom.app (op U.1)).hom.IsIntegral)
    (hFinite : ∀ U : X.AffineZariskiSite, (N.toSubmodule.obj (op U.1)).FG) :
    IsFinite (toBase α N) := by
  have hAffine : HasAffineProperty (@IsFinite : MorphismProperty Scheme.{u})
      (affineAnd RingHom.Finite) :=
    (HasAffineProperty.affineAnd_iff (@IsFinite : MorphismProperty Scheme.{u})
      RingHom.finite_respectsIso RingHom.finite_localizationPreserves.away
      RingHom.finite_ofLocalizationSpan).mpr
        (fun {Y Z : Scheme.{u}} (g : Y ⟶ Z) => isFinite_iff g)
  have hLocal : IsZariskiLocalAtTarget (@IsFinite : MorphismProperty Scheme.{u}) :=
    ((HasAffineProperty.iff
      (P := (@IsFinite : MorphismProperty Scheme.{u}))
      (Q := affineAnd RingHom.Finite)).mp hAffine).1
  apply IsZariskiLocalAtTarget.of_openCover
    (P := (@IsFinite : MorphismProperty Scheme.{u}))
    (AffineZariskiSite.directedCover X)
  intro U
  let h := ((gluingData α N).isPullback_natTrans_ι_toBase U).flip
  have hmodel : IsFinite ((gluingData α N).natTrans.app U) := by
    let e : U.1.toScheme ≅ Spec Γ(X, U.1) := U.2.isoSpec
    change IsFinite (Spec.map ((affineStructureMap α N.toSubmodule).app (op U)) ≫
      e.inv)
    have hSpec : IsFinite (Spec.map ((affineStructureMap α N.toSubmodule).app (op U))) :=
      (IsFinite.SpecMap_iff ((affineStructureMap α N.toSubmodule).app (op U))).mpr
        (finite_structureMap α N U (hIntegral U) (hFinite U))
    exact isFinite_comp_iso (Spec.map ((affineStructureMap α N.toSubmodule).app (op U)))
      e.symm hSpec hLocal.toRespects
  have hfiniteComp : IsFinite (h.isoPullback.inv ≫ (gluingData α N).natTrans.app U) :=
    inferInstance
  exact Eq.mp (congrArg IsFinite h.isoPullback_inv_snd) hfiniteComp

end AlgebraicGeometry.Scheme.GeneratedAlgebra
