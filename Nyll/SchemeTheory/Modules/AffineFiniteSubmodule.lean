import Nyll.SchemeTheory.Modules.ImageSubmodule
import Nyll.SchemeTheory.Modules.FiniteTypeTilde
import Nyll.SchemeTheory.Modules.QuasicoherentLocal
import Nyll.SchemeTheory.Modules.QuasicoherentImage
import Mathlib.AlgebraicGeometry.Modules.Tilde
import Mathlib.CategoryTheory.Adjunction.Basic

/-!
# Actual affine subsheaves generated by module sections

A submodule of the affine global-section module gives an actual morphism
from its tilde sheaf to the ambient module by the native tilde--Gamma
adjunction. Its native image is a sheaf submodule. The unit identity proves
that it contains the specified actual sections; finite module generators
give a finite-type subsheaf through the actual epimorphism onto the image.
-/

noncomputable section

universe u

open CategoryTheory Opposite

namespace AlgebraicGeometry.Scheme.Modules

variable {R : CommRingCat.{u}} (F : (Spec R).Modules)

/-- The bundled inclusion retains the actual affine global-section module
and its existing scalar structure. -/
def affineSubmoduleInclusion
    (K : Submodule R ((moduleSpecΓFunctor (R := R)).obj F)) :
    ModuleCat.of R K ⟶ (moduleSpecΓFunctor (R := R)).obj F :=
  ModuleCat.ofHom (X := K) (Y := (moduleSpecΓFunctor (R := R)).obj F) K.subtype

/-- The actual morphism determined by inclusion of a submodule of global sections. -/
def affineSubmoduleMap
    (K : Submodule R ((moduleSpecΓFunctor (R := R)).obj F)) :
    (tilde.functor R).obj (ModuleCat.of R K) ⟶ F :=
  ((tilde.adjunction (R := R)).homEquiv (ModuleCat.of R K) F).symm
    (affineSubmoduleInclusion F K)

/-- The global-section component of the constructed map is the actual inclusion,
under the canonical tilde global-section isomorphism. -/
theorem affineSubmoduleMap_globalSections
    (K : Submodule R ((moduleSpecΓFunctor (R := R)).obj F)) :
    (tilde.isoTop (ModuleCat.of R K)).hom ≫
        (moduleSpecΓFunctor (R := R)).map (affineSubmoduleMap F K) =
      affineSubmoduleInclusion F K := by
  have h := ((tilde.adjunction (R := R)).homEquiv
    (ModuleCat.of R K) F).apply_symm_apply (affineSubmoduleInclusion F K)
  rw [Adjunction.homEquiv_unit] at h
  exact h

/-- The native image of the actual affine morphism generated by `K`. -/
def affineSubmodule
    (K : Submodule R ((moduleSpecΓFunctor (R := R)).obj F)) : F.Submodule :=
  SheafOfModules.imageSubmodule
    ((sheafOfModulesEquivalence (Spec R)).functor.map (affineSubmoduleMap F K))

/-- Every specified global section belongs to the actual generated subsheaf. -/
theorem mem_affineSubmodule_globalSections
    (K : Submodule R ((moduleSpecΓFunctor (R := R)).obj F))
    (s : (moduleSpecΓFunctor (R := R)).obj F) (hs : s ∈ K) :
    s ∈ (affineSubmodule F K).toSubmodule.obj (op ⊤) := by
  let sK : K := ⟨s, hs⟩
  let y := (tilde.isoTop (ModuleCat.of R K)).hom.hom sK
  let φ := (sheafOfModulesEquivalence (Spec R)).functor.map (affineSubmoduleMap F K)
  let z := ((SheafOfModules.toImageSubmodule φ).val.app (op ⊤)).hom y
  have hMap := congrArg (fun g => g.hom sK) (affineSubmoduleMap_globalSections F K)
  have hImage := congrArg (fun g => (g.val.app (op ⊤)).hom y)
    (SheafOfModules.toImageSubmodule_ι φ)
  have hz : z.val = s := hImage.trans hMap
  rw [← hz]
  exact z.property

/-- Finite module generators produce an actual native submodule of finite type. -/
theorem isFiniteType_affineSubmodule
    (K : Submodule R ((moduleSpecΓFunctor (R := R)).obj F)) (hK : K.FG) :
    (affineSubmodule F K).toSheafOfModules.IsFiniteType := by
  have : Module.Finite R K := Module.Finite.of_fg hK
  have : ((sheafOfModulesEquivalence (Spec R)).functor.obj
      ((tilde.functor R).obj (ModuleCat.of R K))).IsFiniteType :=
    isFiniteType_tilde_of_finite (ModuleCat.of R K)
  exact SheafOfModules.isFiniteType_imageSubmodule
    ((sheafOfModulesEquivalence (Spec R)).functor.map (affineSubmoduleMap F K))

/-- In a quasicoherent ambient module, the actual affine generated submodule
is quasicoherent. -/
theorem isQuasicoherent_affineSubmodule [F.IsQuasicoherent]
    (K : Submodule R ((moduleSpecΓFunctor (R := R)).obj F)) :
    (affineSubmodule F K).toSheafOfModules.IsQuasicoherent := by
  have : ((sheafOfModulesEquivalence (Spec R)).functor.obj
      ((tilde.functor R).obj (ModuleCat.of R K))).IsQuasicoherent :=
    inferInstanceAs (tilde (ModuleCat.of R K)).IsQuasicoherent
  have : ((sheafOfModulesEquivalence (Spec R)).functor.obj F).IsQuasicoherent :=
    inferInstanceAs F.IsQuasicoherent
  exact SheafOfModules.isQuasicoherent_imageSubmodule
    ((sheafOfModulesEquivalence (Spec R)).functor.map (affineSubmoduleMap F K))

end AlgebraicGeometry.Scheme.Modules
