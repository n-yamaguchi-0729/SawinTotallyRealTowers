import Nyll.SchemeTheory.Modules.FiniteRelativeSpec
import Mathlib.Algebra.Category.ModuleCat.Presheaf.Submodule
import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.Algebra.Ring.Subring.Basic

/-!
# The algebra presheaf generated by an actual submodule

Given an actual sheaf of commutative algebras and a submodule of its
underlying module presheaf, generate the section subring from the structure
coefficients and the given submodule sections. Restriction is the literal
ambient ring restriction. Its stability and functor laws are proved, not
provided as compatibility fields.

On the affine site this is the ring diagram for relative gluing. This file
does not yet prove its coequifibered property or extend local submodules.
-/

noncomputable section

universe u

open CategoryTheory Opposite

namespace AlgebraicGeometry.Scheme.GeneratedAlgebra

variable {X : Scheme.{u}} {A : TopCat.Sheaf CommRingCat.{u} X}
variable (α : X.sheaf ⟶ A)
variable (N : (RelativeSpec.underlyingModule α).val.Submodule)

/-- The actual submodule of the algebra section ring. The coefficient
action is the same restriction of scalars used by `underlyingModule`. -/
def sectionSubmodule (U : X.Opensᵒᵖ) :
    let : Algebra (X.presheaf.obj U) (A.obj.obj U) := (α.hom.app U).hom.toAlgebra
    Submodule (X.presheaf.obj U) (A.obj.obj U) := by
  intro algebra
  change Submodule (X.ringCatSheaf.obj.obj U) ((RelativeSpec.underlyingModule α).val.obj U)
  exact N.obj U

/-- The actual generated section subring, inside the original section ring. -/
def sectionSubring (U : X.Opensᵒᵖ) : Subring (A.obj.obj U) :=
  let : Algebra (X.presheaf.obj U) (A.obj.obj U) := (α.hom.app U).hom.toAlgebra
  Subring.closure
    (Set.range (α.hom.app U) ∪ (sectionSubmodule α N U : Set (A.obj.obj U)))

/-- Restriction preserves the generated subrings by naturality of the
structure map and stability of the given submodule. -/
theorem restriction_mem {U V : X.Opensᵒᵖ} (i : U ⟶ V) :
    ∀ x ∈ sectionSubring α N U, A.obj.map i x ∈ sectionSubring α N V := by
  change sectionSubring α N U ≤ (sectionSubring α N V).comap (A.obj.map i).hom
  apply Subring.closure_le.mpr
  intro x hx
  rcases hx with ⟨r, rfl⟩ | hx
  · have hnat : A.obj.map i (α.hom.app U r) = α.hom.app V (X.presheaf.map i r) :=
      (congrArg (fun k : X.presheaf.obj U ⟶ A.obj.obj V => k r)
        (α.hom.naturality i)).symm
    change A.obj.map i (α.hom.app U r) ∈ sectionSubring α N V
    rw [hnat]
    exact Subring.subset_closure (Or.inl ⟨X.presheaf.map i r, rfl⟩)
  · exact Subring.subset_closure (Or.inr (N.map_mem i hx))

/-- The ring presheaf whose sections are generated by the actual submodule. -/
def presheaf : X.Opensᵒᵖ ⥤ CommRingCat.{u} where
  obj U := CommRingCat.of (sectionSubring α N U)
  map {U V} i := CommRingCat.ofHom
    ((A.obj.map i).hom.restrict (sectionSubring α N U) (sectionSubring α N V)
      (restriction_mem α N i))
  map_id U := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    apply Subtype.ext
    exact congrArg (fun k : A.obj.obj U ⟶ A.obj.obj U => k x.val) (A.obj.map_id U)
  map_comp i j := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    apply Subtype.ext
    exact congrArg (fun k => k x.val) (A.obj.map_comp i j)

/-- Inclusion of the generated ring presheaf into the original algebra. -/
def inclusion : presheaf α N ⟶ A.obj where
  app U := CommRingCat.ofHom (sectionSubring α N U).subtype
  naturality {U V} i := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    rfl

/-- The original structure map lands in the generated rings. -/
def structureMap : X.presheaf ⟶ presheaf α N where
  app U := CommRingCat.ofHom
    ((α.hom.app U).hom.codRestrict (sectionSubring α N U)
      (fun r => Subring.subset_closure (Or.inl ⟨r, rfl⟩)))
  naturality {U V} i := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro r
    apply Subtype.ext
    exact congrArg (fun k : X.presheaf.obj U ⟶ A.obj.obj V => k r)
      (α.hom.naturality i)

/-- Inclusion recovers the given structure map exactly. -/
theorem structureMap_inclusion : structureMap α N ≫ inclusion α N = α.hom := by
  apply NatTrans.ext
  funext U
  apply CommRingCat.hom_ext
  apply RingHom.ext
  intro r
  rfl

/-- The generated ring diagram on the actual affine Zariski site. -/
def affinePresheaf : X.AffineZariskiSiteᵒᵖ ⥤ CommRingCat.{u} :=
  (AffineZariskiSite.toOpensFunctor X).op ⋙ presheaf α N

/-- The actual affine structure map used by native relative gluing. -/
def affineStructureMap :
    (AffineZariskiSite.toOpensFunctor X).op ⋙ X.presheaf ⟶ affinePresheaf α N :=
  Functor.whiskerLeft (AffineZariskiSite.toOpensFunctor X).op (structureMap α N)

/-- Under the original coefficient action, the generated section subring
is exactly the ring underlying the usual algebra generated by `N(U)`. -/
theorem sectionSubring_eq_adjoin (U : X.Opensᵒᵖ) :
    let : Algebra (X.presheaf.obj U) (A.obj.obj U) := (α.hom.app U).hom.toAlgebra
    sectionSubring α N U =
      (Algebra.adjoin (X.presheaf.obj U)
        (sectionSubmodule α N U : Set (A.obj.obj U))).toSubring := by
  intro algebra
  exact (Algebra.adjoin_eq_ring_closure
    (R := X.presheaf.obj U) (sectionSubmodule α N U : Set (A.obj.obj U))).symm

end AlgebraicGeometry.Scheme.GeneratedAlgebra
