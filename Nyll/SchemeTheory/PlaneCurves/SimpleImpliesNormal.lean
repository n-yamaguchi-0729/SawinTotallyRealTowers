import Nyll.SchemeTheory.PlaneCurves.PartialDerivatives
import Nyll.SchemeTheory.PlaneCurves.NormalPoint
import Nyll.SchemeTheory.PlaneCurves.NormalImpliesSimple
import Mathlib.RingTheory.DiscreteValuationRing.TFAE
import Mathlib.RingTheory.OrderOfVanishing.Noetherian

/-!
# Simple points of affine plane curves

This file proves the simple-to-normal direction of Fried--Jarden, Lemma 6.2.3.
At a point where one partial derivative is nonzero, the first-order
decomposition of the curve equation eliminates the corresponding translated
coordinate in the point localization.  Thus its maximal ideal is generated by
the other translated coordinate, so the local ring is a discrete valuation
ring and in particular is normal.
-/

noncomputable section

namespace FieldArithmetic
namespace Chapter06
namespace AffinePlaneCurve

open IsLocalRing MvPolynomial

universe u

variable {K : Type u} [Field K]

/--
The canonical commutative-ring structure on a point localization.  The two
coordinate calculations below share this source instead of separately
running synthesis through the quotient and localization abbreviations.
-/
@[reducible]
private noncomputable def pointLocalRingCommRing
    {f : BivariatePolynomial K} (p : RationalPoint f) :
    CommRing (PointLocalRing p) :=
  inferInstance

/--
If the `X`-partial derivative is nonzero at `p`, the maximal ideal of the
point local ring is generated by the image of `y - p_y`.
-/
theorem pointLocalRing_maximalIdeal_eq_span_coordinateY_sub_of_partialAt_zero_ne
    {f : BivariatePolynomial K} (p : RationalPoint f)
    (hpartial : partialAt p 0 ≠ 0) :
    maximalIdeal (PointLocalRing p) =
      Ideal.span
        {algebraMap (CoordinateRing f) (PointLocalRing p)
          (coordinateY f -
            algebraMap K (CoordinateRing f) (p.coords 1))} := by
  let : (pointIdeal p).IsPrime := (pointIdeal_isMaximal p).isPrime
  let : CommRing (PointLocalRing p) := pointLocalRingCommRing p
  obtain ⟨u, v, hdecomp, hu, _⟩ :=
    exists_coordinate_decomposition_with_partialAt p f
  have hf_at_p : polynomialEval p f = 0 := by
    simpa [polynomialEval] using p.isZero
  have hdecomp' :
      f =
        (MvPolynomial.X 0 - MvPolynomial.C (p.coords 0)) * u +
          (MvPolynomial.X 1 - MvPolynomial.C (p.coords 1)) * v := by
    simpa [hf_at_p] using hdecomp
  let π : BivariatePolynomial K →+* CoordinateRing f :=
    Ideal.Quotient.mk (equationIdeal f)
  have hrelation :
      (coordinateX f -
          algebraMap K (CoordinateRing f) (p.coords 0)) * π u +
        (coordinateY f -
          algebraMap K (CoordinateRing f) (p.coords 1)) * π v = 0 := by
    have h := congrArg π hdecomp'
    simpa [π, coordinateX, coordinateY, coordinate] using h.symm
  have hu_eval_ne : polynomialEval p u ≠ 0 := by
    rw [hu]
    exact hpartial
  have hu_not_mem : π u ∉ pointIdeal p := by
    rw [mem_pointIdeal_iff, pointEval_mk]
    simpa [π, polynomialEval] using hu_eval_ne
  have hu_unit :
      IsUnit
        (algebraMap (CoordinateRing f) (PointLocalRing p) (π u)) := by
    apply
      (IsLocalization.AtPrime.isUnit_to_map_iff
        (PointLocalRing p) (pointIdeal p) (π u)).mpr
    exact hu_not_mem
  obtain ⟨z, hz⟩ := isUnit_iff_exists_inv.mp hu_unit
  have hrelation_local :
      algebraMap (CoordinateRing f) (PointLocalRing p)
            (coordinateX f -
              algebraMap K (CoordinateRing f) (p.coords 0)) *
          algebraMap (CoordinateRing f) (PointLocalRing p) (π u) +
        algebraMap (CoordinateRing f) (PointLocalRing p)
            (coordinateY f -
              algebraMap K (CoordinateRing f) (p.coords 1)) *
          algebraMap (CoordinateRing f) (PointLocalRing p) (π v) =
        0 := by
    simpa only [map_add, map_mul, map_zero] using
      congrArg
        (algebraMap (CoordinateRing f) (PointLocalRing p))
        hrelation
  have hx_mem :
      algebraMap (CoordinateRing f) (PointLocalRing p)
          (coordinateX f -
            algebraMap K (CoordinateRing f) (p.coords 0)) ∈
        Ideal.span
          {algebraMap (CoordinateRing f) (PointLocalRing p)
            (coordinateY f -
              algebraMap K (CoordinateRing f) (p.coords 1))} := by
    rw [Ideal.mem_span_singleton']
    refine
      ⟨-z *
          algebraMap (CoordinateRing f) (PointLocalRing p) (π v), ?_⟩
    linear_combination
      (-z) * hrelation_local +
        (algebraMap (CoordinateRing f) (PointLocalRing p)
          (coordinateX f -
            algebraMap K (CoordinateRing f) (p.coords 0))) * hz
  calc
    maximalIdeal (PointLocalRing p) =
        (pointIdeal p).map
          (algebraMap (CoordinateRing f) (PointLocalRing p)) :=
      (Localization.AtPrime.map_eq_maximalIdeal
        (I := pointIdeal p)).symm
    _ = Ideal.span
        {algebraMap (CoordinateRing f) (PointLocalRing p)
          (coordinateY f -
            algebraMap K (CoordinateRing f) (p.coords 1))} := by
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        apply (le_of_eq (pointIdeal_eq_span_coordinate_sub p)).trans
        rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        change
          algebraMap (CoordinateRing f) (PointLocalRing p)
              (coordinate f i -
                algebraMap K (CoordinateRing f) (p.coords i)) ∈
            Ideal.span
              {algebraMap (CoordinateRing f) (PointLocalRing p)
                (coordinateY f -
                  algebraMap K (CoordinateRing f) (p.coords 1))}
        fin_cases i
        · simpa [coordinateX] using hx_mem
        · exact Ideal.mem_span_singleton_self _
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        apply Ideal.mem_map_of_mem
        exact coordinateY_sub_mem_pointIdeal p

/--
If the `Y`-partial derivative is nonzero at `p`, the maximal ideal of the
point local ring is generated by the image of `x - p_x`.
-/
theorem pointLocalRing_maximalIdeal_eq_span_coordinateX_sub_of_partialAt_one_ne
    {f : BivariatePolynomial K} (p : RationalPoint f)
    (hpartial : partialAt p 1 ≠ 0) :
    maximalIdeal (PointLocalRing p) =
      Ideal.span
        {algebraMap (CoordinateRing f) (PointLocalRing p)
          (coordinateX f -
            algebraMap K (CoordinateRing f) (p.coords 0))} := by
  let : (pointIdeal p).IsPrime := (pointIdeal_isMaximal p).isPrime
  let : CommRing (PointLocalRing p) := pointLocalRingCommRing p
  obtain ⟨u, v, hdecomp, _, hv⟩ :=
    exists_coordinate_decomposition_with_partialAt p f
  have hf_at_p : polynomialEval p f = 0 := by
    simpa [polynomialEval] using p.isZero
  have hdecomp' :
      f =
        (MvPolynomial.X 0 - MvPolynomial.C (p.coords 0)) * u +
          (MvPolynomial.X 1 - MvPolynomial.C (p.coords 1)) * v := by
    simpa [hf_at_p] using hdecomp
  let π : BivariatePolynomial K →+* CoordinateRing f :=
    Ideal.Quotient.mk (equationIdeal f)
  have hrelation :
      (coordinateX f -
          algebraMap K (CoordinateRing f) (p.coords 0)) * π u +
        (coordinateY f -
          algebraMap K (CoordinateRing f) (p.coords 1)) * π v = 0 := by
    have h := congrArg π hdecomp'
    simpa [π, coordinateX, coordinateY, coordinate] using h.symm
  have hv_eval_ne : polynomialEval p v ≠ 0 := by
    rw [hv]
    exact hpartial
  have hv_not_mem : π v ∉ pointIdeal p := by
    rw [mem_pointIdeal_iff, pointEval_mk]
    simpa [π, polynomialEval] using hv_eval_ne
  have hv_unit :
      IsUnit
        (algebraMap (CoordinateRing f) (PointLocalRing p) (π v)) := by
    apply
      (IsLocalization.AtPrime.isUnit_to_map_iff
        (PointLocalRing p) (pointIdeal p) (π v)).mpr
    exact hv_not_mem
  obtain ⟨z, hz⟩ := isUnit_iff_exists_inv.mp hv_unit
  have hrelation_local :
      algebraMap (CoordinateRing f) (PointLocalRing p)
            (coordinateX f -
              algebraMap K (CoordinateRing f) (p.coords 0)) *
          algebraMap (CoordinateRing f) (PointLocalRing p) (π u) +
        algebraMap (CoordinateRing f) (PointLocalRing p)
            (coordinateY f -
              algebraMap K (CoordinateRing f) (p.coords 1)) *
          algebraMap (CoordinateRing f) (PointLocalRing p) (π v) =
        0 := by
    simpa only [map_add, map_mul, map_zero] using
      congrArg
        (algebraMap (CoordinateRing f) (PointLocalRing p))
        hrelation
  have hy_mem :
      algebraMap (CoordinateRing f) (PointLocalRing p)
          (coordinateY f -
            algebraMap K (CoordinateRing f) (p.coords 1)) ∈
        Ideal.span
          {algebraMap (CoordinateRing f) (PointLocalRing p)
            (coordinateX f -
              algebraMap K (CoordinateRing f) (p.coords 0))} := by
    rw [Ideal.mem_span_singleton']
    refine
      ⟨-z *
          algebraMap (CoordinateRing f) (PointLocalRing p) (π u), ?_⟩
    linear_combination
      (-z) * hrelation_local +
        (algebraMap (CoordinateRing f) (PointLocalRing p)
          (coordinateY f -
            algebraMap K (CoordinateRing f) (p.coords 1))) * hz
  calc
    maximalIdeal (PointLocalRing p) =
        (pointIdeal p).map
          (algebraMap (CoordinateRing f) (PointLocalRing p)) :=
      (Localization.AtPrime.map_eq_maximalIdeal
        (I := pointIdeal p)).symm
    _ = Ideal.span
        {algebraMap (CoordinateRing f) (PointLocalRing p)
          (coordinateX f -
            algebraMap K (CoordinateRing f) (p.coords 0))} := by
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        apply (le_of_eq (pointIdeal_eq_span_coordinate_sub p)).trans
        rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        change
          algebraMap (CoordinateRing f) (PointLocalRing p)
              (coordinate f i -
                algebraMap K (CoordinateRing f) (p.coords i)) ∈
            Ideal.span
              {algebraMap (CoordinateRing f) (PointLocalRing p)
                (coordinateX f -
                  algebraMap K (CoordinateRing f) (p.coords 0))}
        fin_cases i
        · exact Ideal.mem_span_singleton_self _
        · simpa [coordinateY] using hy_mem
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        apply Ideal.mem_map_of_mem
        exact coordinateX_sub_mem_pointIdeal p

/--
The regularity step used by both coordinate directions.  Once a generator of
the maximal ideal is supplied, the point-localization and Noetherian
instances are produced once here, rather than reconstructed independently in
the two partial-derivative theorems.
-/
private theorem pointLocalRing_isDiscreteValuationRing_of_maximalIdeal_eq_span
    {f : BivariatePolynomial K} (hf : Irreducible f)
    (p : RationalPoint f) (parameter : PointLocalRing p)
    (hspan :
      maximalIdeal (PointLocalRing p) = Ideal.span {parameter}) :
    letI : (pointIdeal p).IsPrime := (pointIdeal_isMaximal p).isPrime
    letI : IsDomain (CoordinateRing f) := coordinateRing_isDomain hf
    letI : IsDomain (PointLocalRing p) :=
      IsLocalization.isDomain_of_atPrime
        (PointLocalRing p) (pointIdeal p)
    IsDiscreteValuationRing (PointLocalRing p) := by
  let : (pointIdeal p).IsPrime := (pointIdeal_isMaximal p).isPrime
  let : IsDomain (CoordinateRing f) := coordinateRing_isDomain hf
  let : IsDomain (PointLocalRing p) :=
    IsLocalization.isDomain_of_atPrime
      (PointLocalRing p) (pointIdeal p)
  let : IsNoetherianRing (CoordinateRing f) := inferInstance
  let : IsNoetherianRing (PointLocalRing p) :=
    IsLocalization.isNoetherianRing (pointIdeal p).primeCompl
      (PointLocalRing p) inferInstance
  have hnotField : ¬ IsField (PointLocalRing p) :=
    IsLocalization.AtPrime.not_isField
      (CoordinateRing f) (pointIdeal_ne_bot hf p) (PointLocalRing p)
  apply
    ((IsDiscreteValuationRing.TFAE
      (PointLocalRing p) hnotField).out 5 1).mp
  exact ⟨parameter, hspan⟩

/--
Nonvanishing of the `X`-partial derivative makes the point local ring a
discrete valuation ring.
-/
theorem pointLocalRing_isDiscreteValuationRing_of_partialAt_zero_ne
    {f : BivariatePolynomial K} (hf : Irreducible f)
    (p : RationalPoint f) (hpartial : partialAt p 0 ≠ 0) :
    letI : (pointIdeal p).IsPrime := (pointIdeal_isMaximal p).isPrime
    letI : IsDomain (CoordinateRing f) := coordinateRing_isDomain hf
    letI : IsDomain (PointLocalRing p) :=
      IsLocalization.isDomain_of_atPrime
        (PointLocalRing p) (pointIdeal p)
    IsDiscreteValuationRing (PointLocalRing p) := by
  apply
    pointLocalRing_isDiscreteValuationRing_of_maximalIdeal_eq_span
      hf p
        (algebraMap (CoordinateRing f) (PointLocalRing p)
          (coordinateY f -
            algebraMap K (CoordinateRing f) (p.coords 1)))
  exact
    pointLocalRing_maximalIdeal_eq_span_coordinateY_sub_of_partialAt_zero_ne
      p hpartial

/--
Nonvanishing of the `Y`-partial derivative makes the point local ring a
discrete valuation ring.
-/
theorem pointLocalRing_isDiscreteValuationRing_of_partialAt_one_ne
    {f : BivariatePolynomial K} (hf : Irreducible f)
    (p : RationalPoint f) (hpartial : partialAt p 1 ≠ 0) :
    letI : (pointIdeal p).IsPrime := (pointIdeal_isMaximal p).isPrime
    letI : IsDomain (CoordinateRing f) := coordinateRing_isDomain hf
    letI : IsDomain (PointLocalRing p) :=
      IsLocalization.isDomain_of_atPrime
        (PointLocalRing p) (pointIdeal p)
    IsDiscreteValuationRing (PointLocalRing p) := by
  apply
    pointLocalRing_isDiscreteValuationRing_of_maximalIdeal_eq_span
      hf p
        (algebraMap (CoordinateRing f) (PointLocalRing p)
          (coordinateX f -
            algebraMap K (CoordinateRing f) (p.coords 0)))
  exact
    pointLocalRing_maximalIdeal_eq_span_coordinateX_sub_of_partialAt_one_ne
      p hpartial

/--
In mathlib's multiplicative normalization, the canonical valuation sends the
local parameter `y - p_y` to `exp (-1)`.  Equivalently, its additive order is
one, as in the final assertion of Fried--Jarden, Lemma 6.2.3.
-/
theorem pointLocalRing_canonicalValuation_coordinateY_sub_eq_exp_neg_one
    {f : BivariatePolynomial K} (hf : Irreducible f)
    (p : RationalPoint f) (hpartial : partialAt p 0 ≠ 0) :
    letI : (pointIdeal p).IsPrime := (pointIdeal_isMaximal p).isPrime
    letI : IsDomain (CoordinateRing f) := coordinateRing_isDomain hf
    letI : IsDomain (PointLocalRing p) :=
      IsLocalization.isDomain_of_atPrime
        (PointLocalRing p) (pointIdeal p)
    letI : IsDiscreteValuationRing (PointLocalRing p) :=
      pointLocalRing_isDiscreteValuationRing_of_partialAt_zero_ne
        hf p hpartial
    (IsDiscreteValuationRing.maximalIdeal
        (PointLocalRing p)).valuation (CoordinateFunctionField f)
      (algebraMap (PointLocalRing p) (CoordinateFunctionField f)
        (algebraMap (CoordinateRing f) (PointLocalRing p)
          (coordinateY f -
            algebraMap K (CoordinateRing f) (p.coords 1)))) =
      WithZero.exp (-1 : ℤ) := by
  let : (pointIdeal p).IsPrime := (pointIdeal_isMaximal p).isPrime
  let : IsDomain (CoordinateRing f) := coordinateRing_isDomain hf
  let : IsDomain (PointLocalRing p) :=
    IsLocalization.isDomain_of_atPrime
      (PointLocalRing p) (pointIdeal p)
  let : IsDiscreteValuationRing (PointLocalRing p) :=
    pointLocalRing_isDiscreteValuationRing_of_partialAt_zero_ne
      hf p hpartial
  let parameter : PointLocalRing p :=
    algebraMap (CoordinateRing f) (PointLocalRing p)
      (coordinateY f -
        algebraMap K (CoordinateRing f) (p.coords 1))
  have hspan :
      maximalIdeal (PointLocalRing p) = Ideal.span {parameter} := by
    exact
      pointLocalRing_maximalIdeal_eq_span_coordinateY_sub_of_partialAt_zero_ne
        p hpartial
  have hparameter_ne : parameter ≠ 0 := by
    intro hzero
    apply IsDiscreteValuationRing.not_a_field (PointLocalRing p)
    simpa [hzero] using hspan
  change
    (IsDiscreteValuationRing.maximalIdeal
        (PointLocalRing p)).valuation (CoordinateFunctionField f)
      (algebraMap (PointLocalRing p) (CoordinateFunctionField f)
        parameter) =
      WithZero.exp (-1 : ℤ)
  rw [IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]
  exact
    (IsDiscreteValuationRing.maximalIdeal
      (PointLocalRing p)).intValuation_singleton
        hparameter_ne (by
          simpa [IsDiscreteValuationRing.maximalIdeal] using hspan)

/--
The additive normalization of the same statement: the order of vanishing of
`y - p_y` is one.
-/
theorem pointLocalRing_ordFrac_coordinateY_sub_eq_exp_one
    {f : BivariatePolynomial K} (hf : Irreducible f)
    (p : RationalPoint f) (hpartial : partialAt p 0 ≠ 0) :
    letI : (pointIdeal p).IsPrime := (pointIdeal_isMaximal p).isPrime
    letI : IsDomain (CoordinateRing f) := coordinateRing_isDomain hf
    letI : IsDomain (PointLocalRing p) :=
      IsLocalization.isDomain_of_atPrime
        (PointLocalRing p) (pointIdeal p)
    letI : IsDiscreteValuationRing (PointLocalRing p) :=
      pointLocalRing_isDiscreteValuationRing_of_partialAt_zero_ne
        hf p hpartial
    Ring.ordFrac (PointLocalRing p)
      (algebraMap (PointLocalRing p) (CoordinateFunctionField f)
        (algebraMap (CoordinateRing f) (PointLocalRing p)
          (coordinateY f -
            algebraMap K (CoordinateRing f) (p.coords 1)))) =
      WithZero.exp (1 : ℤ) := by
  let : (pointIdeal p).IsPrime := (pointIdeal_isMaximal p).isPrime
  let : IsDomain (CoordinateRing f) := coordinateRing_isDomain hf
  let : IsDomain (PointLocalRing p) :=
    IsLocalization.isDomain_of_atPrime
      (PointLocalRing p) (pointIdeal p)
  let : IsDiscreteValuationRing (PointLocalRing p) :=
    pointLocalRing_isDiscreteValuationRing_of_partialAt_zero_ne
      hf p hpartial
  let parameter : PointLocalRing p :=
    algebraMap (CoordinateRing f) (PointLocalRing p)
      (coordinateY f -
        algebraMap K (CoordinateRing f) (p.coords 1))
  have hspan :
      maximalIdeal (PointLocalRing p) = Ideal.span {parameter} := by
    exact
      pointLocalRing_maximalIdeal_eq_span_coordinateY_sub_of_partialAt_zero_ne
        p hpartial
  have hirreducible : Irreducible parameter :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer parameter).mpr
      hspan
  change
    Ring.ordFrac (PointLocalRing p)
      (algebraMap (PointLocalRing p) (CoordinateFunctionField f)
        parameter) =
      WithZero.exp (1 : ℤ)
  exact Ring.ordFrac_irreducible hirreducible

/--
A point-local DVR is normal.  This is the single bridge which installs the
canonical point-localization domain and regularity instances before asking
for integral closedness.
-/
private theorem isNormalAt_of_pointLocalRing_isDiscreteValuationRing
    {f : BivariatePolynomial K} (hf : Irreducible f)
    (p : RationalPoint f)
    (hDVR :
      letI : (pointIdeal p).IsPrime := (pointIdeal_isMaximal p).isPrime
      letI : IsDomain (CoordinateRing f) := coordinateRing_isDomain hf
      letI : IsDomain (PointLocalRing p) :=
        IsLocalization.isDomain_of_atPrime
          (PointLocalRing p) (pointIdeal p)
      IsDiscreteValuationRing (PointLocalRing p)) :
    IsNormalAt p := by
  let : (pointIdeal p).IsPrime := (pointIdeal_isMaximal p).isPrime
  let : IsDomain (CoordinateRing f) := coordinateRing_isDomain hf
  let : IsDomain (PointLocalRing p) :=
    IsLocalization.isDomain_of_atPrime
      (PointLocalRing p) (pointIdeal p)
  let : IsDiscreteValuationRing (PointLocalRing p) := hDVR
  change IsIntegrallyClosed (PointLocalRing p)
  infer_instance

/-- A nonzero `X`-partial derivative makes the point normal. -/
theorem isNormalAt_of_partialAt_zero_ne
    {f : BivariatePolynomial K} (hf : Irreducible f)
    (p : RationalPoint f) (hpartial : partialAt p 0 ≠ 0) :
    IsNormalAt p := by
  apply isNormalAt_of_pointLocalRing_isDiscreteValuationRing hf p
  exact
    pointLocalRing_isDiscreteValuationRing_of_partialAt_zero_ne
      hf p hpartial

/-- A nonzero `Y`-partial derivative makes the point normal. -/
theorem isNormalAt_of_partialAt_one_ne
    {f : BivariatePolynomial K} (hf : Irreducible f)
    (p : RationalPoint f) (hpartial : partialAt p 1 ≠ 0) :
    IsNormalAt p := by
  apply isNormalAt_of_pointLocalRing_isDiscreteValuationRing hf p
  exact
    pointLocalRing_isDiscreteValuationRing_of_partialAt_one_ne
      hf p hpartial

/--
Fried--Jarden, Lemma 6.2.3, simple-to-normal direction: every simple rational
point of an irreducible affine plane curve is normal.
-/
theorem isNormalAt_of_isSimple
    {f : BivariatePolynomial K} (hf : Irreducible f)
    (p : RationalPoint f) (hsimple : IsSimple p) :
    IsNormalAt p := by
  obtain ⟨i, hi⟩ := hsimple
  fin_cases i
  · exact isNormalAt_of_partialAt_zero_ne hf p hi
  · exact isNormalAt_of_partialAt_one_ne hf p hi

/--
Fried--Jarden, Lemma 6.2.3: a rational point of an irreducible affine plane
curve is normal if and only if it is simple.
-/
theorem isNormalAt_iff_isSimple
    {f : BivariatePolynomial K} (hf : Irreducible f)
    (p : RationalPoint f) :
    IsNormalAt p ↔ IsSimple p :=
  ⟨isSimple_of_isNormalAt hf p, isNormalAt_of_isSimple hf p⟩

