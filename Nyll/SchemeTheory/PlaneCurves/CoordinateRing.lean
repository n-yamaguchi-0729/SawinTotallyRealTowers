import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Polynomial.UniqueFactorization
import Mathlib.Tactic.Ring

/-!
# Affine plane curves and their rational points

This file supplies the affine-coordinate-ring foundations used in
Fried--Jarden, Section 6.2.  A bivariate equation `f` defines the quotient of
`K[X, Y]` by the principal ideal `(f)`.  A `K`-rational zero of `f` gives an
evaluation map from this quotient to `K`; its kernel is the corresponding
maximal ideal.
-/

noncomputable section

namespace FieldArithmetic
namespace Chapter06
namespace AffinePlaneCurve

open Function MvPolynomial

universe u

/-- Bivariate polynomials, with coordinates indexed by `0` and `1`. -/
abbrev BivariatePolynomial (K : Type u) [CommSemiring K] :=
  MvPolynomial (Fin 2) K

variable {K : Type u} [Field K]

/-- The principal ideal generated by an affine plane-curve equation. -/
def equationIdeal (f : BivariatePolynomial K) :
    Ideal (BivariatePolynomial K) :=
  Ideal.span {f}

/-- The affine coordinate ring `K[X, Y] / (f)`. -/
abbrev CoordinateRing (f : BivariatePolynomial K) :=
  BivariatePolynomial K ⧸ equationIdeal f

/-- The image of a polynomial variable in the affine coordinate ring. -/
def coordinate (f : BivariatePolynomial K) (i : Fin 2) : CoordinateRing f :=
  Ideal.Quotient.mk (equationIdeal f) (MvPolynomial.X i)

/-- The image of the first polynomial variable in the affine coordinate ring. -/
def coordinateX (f : BivariatePolynomial K) : CoordinateRing f :=
  coordinate f 0

/-- The image of the second polynomial variable in the affine coordinate ring. -/
def coordinateY (f : BivariatePolynomial K) : CoordinateRing f :=
  coordinate f 1

@[simp]
theorem quotient_mk_equation
    (f : BivariatePolynomial K) :
    Ideal.Quotient.mk (equationIdeal f) f = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span (Set.mem_singleton f)

@[simp]
theorem quotient_mk_C
    (f : BivariatePolynomial K) (a : K) :
    Ideal.Quotient.mk (equationIdeal f) (MvPolynomial.C a) =
      algebraMap K (CoordinateRing f) a := by
  simpa only [← MvPolynomial.algebraMap_eq] using
    (Ideal.Quotient.mk_algebraMap
      (R₁ := K) (equationIdeal f) a)

/--
A `K`-rational point of the affine equation `f`: an actual pair of
coordinates, indexed by `Fin 2`, at which `f` vanishes.
-/
structure RationalPoint (f : BivariatePolynomial K) where
  /-- The two coordinates of the rational point. -/
  coords : Fin 2 → K
  /-- The defining polynomial vanishes at these coordinates. -/
  isZero : MvPolynomial.aeval coords f = 0

/-- Evaluation of bivariate polynomials at a rational point. -/
def polynomialEval {f : BivariatePolynomial K} (p : RationalPoint f) :
    BivariatePolynomial K →ₐ[K] K :=
  MvPolynomial.aeval p.coords

@[simp]
theorem polynomialEval_X
    {f : BivariatePolynomial K} (p : RationalPoint f) (i : Fin 2) :
    polynomialEval p (MvPolynomial.X i) = p.coords i := by
  simp [polynomialEval]

theorem polynomialEval_surjective
    {f : BivariatePolynomial K} (p : RationalPoint f) :
    Function.Surjective (polynomialEval p) := by
  intro a
  refine ⟨MvPolynomial.C a, ?_⟩
  simp [polynomialEval]

theorem polynomialEval_ker_isMaximal
    {f : BivariatePolynomial K} (p : RationalPoint f) :
    (RingHom.ker (polynomialEval p).toRingHom).IsMaximal :=
  RingHom.ker_isMaximal_of_surjective
    (polynomialEval p) (polynomialEval_surjective p)

/--
The kernel of evaluation is generated by the two translated coordinates
`X i - pᵢ`.  The proof is polynomial induction and does not use a
Nullstellensatz.
-/
theorem polynomialEval_ker_eq_span_coordinate_sub
    {f : BivariatePolynomial K} (p : RationalPoint f) :
    RingHom.ker (polynomialEval p).toRingHom =
      Ideal.span
        (Set.range fun i : Fin 2 =>
          MvPolynomial.X i - MvPolynomial.C (p.coords i)) := by
  let I : Ideal (BivariatePolynomial K) :=
    Ideal.span
      (Set.range fun i : Fin 2 =>
        MvPolynomial.X i - MvPolynomial.C (p.coords i))
  change RingHom.ker (polynomialEval p).toRingHom = I
  apply le_antisymm
  · intro g hg
    have hdiff :
        g - MvPolynomial.C (polynomialEval p g) ∈ I := by
      clear hg
      induction g using MvPolynomial.induction_on with
      | C a =>
          simp [polynomialEval]
      | add g h hg hh =>
          have hadd := I.add_mem hg hh
          convert hadd using 1
          simp only [map_add]
          ring
      | mul_X g i hg =>
          have hgenerator :
              MvPolynomial.X i -
                  MvPolynomial.C (p.coords i) ∈ I := by
            apply Ideal.subset_span
            exact Set.mem_range_self i
          have hmul :=
            I.add_mem
              (I.mul_mem_left (MvPolynomial.X i) hg)
              (I.mul_mem_left
                (MvPolynomial.C (polynomialEval p g)) hgenerator)
          convert hmul using 1
          simp only [map_mul, polynomialEval_X]
          ring
    rw [RingHom.mem_ker] at hg
    change polynomialEval p g = 0 at hg
    rw [hg] at hdiff
    simpa using hdiff
  · rw [Ideal.span_le]
    rintro g ⟨i, rfl⟩
    change
      MvPolynomial.X i - MvPolynomial.C (p.coords i) ∈
        RingHom.ker (polynomialEval p).toRingHom
    rw [RingHom.mem_ker]
    simp [polynomialEval]

/--
The curve equation ideal lies in the kernel of evaluation at a rational
point.  This is the exact input needed to descend evaluation to the quotient.
-/
theorem equationIdeal_le_polynomialEval_ker
    {f : BivariatePolynomial K} (p : RationalPoint f) :
    equationIdeal f ≤ RingHom.ker (polynomialEval p).toRingHom := by
  rw [equationIdeal, Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
  exact p.isZero

/-- Evaluation at a rational point, descended to the affine coordinate ring. -/
def pointEval {f : BivariatePolynomial K} (p : RationalPoint f) :
    CoordinateRing f →ₐ[K] K :=
  Ideal.Quotient.liftₐ
    (equationIdeal f) (polynomialEval p)
    (equationIdeal_le_polynomialEval_ker p)

@[simp]
theorem pointEval_mk
    {f : BivariatePolynomial K} (p : RationalPoint f)
    (g : BivariatePolynomial K) :
    pointEval p (Ideal.Quotient.mk (equationIdeal f) g) =
      MvPolynomial.aeval p.coords g := by
  simp [pointEval, polynomialEval]

@[simp]
theorem pointEval_coordinateX
    {f : BivariatePolynomial K} (p : RationalPoint f) :
    pointEval p (coordinateX f) = p.coords 0 := by
  simp [coordinateX, coordinate]

@[simp]
theorem pointEval_coordinateY
    {f : BivariatePolynomial K} (p : RationalPoint f) :
    pointEval p (coordinateY f) = p.coords 1 := by
  simp [coordinateY, coordinate]

theorem pointEval_surjective
    {f : BivariatePolynomial K} (p : RationalPoint f) :
    Function.Surjective (pointEval p) := by
  intro a
  refine ⟨algebraMap K (CoordinateRing f) a, ?_⟩
  exact (pointEval p).commutes a

/-- The maximal ideal of the affine coordinate ring associated to `p`. -/
def pointIdeal {f : BivariatePolynomial K} (p : RationalPoint f) :
    Ideal (CoordinateRing f) :=
  RingHom.ker (pointEval p).toRingHom

@[simp]
theorem mem_pointIdeal_iff
    {f : BivariatePolynomial K} (p : RationalPoint f)
    (z : CoordinateRing f) :
    z ∈ pointIdeal p ↔ pointEval p z = 0 := by
  rfl

/--
The point ideal is the image in the coordinate ring of the polynomial
evaluation kernel.
-/
theorem pointIdeal_eq_map_polynomialEval_ker
    {f : BivariatePolynomial K} (p : RationalPoint f) :
    pointIdeal p =
      (RingHom.ker (polynomialEval p).toRingHom).map
        (Ideal.Quotient.mk (equationIdeal f)) := by
  change
    RingHom.ker
        (Ideal.Quotient.lift
          (equationIdeal f) (polynomialEval p).toRingHom
          (equationIdeal_le_polynomialEval_ker p)) =
      (RingHom.ker (polynomialEval p).toRingHom).map
        (Ideal.Quotient.mk (equationIdeal f))
  exact
    Ideal.ker_quotient_lift
      (I := equationIdeal f)
      (polynomialEval p).toRingHom
      (equationIdeal_le_polynomialEval_ker p)

/--
Inside the affine coordinate ring, the point ideal is generated by the two
coordinate differences `x - p₀` and `y - p₁`.
-/
theorem pointIdeal_eq_span_coordinate_sub
    {f : BivariatePolynomial K} (p : RationalPoint f) :
    pointIdeal p =
      Ideal.span
        (Set.range fun i : Fin 2 =>
          coordinate f i -
            algebraMap K (CoordinateRing f) (p.coords i)) := by
  rw [pointIdeal_eq_map_polynomialEval_ker,
    polynomialEval_ker_eq_span_coordinate_sub,
    Ideal.map_span]
  apply congrArg Ideal.span
  ext z
  constructor
  · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
    exact ⟨i, by simp [coordinate]⟩
  · rintro ⟨i, rfl⟩
    refine
      ⟨MvPolynomial.X i - MvPolynomial.C (p.coords i),
        ⟨i, rfl⟩, ?_⟩
    simp [coordinate]

theorem pointIdeal_isMaximal
    {f : BivariatePolynomial K} (p : RationalPoint f) :
    (pointIdeal p).IsMaximal := by
  exact
    RingHom.ker_isMaximal_of_surjective
      (pointEval p) (pointEval_surjective p)

theorem coordinateX_sub_mem_pointIdeal
    {f : BivariatePolynomial K} (p : RationalPoint f) :
    coordinateX f -
        algebraMap K (CoordinateRing f) (p.coords 0) ∈
      pointIdeal p := by
  rw [mem_pointIdeal_iff]
  simp

theorem coordinateY_sub_mem_pointIdeal
    {f : BivariatePolynomial K} (p : RationalPoint f) :
    coordinateY f -
        algebraMap K (CoordinateRing f) (p.coords 1) ∈
      pointIdeal p := by
  rw [mem_pointIdeal_iff]
  simp

/-- The residue algebra at a `K`-rational point is canonically `K`. -/
noncomputable def pointResidueEquiv
    {f : BivariatePolynomial K} (p : RationalPoint f) :
    (CoordinateRing f ⧸ pointIdeal p) ≃ₐ[K] K := by
  change
    (CoordinateRing f ⧸ RingHom.ker (pointEval p).toRingHom) ≃ₐ[K] K
  exact
    Ideal.quotientKerAlgEquivOfSurjective
      (pointEval_surjective p)

/--
Irreducibility of the equation produces primality of its principal ideal.
No domain conclusion is assumed as extra data.
-/
theorem equationIdeal_isPrime
    {f : BivariatePolynomial K} (hf : Irreducible f) :
    (equationIdeal f).IsPrime := by
  apply Ideal.isPrime_span_singleton_of_prime
  exact UniqueFactorizationMonoid.irreducible_iff_prime.mp hf

/--
The coordinate ring of an irreducible affine plane equation is a domain.
This is derived from polynomial irreducibility via unique factorization.
-/
theorem coordinateRing_isDomain
    {f : BivariatePolynomial K} (hf : Irreducible f) :
    IsDomain (CoordinateRing f) := by
  let : (equationIdeal f).IsPrime :=
    equationIdeal_isPrime hf
  infer_instance

end AffinePlaneCurve
end Chapter06
end FieldArithmetic
