import Mathlib.RingTheory.LocalRing.RingHom.Basic
import Mathlib.RingTheory.Localization.AtPrime.Basic

/-!
# Extracting a local factor from a product by localization

For a family of local rings `A`, the inverse image of the maximal ideal of
`A i` under evaluation at `i` is a maximal ideal of the product.  Localization
of the product at this ideal canonically recovers `A i`.

The construction does not require the index type to be finite; in particular,
it applies to the finite products arising from Chinese-remainder decompositions.
-/

noncomputable section

namespace EtaleFundamentalGroups

universe uι uA

variable {ι : Type uι} (A : ι → Type uA) [∀ j, CommRing (A j)]
variable (i : ι)

/-- The prime of a product selected by the maximal ideal in coordinate `i`. -/
abbrev productCoordinatePrime [∀ j, IsLocalRing (A j)] : Ideal (∀ j, A j) :=
  (IsLocalRing.maximalIdeal (A i)).comap (Pi.evalRingHom A i)

instance [∀ j, IsLocalRing (A j)] : (productCoordinatePrime A i).IsPrime := by
  unfold productCoordinatePrime
  infer_instance

instance [∀ j, IsLocalRing (A j)] : (productCoordinatePrime A i).IsMaximal :=
  (IsLocalRing.maximalIdeal.isMaximal (A i)).comap_piEvalRingHom

@[simp]
theorem mem_productCoordinatePrime [∀ j, IsLocalRing (A j)] (x : ∀ j, A j) :
    x ∈ productCoordinatePrime A i ↔ x i ∈ IsLocalRing.maximalIdeal (A i) :=
  Iff.rfl

/-- The kernel of the coordinate map is generated by the complementary
idempotent. -/
theorem ker_productCoordinateEval [DecidableEq ι] :
    RingHom.ker (Pi.evalRingHom A i) =
      Ideal.span ({1 - Pi.single i 1} : Set (∀ j, A j)) := by
  classical
  exact RingHom.ker_evalRingHom A i

/-- The canonical algebra structure on a selected coordinate of a product. -/
noncomputable instance productCoordinateAlgebra : Algebra (∀ j, A j) (A i) :=
  (Pi.evalRingHom A i).toAlgebra

@[simp]
theorem productCoordinate_algebraMap_apply (x : ∀ j, A j) :
    algebraMap (∀ j, A j) (A i) x = x i :=
  rfl

private noncomputable def productAtPrimeToFactorAtPrimeRingEquiv
    [∀ j, IsLocalRing (A j)] :
    Localization.AtPrime (productCoordinatePrime A i) ≃+*
      Localization.AtPrime (IsLocalRing.maximalIdeal (A i)) :=
  RingEquiv.ofBijective
    (Localization.AtPrime.mapPiEvalRingHom (IsLocalRing.maximalIdeal (A i)))
    (Localization.AtPrime.mapPiEvalRingHom_bijective
      (IsLocalRing.maximalIdeal (A i)))

private noncomputable def factorAtMaximalAlgEquiv [∀ j, IsLocalRing (A j)] :
    A i ≃ₐ[A i] Localization.AtPrime (IsLocalRing.maximalIdeal (A i)) :=
  IsLocalization.atUnits (A i) (IsLocalRing.maximalIdeal (A i)).primeCompl
    (fun x ↦ by simpa using! fun a ↦ a)

/-- Localization at the maximal ideal selected by coordinate `i` canonically
recovers that local-ring factor. -/
noncomputable def productCoordinateAtPrimeRingEquiv [∀ j, IsLocalRing (A j)] :
    Localization.AtPrime (productCoordinatePrime A i) ≃+* A i :=
  (productAtPrimeToFactorAtPrimeRingEquiv A i).trans
    (factorAtMaximalAlgEquiv A i).symm.toRingEquiv

/-- The canonical equivalence with the selected factor, as an algebra over the
whole product via coordinate evaluation. -/
noncomputable def productCoordinateAtPrimeAlgEquiv [∀ j, IsLocalRing (A j)] :
    Localization.AtPrime (productCoordinatePrime A i) ≃ₐ[(∀ j, A j)] A i :=
  AlgEquiv.ofRingEquiv (f := productCoordinateAtPrimeRingEquiv A i) (fun x ↦ by
    change (factorAtMaximalAlgEquiv A i).symm
        (Localization.AtPrime.mapPiEvalRingHom (IsLocalRing.maximalIdeal (A i))
          (algebraMap (∀ j, A j)
            (Localization.AtPrime (productCoordinatePrime A i)) x)) = x i
    rw [Localization.AtPrime.mapPiEvalRingHom_algebraMap_apply]
    exact (factorAtMaximalAlgEquiv A i).symm.commutes (x i))

/-- Coordinate evaluation exhibits the selected local factor itself as the
localization of the product at the complement of `productCoordinatePrime`. -/
noncomputable instance productCoordinate_isLocalization [∀ j, IsLocalRing (A j)] :
    IsLocalization (productCoordinatePrime A i).primeCompl (A i) :=
  IsLocalization.isLocalization_of_algEquiv
    (productCoordinatePrime A i).primeCompl
    (productCoordinateAtPrimeAlgEquiv A i)

@[simp]
theorem productCoordinateAtPrimeAlgEquiv_algebraMap_apply
    [∀ j, IsLocalRing (A j)] (x : ∀ j, A j) :
    productCoordinateAtPrimeAlgEquiv A i
        (algebraMap (∀ j, A j)
          (Localization.AtPrime (productCoordinatePrime A i)) x) = x i := by
  exact (productCoordinateAtPrimeAlgEquiv A i).commutes x

@[simp]
theorem productCoordinateAtPrimeRingEquiv_map_maximalIdeal
    [∀ j, IsLocalRing (A j)] :
    (IsLocalRing.maximalIdeal
        (Localization.AtPrime (productCoordinatePrime A i))).map
        (productCoordinateAtPrimeRingEquiv A i) =
      IsLocalRing.maximalIdeal (A i) :=
  IsLocalRing.map_ringEquiv_maximalIdeal (productCoordinateAtPrimeRingEquiv A i)

section RingEquivTransport

universe uU

variable {U : Type uU} [CommRing U]

/-- The coordinate prime pulled back across a ring equivalence with a product. -/
abbrev ringEquivProductCoordinatePrime [∀ j, IsLocalRing (A j)]
    (e : U ≃+* (∀ j, A j)) : Ideal U :=
  (productCoordinatePrime A i).comap e.toRingHom

/-- The selected factor as an algebra over a ring identified with the whole
product. -/
@[reducible]
noncomputable def ringEquivProductCoordinateAlgebra
    (e : U ≃+* (∀ j, A j)) : Algebra U (A i) :=
  ((Pi.evalRingHom A i).comp e.toRingHom).toAlgebra

@[simp]
theorem ringEquivProductCoordinate_algebraMap_apply
    (e : U ≃+* (∀ j, A j)) (x : U) :
    letI : Algebra U (A i) := ringEquivProductCoordinateAlgebra A i e
    algebraMap U (A i) x = e x i :=
  rfl

universe uR

variable {R : Type uR} [CommRing R] [Algebra R U]

/-- The base-ring algebra on a selected coordinate obtained through the
pulled-back product presentation. -/
@[reducible]
noncomputable def ringEquivProductCoordinateBaseAlgebra
    (e : U ≃+* (∀ j, A j)) : Algebra R (A i) :=
  (((Pi.evalRingHom A i).comp e.toRingHom).comp
    (algebraMap R U)).toAlgebra

theorem ringEquivProductCoordinate_isScalarTower
    (e : U ≃+* (∀ j, A j)) :
    letI : Algebra U (A i) := ringEquivProductCoordinateAlgebra A i e
    letI : Algebra R (A i) :=
      ringEquivProductCoordinateBaseAlgebra (R := R) A i e
    IsScalarTower R U (A i) := by
  let : Algebra U (A i) := ringEquivProductCoordinateAlgebra A i e
  let : Algebra R (A i) :=
    ringEquivProductCoordinateBaseAlgebra (R := R) A i e
  exact IsScalarTower.of_algebraMap_eq fun _ => rfl

private theorem map_symm_primeCompl_eq
    [∀ j, IsLocalRing (A j)] (e : U ≃+* (∀ j, A j)) :
    Submonoid.map e.symm.toMonoidHom
        (productCoordinatePrime A i).primeCompl =
      (ringEquivProductCoordinatePrime A i e).primeCompl := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    change y ∉ productCoordinatePrime A i at hy
    change e (e.symm y) ∉ productCoordinatePrime A i
    simpa only [e.apply_symm_apply] using hy
  · intro hx
    change e x ∉ productCoordinatePrime A i at hx
    refine ⟨e x, ?_, e.symm_apply_apply x⟩
    exact hx

/-- A local factor of a product remains the corresponding localization after
pulling the product presentation back along a ring equivalence. -/
theorem ringEquivProductCoordinate_isLocalization
    [∀ j, IsLocalRing (A j)] (e : U ≃+* (∀ j, A j)) :
    letI : Algebra U (A i) := ringEquivProductCoordinateAlgebra A i e
    IsLocalization (ringEquivProductCoordinatePrime A i e).primeCompl (A i) := by
  let : Algebra U (A i) := ringEquivProductCoordinateAlgebra A i e
  have hloc : IsLocalization
      (Submonoid.map e.symm.toMonoidHom
        (productCoordinatePrime A i).primeCompl) (A i) := by
    apply IsLocalization.of_surjective
      (productCoordinatePrime A i).primeCompl (A i)
      e.symm.toRingHom e.symm.surjective (RingHom.id (A i))
      Function.bijective_id.surjective
    · ext x
      change x i = e (e.symm x) i
      rw [e.apply_symm_apply]
    · intro x hx
      change x = 0 at hx
      subst x
      exact Ideal.zero_mem _
  rw [map_symm_primeCompl_eq A i e] at hloc
  exact hloc

@[simp]
theorem ringEquivProductCoordinatePrime_map
    [∀ j, IsLocalRing (A j)] (e : U ≃+* (∀ j, A j)) :
    letI : Algebra U (A i) := ringEquivProductCoordinateAlgebra A i e
    (ringEquivProductCoordinatePrime A i e).map
        (algebraMap U (A i)) = IsLocalRing.maximalIdeal (A i) := by
  let : Algebra U (A i) := ringEquivProductCoordinateAlgebra A i e
  change Ideal.map ((Pi.evalRingHom A i).comp e.toRingHom)
      (Ideal.comap e.toRingHom
        (Ideal.comap (Pi.evalRingHom A i)
          (IsLocalRing.maximalIdeal (A i)))) =
    IsLocalRing.maximalIdeal (A i)
  rw [Ideal.comap_comap]
  have hf : Function.Surjective
      ((Pi.evalRingHom A i).comp e.toRingHom) := by
    intro y
    obtain ⟨x, hx⟩ := (Pi.evalRingHom A i).surjective y
    obtain ⟨z, rfl⟩ := e.surjective x
    exact ⟨z, hx⟩
  exact Ideal.map_comap_of_surjective _ hf _

end RingEquivTransport

end EtaleFundamentalGroups
