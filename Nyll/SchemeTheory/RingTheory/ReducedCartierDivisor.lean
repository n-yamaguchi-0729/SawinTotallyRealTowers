/-!
# The generic local rings of a reduced Cartier divisor

Let `f` be a nonzerodivisor in a Noetherian ring `A`, with `A / (f)` reduced.
At every minimal prime over `(f)`, the local ring of `A` is a DVR and the
image of `f` generates its maximal ideal. The ambient ring need not be a
domain, and `(f)` need not be prime.

This supplies the local-ring assertion preceding the Kummer construction
in Stacks Project, Example 58.31.4 (tag `0EYF`):
https://stacks.math.columbia.edu/tag/0EYF
-/

namespace SchemeTheory

universe u

/-- A reduced principal divisor is generated by the same element at each
of its generic points. No Noetherian hypothesis is needed for this equality. -/
theorem maximalIdeal_localizationAtPrime_eq_span_of_reduced_quotient
    {A : Type u} [CommRing A] (f : A)
    [IsReduced (A ⧸ Ideal.span ({f} : Set A))]
    (P : Ideal A) [P.IsPrime]
    (hP : P ∈ (Ideal.span ({f} : Set A)).minimalPrimes) :
    IsLocalRing.maximalIdeal (Localization.AtPrime P) =
      Ideal.span ({algebraMap A (Localization.AtPrime P) f} :
        Set (Localization.AtPrime P)) := by
  let S := Localization.AtPrime P
  let I : Ideal A := Ideal.span ({f} : Set A)
  have hI : I.IsRadical :=
    (Ideal.isRadical_iff_quotient_reduced I).mpr inferInstance
  have hmap : (I.map (algebraMap A S)).radical =
      I.map (algebraMap A S) := by
    rw [← IsLocalization.map_radical P.primeCompl S I, hI.radical]
  calc
    IsLocalRing.maximalIdeal S = P.map (algebraMap A S) :=
      (IsLocalization.AtPrime.map_eq_maximalIdeal P S).symm
    _ = (I.map (algebraMap A S)).radical :=
      (IsLocalization.AtPrime.radical_map_of_mem_minimalPrimes
        (A := S) P I hP).symm
    _ = I.map (algebraMap A S) := hmap
    _ = Ideal.span ({algebraMap A S f} : Set S) := by
      change (Ideal.span ({f} : Set A)).map (algebraMap A S) =
        Ideal.span ({algebraMap A S f} : Set S)
      rw [Ideal.map_span, Set.image_singleton]

/-- The ambient local ring at a generic point of a reduced Cartier divisor
is regular. The quotient by the displayed nonzerodivisor is a field. -/
theorem isRegularLocalRing_localizationAtPrime_of_reduced_quotient
    {A : Type u} [CommRing A] [IsNoetherianRing A]
    (f : A) (hf : f ∈ nonZeroDivisors A)
    [IsReduced (A ⧸ Ideal.span ({f} : Set A))]
    (P : Ideal A) [P.IsPrime]
    (hP : P ∈ (Ideal.span ({f} : Set A)).minimalPrimes) :
    IsRegularLocalRing (Localization.AtPrime P) := by
  let S := Localization.AtPrime P
  let x : S := algebraMap A S f
  have hmax : IsLocalRing.maximalIdeal S = Ideal.span ({x} : Set S) :=
    maximalIdeal_localizationAtPrime_eq_span_of_reduced_quotient f P hP
  have hx : x ∈ IsLocalRing.maximalIdeal S := by
    rw [hmax]
    exact Ideal.mem_span_singleton_self x
  have hxregular : x ∈ nonZeroDivisors S :=
    IsLocalization.nonZeroDivisors_le_comap P.primeCompl S hf
  have hregular : IsSMulRegular S x :=
    IsSMulRegular.of_right_eq_zero_of_smul
      (fun y hy ↦ (mem_nonZeroDivisors_iff_left.mp hxregular) y hy)
  have : (Ideal.span ({x} : Set S)).IsMaximal := by
    rw [← hmax]
    infer_instance
  let : Field (S ⧸ Ideal.span ({x} : Set S)) :=
    Ideal.Quotient.field (Ideal.span ({x} : Set S))
  exact isRegularLocalRing_of_quotient_span_singleton S x hx hregular

/-- At a generic point of a reduced Cartier divisor, the ambient local ring
is a DVR. Its domain structure is produced from the hypotheses and retained
in the statement, rather than supplied as an additional assumption. -/
theorem isDiscreteValuationRing_localizationAtPrime_of_reduced_quotient
    {A : Type u} [CommRing A] [IsNoetherianRing A]
    (f : A) (hf : f ∈ nonZeroDivisors A)
    [IsReduced (A ⧸ Ideal.span ({f} : Set A))]
    (P : Ideal A) [P.IsPrime]
    (hP : P ∈ (Ideal.span ({f} : Set A)).minimalPrimes) :
    let : IsRegularLocalRing (Localization.AtPrime P) :=
      isRegularLocalRing_localizationAtPrime_of_reduced_quotient f hf P hP
    let : IsDomain (Localization.AtPrime P) :=
      IsRegularLocalRing.isDomain (Localization.AtPrime P)
    IsDiscreteValuationRing (Localization.AtPrime P) := by
  intro hregular hdomain
  let S := Localization.AtPrime P
  let x : S := algebraMap A S f
  have hmax : IsLocalRing.maximalIdeal S = Ideal.span ({x} : Set S) :=
    maximalIdeal_localizationAtPrime_eq_span_of_reduced_quotient f P hP
  have hxregular : x ∈ nonZeroDivisors S :=
    IsLocalization.nonZeroDivisors_le_comap P.primeCompl S hf
  have hxne : x ≠ 0 := nonZeroDivisors.ne_zero hxregular
  have hnotfield : ¬ IsField S := by
    intro hfield
    have hzero : IsLocalRing.maximalIdeal S = ⊥ :=
      IsLocalRing.isField_iff_maximalIdeal_eq.mp hfield
    apply hxne
    apply Ideal.mem_bot.mp
    rw [← hzero, hmax]
    exact Ideal.mem_span_singleton_self x
  have hprincipal : (IsLocalRing.maximalIdeal S).IsPrincipal := ⟨x, hmax⟩
  exact ((IsDiscreteValuationRing.TFAE S hnotfield).out 5 1).mp hprincipal

end SchemeTheory
