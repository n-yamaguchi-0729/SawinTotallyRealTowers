import Mathlib.Data.ENat.Lattice
import Mathlib.RingTheory.FiniteType
import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
import Mathlib.RingTheory.Regular.RegularSequence
import Mathlib.Topology.Algebra.Nonarchimedean.AdicTopology
import Mathlib.Topology.Algebra.Ring.Basic

/-!
# Adic local algebras and module depth

A local ring is adic when its maximal ideal defines its topology. Topological finite
generation means that finitely many algebra generators form a dense subalgebra.
Module depth is the supremum of the lengths of weakly regular sequences in the maximal ideal.
-/

open IsLocalRing

namespace IsLocalRing

/-- The topology of the local ring is the adic topology defined by its maximal ideal. -/
class IsAdicTopology (R : Type*) [CommRing R] [IsLocalRing R]
    [TopologicalSpace R] [IsTopologicalRing R] : Prop where
  /-- The maximal ideal defines the given adic topology. -/
  isAdic : IsAdic (maximalIdeal R)

end IsLocalRing

/-- The algebra contains a dense subalgebra generated by finitely many elements over the base
ring. -/
class Algebra.TopologicallyFG (R S : Type*) [CommRing R] [Ring S] [Algebra R S]
    [TopologicalSpace S] [IsTopologicalRing S] : Prop where
  /-- A finite set of elements generates a dense subalgebra. -/
  out : ∃ s : Finset S, Dense (Algebra.adjoin R (s : Set S) : Set S)

instance (priority := 100) {R S : Type*} [CommRing R] [Ring S] [Algebra R S]
    [TopologicalSpace S] [IsTopologicalRing S] [Algebra.FiniteType R S] :
    Algebra.TopologicallyFG R S where
  out := have ⟨s, hs⟩ := Algebra.FiniteType.out (R := R) (A := S); ⟨s, by simp [hs]⟩

open RingTheory in
/-- The supremum of the lengths of weakly regular sequences in the maximal ideal acting on the
module. -/
noncomputable def Module.depth (R M : Type*) [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] : ℕ∞ :=
  sSup { List.length s | (s : List R)
    (_ : Sequence.IsWeaklyRegular M s)
    (_ : ∀ r ∈ s, r ∈ maximalIdeal R) }
