import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.Data.Multiset.Basic
import Mathlib.Algebra.BigOperators.Group.Multiset.Basic
import Mathlib.Data.Finsupp.Multiset
import Mathlib.Data.Finsupp.Weight
import Mathlib.Data.List.Induction
import Mathlib.Algebra.Ring.Parity

/-! # Even monomials are products of quadratic monomials

This supplies the concrete monomial factorization needed by Stacks Project,
Tag 0BTE, including the case of zero variables.
-/

noncomputable section

namespace SchemeTheory.SignPolynomial

open MvPolynomial

variable (k : Type*) [CommRing k] (n : ℕ)

/-- The literal subalgebra generated by the pairwise products of variables. -/
def quadraticSubalgebra : Subalgebra k (MvPolynomial (Fin n) k) :=
  Algebra.adjoin k (Set.range (fun ij : Fin n × Fin n =>
    (X ij.1 : MvPolynomial (Fin n) k) * X ij.2))

theorem quadratic_mem (i j : Fin n) :
    (X i : MvPolynomial (Fin n) k) * X j ∈ quadraticSubalgebra k n :=
  Algebra.subset_adjoin ⟨(i, j), rfl⟩

private theorem list_prod_X_mem (l : List (Fin n)) (hl : Even l.length) :
    (l.map (fun i : Fin n => (X i : MvPolynomial (Fin n) k))).prod ∈
      quadraticSubalgebra k n := by
  revert hl
  induction l using List.twoStepInduction with
  | nil =>
      intro _hl
      exact (quadraticSubalgebra k n).one_mem
  | singleton i =>
      intro hl
      exact False.elim (Nat.not_even_one hl)
  | cons_cons i j l ih _ =>
      intro hl
      have hl' : Even l.length := by
        simpa only [List.length_cons, Nat.succ_eq_add_one, Nat.even_add_one, not_not] using hl
      simpa only [List.map_cons, List.prod_cons, mul_assoc] using
        (quadraticSubalgebra k n).mul_mem (quadratic_mem k n i j) (ih hl')

private theorem list_prod_X_eq_monomial (d : Fin n →₀ ℕ) :
    (d.toMultiset.toList.map (fun i : Fin n => (X i : MvPolynomial (Fin n) k))).prod =
      monomial d 1 := by
  calc
    _ = (d.toMultiset.map (fun i : Fin n => (X i : MvPolynomial (Fin n) k))).prod := by
      rw [← Multiset.prod_coe, ← Multiset.map_coe, Multiset.coe_toList]
    _ = (Finsupp.mapDomain (fun i : Fin n => (X i : MvPolynomial (Fin n) k)) d).prod
        (fun p e => p ^ e) := by
      rw [Finsupp.toMultiset_map, Finsupp.prod_toMultiset]
    _ = d.prod (fun i e => (X i : MvPolynomial (Fin n) k) ^ e) :=
      Finsupp.prod_mapDomain_index (fun p => pow_zero p) (fun p a b => pow_add p a b)
    _ = monomial d 1 := (MvPolynomial.monic_monomial_eq d).symm

/-- Every even-degree monomial belongs to the quadratic-generator subalgebra. -/
theorem monomial_mem_quadraticSubalgebra (d : Fin n →₀ ℕ) (c : k)
    (hd : Even d.degree) : monomial d c ∈ quadraticSubalgebra k n := by
  have hlength : Even d.toMultiset.toList.length := by
    simpa only [Multiset.length_toList, Finsupp.card_toMultiset,
      Finsupp.degree_apply, Finsupp.sum, id_eq] using hd
  have hmonic : (monomial d 1 : MvPolynomial (Fin n) k) ∈ quadraticSubalgebra k n := by
    rw [← list_prod_X_eq_monomial k n d]
    exact list_prod_X_mem k n d.toMultiset.toList hlength
  have hc : (C c : MvPolynomial (Fin n) k) ∈ quadraticSubalgebra k n :=
    (quadraticSubalgebra k n).algebraMap_mem c
  simpa only [MvPolynomial.C_mul_monomial, mul_one] using
    (quadraticSubalgebra k n).mul_mem hc hmonic

end SchemeTheory.SignPolynomial
