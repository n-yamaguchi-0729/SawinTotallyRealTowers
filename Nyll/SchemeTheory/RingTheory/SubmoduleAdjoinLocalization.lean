import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.Algebra.Module.LocalizedModule.Submodule
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.RingTheory.IntegralClosure.Algebra.Basic
import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic

/-!
# Localization of algebras generated by submodules

The algebra generated by a submodule commutes with actual localization.
The comparison is proved inside the given localized ambient algebra, and
the actual restriction of its algebra map is a localization of modules.
An integral ambient algebra makes the algebra generated by a finite
submodule module-finite.

These are algebra-side suppliers for constructing compatible finite
subalgebras on affine charts. No quasicoherent subsheaf extension, global
finite model, or finite refinement of a nonaffine scheme is asserted here.
-/

noncomputable section

universe u v w z

namespace Submodule

section Localization

variable {R : Type u} [CommRing R]
variable (R' : Type v) [CommRing R'] [Algebra R R']
variable {B : Type w} [CommRing B] [Algebra R B]
variable {B' : Type z} [CommRing B'] [Algebra R B'] [Algebra R' B']
variable [IsScalarTower R R' B']
variable (S : Submonoid R) [IsLocalization S R']
variable (f : B →ₐ[R] B') [IsLocalizedModule S f.toLinearMap]

/-- Localizing the module underlying the generated algebra gives exactly
the algebra generated by the localized submodule in the actual target. -/
theorem localized'_adjoin (N : Submodule R B) :
    (Algebra.adjoin R (N : Set B)).toSubmodule.localized' R' S f.toLinearMap =
      (Algebra.adjoin R' (N.localized' R' S f.toLinearMap : Set B')).toSubmodule := by
  let C : Subalgebra R B := Algebra.adjoin R (N : Set B)
  have hC : (C.map f).toSubmodule = span R (f '' (C : Set B)) := by
    rw [Subalgebra.map_toSubmodule]
    change C.toSubmodule.map f.toLinearMap =
      span R (f.toLinearMap '' (C.toSubmodule : Set B))
    rw [← Submodule.map_span, Submodule.span_eq]
  have hspan :
      (Algebra.adjoin R' (C.map f : Set B')).toSubmodule =
        span R' (f '' (C : Set B)) :=
    (C.map f).adjoin_eq_span_of_eq_span R' hC
  rw [Submodule.localized'_eq_span, Submodule.localized'_eq_span, Algebra.adjoin_span]
  change span R' (f '' (C : Set B)) =
    (Algebra.adjoin R' (f '' (N : Set B))).toSubmodule
  rw [← hspan]
  change
    (Algebra.adjoin R' ((Algebra.adjoin R (N : Set B)).map f : Set B')).toSubmodule =
      (Algebra.adjoin R' (f '' (N : Set B))).toSubmodule
  rw [← Algebra.adjoin_image, Algebra.adjoin_adjoin_of_tower]

private theorem adjoinRestriction_mapsTo (N : Submodule R B) :
    ∀ x ∈ Algebra.adjoin R (N : Set B),
      f x ∈ Algebra.adjoin R' (N.localized' R' S f.toLinearMap : Set B') := by
  change Algebra.adjoin R (N : Set B) ≤
    ((Algebra.adjoin R' (N.localized' R' S f.toLinearMap : Set B')).restrictScalars R).comap f
  apply Algebra.adjoin_le
  intro x hx
  exact Algebra.subset_adjoin
    ⟨x, hx, 1, IsLocalizedModule.mk'_one S f.toLinearMap x⟩

/-- The actual ambient algebra map restricted to the algebras generated by
the original submodule and its localization. -/
def adjoinRestriction (N : Submodule R B) :
    Algebra.adjoin R (N : Set B) →ₐ[R]
      Algebra.adjoin R' (N.localized' R' S f.toLinearMap : Set B') :=
  (f.comp (Algebra.adjoin R (N : Set B)).val).codRestrict
    ((Algebra.adjoin R' (N.localized' R' S f.toLinearMap : Set B')).restrictScalars R)
    (fun x => adjoinRestriction_mapsTo R' S f N x.val x.property)

/-- The restricted map evaluates to the original ambient map. -/
theorem adjoinRestriction_apply (N : Submodule R B)
    (x : Algebra.adjoin R (N : Set B)) :
    (adjoinRestriction R' S f N x : B') = f (x : B) :=
  rfl

private theorem isLocalizedModule_restrict_of_localized₀_eq
    (K : Submodule R B) (L : Submodule R B')
    (hf : ∀ x ∈ K, f.toLinearMap x ∈ L)
    (h : K.localized₀ S f.toLinearMap = L) :
    IsLocalizedModule S (f.toLinearMap.restrict hf) := by
  subst L
  exact inferInstanceAs (IsLocalizedModule S (K.toLocalized₀ S f.toLinearMap))

/-- The underlying linear map of the actual algebra restriction is a
localization. The equality of generated algebras is derived above. -/
theorem isLocalizedModule_adjoinRestriction (N : Submodule R B) :
    IsLocalizedModule S (adjoinRestriction R' S f N).toLinearMap := by
  let K : Submodule R B := (Algebra.adjoin R (N : Set B)).toSubmodule
  let L : Submodule R B' :=
    (Algebra.adjoin R' (N.localized' R' S f.toLinearMap : Set B')).toSubmodule.restrictScalars R
  have hf : ∀ x ∈ K, f.toLinearMap x ∈ L := by
    intro x hx
    exact adjoinRestriction_mapsTo R' S f N x hx
  have h :
      K.localized₀ S f.toLinearMap = L :=
    congrArg (Submodule.restrictScalars R) (localized'_adjoin R' S f N)
  change IsLocalizedModule S (f.toLinearMap.restrict hf)
  exact isLocalizedModule_restrict_of_localized₀_eq S f K L hf h

end Localization

section Finiteness

variable {R : Type u} [CommRing R]
variable {B : Type w} [CommRing B] [Algebra R B]

/-- A finitely generated submodule of an integral algebra generates an
actual module-finite subalgebra. -/
theorem finite_adjoin_of_fg [Algebra.IsIntegral R B]
    (N : Submodule R B) (hN : N.FG) :
    Module.Finite R (Algebra.adjoin R (N : Set B)) := by
  obtain ⟨s, hs⟩ := hN
  have h : Algebra.adjoin R (N : Set B) = Algebra.adjoin R (s : Set B) := by
    rw [← hs, Algebra.adjoin_span]
  rw [h]
  exact Algebra.finite_adjoin_of_finite_of_isIntegral s.finite_toSet
    (fun x _ => Algebra.IsIntegral.isIntegral x)

end Finiteness

end Submodule
