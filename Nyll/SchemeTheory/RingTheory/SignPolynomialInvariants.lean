import Mathlib.Algebra.Ring.Parity
import Mathlib.Algebra.BigOperators.Group.Finset.Basic

/-! # Invariants of simultaneous sign change

Over every field of characteristic different from two, the invariants of
simultaneous sign change are exactly the subalgebra generated by `X i * X j`.
There is no restriction on the number of variables in this algebraic statement.
The normalization cover, its generic degree, and its ramification locus are
separate assertions of Stacks Project, Tag 0BTE.
-/

noncomputable section

namespace SchemeTheory.SignPolynomial

open MvPolynomial
open scoped BigOperators

section Coefficients

variable (k : Type*) [CommRing k] (n : ℕ)

/-- Sign change acts on a monomial by the parity of its total exponent. -/
theorem simultaneousNeg_monomial (d : Fin n →₀ ℕ) (c : k) :
    simultaneousNeg k n (monomial d c) = monomial d ((-1 : k) ^ d.degree * c) := by
  have hprod :
      d.prod (fun i e => (-(X i : MvPolynomial (Fin n) k)) ^ e) =
        (-1 : MvPolynomial (Fin n) k) ^ d.degree *
          d.prod (fun i e => (X i : MvPolynomial (Fin n) k) ^ e) := by
    simp only [Finsupp.prod, Finsupp.degree_apply]
    calc
      _ = ∏ i ∈ d.support,
          ((-1 : MvPolynomial (Fin n) k) ^ d i * X i ^ d i) :=
        Finset.prod_congr rfl (fun i _hi => neg_pow (X i) (d i))
      _ = _ := by
        rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum]
  rw [simultaneousNeg_apply, simultaneousNegHom, MvPolynomial.aeval_monomial, hprod,
    MvPolynomial.algebraMap_eq, MvPolynomial.monomial_eq, map_mul, map_pow, map_neg,
    map_one, ← mul_assoc, mul_comm (C c) ((-1 : MvPolynomial (Fin n) k) ^ d.degree)]

/-- The actual coefficient formula for the simultaneous sign involution. -/
theorem coeff_simultaneousNeg (p : MvPolynomial (Fin n) k) (d : Fin n →₀ ℕ) :
    (simultaneousNeg k n p).coeff d = (-1 : k) ^ d.degree * p.coeff d := by
  classical
  induction p using MvPolynomial.induction_on' with
  | monomial e c =>
      rw [simultaneousNeg_monomial]
      by_cases h : e = d
      · subst e
        simp only [MvPolynomial.coeff_monomial, ite_true]
      · simp only [MvPolynomial.coeff_monomial, ite_eq_right h, mul_zero]
  | add p q hp hq =>
      simp only [map_add, AddMonoidAlgebra.coeff_add, Finsupp.add_apply, hp, hq, mul_add]

end Coefficients

section Invariants

variable (k : Type*) [Field k] (n : ℕ) (htwo : (2 : k) ≠ 0)

include htwo

/-- Invariants have precisely even exponents at their nonzero coefficients. -/
theorem mem_fixedSubalgebra_iff_even_support (p : MvPolynomial (Fin n) k) :
    p ∈ fixedSubalgebra k n ↔ ∀ d : Fin n →₀ ℕ, p.coeff d ≠ 0 → Even d.degree := by
  rw [mem_fixedSubalgebra_iff]
  have hneg : (-1 : k) ≠ 1 := by
    intro h
    apply htwo
    calc
      (2 : k) = 1 + 1 := (one_add_one_eq_two : (1 : k) + 1 = 2).symm
      _ = -1 + 1 := congrArg (fun a : k => a + 1) h.symm
      _ = 0 := neg_add_cancel 1
  constructor
  · intro hp d hd
    have hc : (-1 : k) ^ d.degree * p.coeff d = p.coeff d := by
      rw [← coeff_simultaneousNeg k n p d, hp]
    have hs : (-1 : k) ^ d.degree = 1 :=
      mul_right_cancel₀ hd (hc.trans (one_mul (p.coeff d)).symm)
    exact (neg_one_pow_eq_one_iff_even hneg).mp hs
  · intro hp
    apply MvPolynomial.ext
    intro d
    rw [coeff_simultaneousNeg]
    by_cases hd : p.coeff d = 0
    · rw [hd, mul_zero]
    · rw [(hp d hd).neg_one_pow, one_mul]

/-- The literal invariant-ring calculation for the sign quotient in Tag 0BTE. -/
theorem fixedSubalgebra_eq_quadraticSubalgebra :
    fixedSubalgebra k n = quadraticSubalgebra k n := by
  apply le_antisymm
  · intro p hp
    have heven := (mem_fixedSubalgebra_iff_even_support k n htwo p).mp hp
    rw [MvPolynomial.as_sum p]
    apply (quadraticSubalgebra k n).sum_mem
    intro d hd
    exact monomial_mem_quadraticSubalgebra k n d (p.coeff d)
      (heven d (MvPolynomial.mem_support_iff.mp hd))
  · apply Algebra.adjoin_le
    rintro p ⟨⟨i, j⟩, rfl⟩
    change (X i : MvPolynomial (Fin n) k) * X j ∈ fixedSubalgebra k n
    rw [mem_fixedSubalgebra_iff]
    rw [map_mul, simultaneousNeg_X, simultaneousNeg_X, neg_mul_neg]

/-- An action-form endpoint for the original polynomial ring, with no invariant-ring hypothesis. -/
theorem forall_signAction_iff_mem_quadraticSubalgebra (p : MvPolynomial (Fin n) k) :
    (∀ ε : ℤˣ, (signAction k n).smul ε p = p) ↔ p ∈ quadraticSubalgebra k n := by
  rw [← fixedSubalgebra_eq_quadraticSubalgebra k n htwo]
  exact (mem_fixedSubalgebra_iff_forall_signAction k n p).symm

end Invariants

end SchemeTheory.SignPolynomial
