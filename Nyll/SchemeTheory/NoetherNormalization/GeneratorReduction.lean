import Nyll.SchemeTheory.NoetherNormalization.IntegralRelation
import Mathlib.RingTheory.AlgebraicIndependent.Basic
import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic

/-!
# Generator-sensitive linear normalization

This file packages the first induction step in the infinite-field form of
Fried--Jarden, Proposition 6.2.1.  Starting from a nonzero relation among
`n + 1` generators, the triangular change from `LinearNormalization` produces
`n` new tail coordinates.  The old generated algebra is integral over the
algebra generated by those tail coordinates, while the discarded coordinate
is retained explicitly in the generating equality.
-/

noncomputable section

namespace FieldArithmetic
namespace Chapter06

open MvPolynomial

variable {K : Type*} [Field K]

/--
Every transformed tail coordinate belongs to the algebra generated by the
original tuple.
-/
theorem adjoin_linearTailCoordinatesFirst_le
    {A : Type*} [CommRing A] [Algebra K A] {n : ℕ}
    (c : Fin n → K) (x : Fin (n + 1) → A) :
    Algebra.adjoin K (Set.range (linearTailCoordinatesFirst c x)) ≤
      Algebra.adjoin K (Set.range x) := by
  rw [Algebra.adjoin_le_iff]
  rintro y ⟨i, rfl⟩
  exact Subalgebra.sub_mem _
    (Algebra.subset_adjoin ⟨i.succ, rfl⟩)
    (Subalgebra.mul_mem _
      (Subalgebra.algebraMap_mem _ (c i))
      (Algebra.subset_adjoin ⟨0, rfl⟩))

/--
The triangular tail coordinates together with the unchanged first coordinate
generate exactly the same algebra as the original tuple.
-/
theorem adjoin_range_eq_adjoin_linearTailCoordinatesFirst_union
    {A : Type*} [CommRing A] [Algebra K A] {n : ℕ}
    (c : Fin n → K) (x : Fin (n + 1) → A) :
    Algebra.adjoin K (Set.range x) =
      Algebra.adjoin K
        (Set.range (linearTailCoordinatesFirst c x) ∪ {x 0}) := by
  apply le_antisymm
  · rw [Algebra.adjoin_le_iff]
    rintro y ⟨i, rfl⟩
    refine Fin.cases ?_ (fun j => ?_) i
    · exact Algebra.subset_adjoin (Set.mem_union_right _ rfl)
    · have ht :
          linearTailCoordinatesFirst c x j ∈
            Algebra.adjoin K
              (Set.range (linearTailCoordinatesFirst c x) ∪ {x 0}) :=
        Algebra.subset_adjoin (Set.mem_union_left _ ⟨j, rfl⟩)
      have hx₀ :
          x 0 ∈
            Algebra.adjoin K
              (Set.range (linearTailCoordinatesFirst c x) ∪ {x 0}) :=
        Algebra.subset_adjoin (Set.mem_union_right _ rfl)
      rw [show x j.succ =
          linearTailCoordinatesFirst c x j +
            algebraMap K A (c j) * x 0 by
        simp [linearTailCoordinatesFirst]]
      exact Subalgebra.add_mem _ ht
        (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ (c j)) hx₀)
  · rw [Algebra.adjoin_le_iff]
    intro y hy
    rcases hy with hy | hy
    · obtain ⟨i, rfl⟩ := hy
      exact adjoin_linearTailCoordinatesFirst_le c x
        (Algebra.subset_adjoin ⟨i, rfl⟩)
    · have hy : y = x 0 := hy
      subst y
      exact Algebra.subset_adjoin ⟨0, rfl⟩

/--
If the unchanged first coordinate is integral over the transformed tail
algebra, then every element of the algebra generated by the original tuple is
integral over that tail algebra.
-/
theorem isIntegral_of_mem_adjoin_range_of_first
    {A : Type*} [CommRing A] [Algebra K A] {n : ℕ}
    (c : Fin n → K) (x : Fin (n + 1) → A)
    (hfirst :
      IsIntegral
        (Algebra.adjoin K (Set.range (linearTailCoordinatesFirst c x))) (x 0)) :
    ∀ y ∈ Algebra.adjoin K (Set.range x),
      IsIntegral
        (Algebra.adjoin K (Set.range (linearTailCoordinatesFirst c x))) y := by
  let t : Fin n → A := linearTailCoordinatesFirst c x
  let S : Subalgebra K A := Algebra.adjoin K (Set.range t)
  have hfirst' : IsIntegral S (x 0) := hfirst
  intro y hy
  induction hy using Algebra.adjoin_induction with
  | mem z hz =>
      obtain ⟨i, rfl⟩ := hz
      refine Fin.cases hfirst' (fun j => ?_) i
      have ht_mem : t j ∈ S := Algebra.subset_adjoin ⟨j, rfl⟩
      have ht : IsIntegral S (t j) := by
        change IsIntegral S ((algebraMap S A) ⟨t j, ht_mem⟩)
        exact isIntegral_algebraMap
      have hc_mem : algebraMap K A (c j) ∈ S :=
        Subalgebra.algebraMap_mem S (c j)
      have hc : IsIntegral S (algebraMap K A (c j)) := by
        change IsIntegral S ((algebraMap S A) ⟨algebraMap K A (c j), hc_mem⟩)
        exact isIntegral_algebraMap
      rw [show x j.succ = t j + algebraMap K A (c j) * x 0 by
        simp [t, linearTailCoordinatesFirst]]
      exact ht.add (hc.mul hfirst')
  | algebraMap a =>
      have ha_mem : algebraMap K A a ∈ S := Subalgebra.algebraMap_mem S a
      change IsIntegral S ((algebraMap S A) ⟨algebraMap K A a, ha_mem⟩)
      exact isIntegral_algebraMap
  | add a b ha hb hia hib =>
      exact hia.add hib
  | mul a b ha hb hia hib =>
      exact hia.mul hib

/--
An element of an algebra generated by a family is integral over that same
generated algebra.

This elementary fact is the terminal, algebraically-independent branch of the
normalization induction.
-/
theorem isIntegral_of_mem_adjoin_range_self
    {A : Type*} [CommRing A] [Algebra K A] {n : ℕ}
    (x : Fin n → A) :
    ∀ y ∈ Algebra.adjoin K (Set.range x),
      IsIntegral (Algebra.adjoin K (Set.range x)) y := by
  intro y hy
  let S : Subalgebra K A := Algebra.adjoin K (Set.range x)
  have hy' : y ∈ S := hy
  change IsIntegral S ((algebraMap S A) ⟨y, hy'⟩)
  exact isIntegral_algebraMap

/--
One generator-reducing induction step.

The output is an explicit family of `n` triangular tail coordinates.  Their
generated algebra lies in the old generated algebra; the old algebra is
integral over it; and adjoining the retained original coordinate recovers the
old algebra exactly.
-/
theorem exists_generatorReducing_linearTail
    [Infinite K] {A : Type*} [CommRing A] [Algebra K A] {n : ℕ}
    (x : Fin (n + 1) → A) {F : MvPolynomial (Fin (n + 1)) K}
    (hF : F ≠ 0) (hrel : aeval x F = 0) :
    ∃ c : Fin n → K,
      let t : Fin n → A := linearTailCoordinatesFirst c x
      Algebra.adjoin K (Set.range t) ≤ Algebra.adjoin K (Set.range x) ∧
        Algebra.adjoin K (Set.range x) =
          Algebra.adjoin K (Set.range t ∪ {x 0}) ∧
        ∀ y ∈ Algebra.adjoin K (Set.range x),
          IsIntegral (Algebra.adjoin K (Set.range t)) y := by
  obtain ⟨c, hc⟩ := exists_linearCoordinatesFirst_isIntegral x hF hrel
  refine ⟨c, ?_, ?_, ?_⟩
  · exact adjoin_linearTailCoordinatesFirst_le c x
  · exact adjoin_range_eq_adjoin_linearTailCoordinatesFirst_union c x
  · exact isIntegral_of_mem_adjoin_range_of_first c x hc

/--
If the given tuple generates the whole algebra, one triangular step replaces
`n + 1` generators by `n` elements over which the whole algebra is integral.
-/
theorem exists_linearTail_isIntegral_of_adjoin_eq_top
    [Infinite K] {A : Type*} [CommRing A] [Algebra K A] {n : ℕ}
    (x : Fin (n + 1) → A)
    (hx : Algebra.adjoin K (Set.range x) = ⊤)
    {F : MvPolynomial (Fin (n + 1)) K}
    (hF : F ≠ 0) (hrel : aeval x F = 0) :
    ∃ c : Fin n → K,
      Algebra.IsIntegral
        (Algebra.adjoin K (Set.range (linearTailCoordinatesFirst c x))) A := by
  obtain ⟨c, -, -, hint⟩ := exists_generatorReducing_linearTail x hF hrel
  refine ⟨c, ⟨?_⟩⟩
  intro y
  exact hint y (by rw [hx]; trivial)

/--
Linear Noether normalization relative to a prescribed finite generating
family.

The normalizing family is algebraically independent, every one of its members
lies in the `K`-linear span of the original family, and the whole algebra
generated by the original family is integral over the algebra generated by the
normalizing family.  The proof is by induction on the number of generators.
In the dependent branch, `exists_generatorReducing_linearTail` replaces
`n + 1` generators by `n` triangular linear combinations.
-/
theorem exists_linearNormalization_span_integral
    [Infinite K] {A : Type*} [CommRing A] [Nontrivial A] [Algebra K A] :
    ∀ {n : ℕ} (x : Fin n → A),
      ∃ r : ℕ, r ≤ n ∧
        ∃ t : Fin r → A,
          (∀ i, t i ∈ Submodule.span K (Set.range x)) ∧
            AlgebraicIndependent K t ∧
              ∀ y ∈ Algebra.adjoin K (Set.range x),
                IsIntegral (Algebra.adjoin K (Set.range t)) y
  | 0, x => by
      refine ⟨0, le_rfl, x, ?_, algebraicIndependent_empty_type, ?_⟩
      · exact fun i => Fin.elim0 i
      · exact isIntegral_of_mem_adjoin_range_self x
  | n + 1, x => by
      by_cases hx : AlgebraicIndependent K x
      · refine ⟨n + 1, le_rfl, x, ?_, hx, ?_⟩
        · intro i
          exact Submodule.subset_span ⟨i, rfl⟩
        · exact isIntegral_of_mem_adjoin_range_self x
      · have hnotinj :
            ¬ Function.Injective
              (aeval x : MvPolynomial (Fin (n + 1)) K →ₐ[K] A) := by
          intro hinj
          exact hx (algebraicIndependent_iff_injective_aeval.mpr hinj)
        obtain ⟨P, Q, hPQ, hne⟩ := Function.not_injective_iff.mp hnotinj
        let F : MvPolynomial (Fin (n + 1)) K := P - Q
        have hF : F ≠ 0 := sub_ne_zero.mpr hne
        have hrel : aeval x F = 0 := by
          dsimp only [F]
          rw [map_sub, hPQ, sub_self]
        obtain ⟨c, htail_le, -, hstep⟩ :=
          exists_generatorReducing_linearTail x hF hrel
        let tail : Fin n → A := linearTailCoordinatesFirst c x
        obtain ⟨r, hr, t, htspan, htind, htail_integral⟩ :=
          exists_linearNormalization_span_integral tail
        refine ⟨r, hr.trans (Nat.le_succ n), t, ?_, htind, ?_⟩
        · have htail_span :
              ∀ i, tail i ∈ Submodule.span K (Set.range x) := by
            intro i
            have hxi :
                x i.succ ∈ Submodule.span K (Set.range x) :=
              Submodule.subset_span ⟨i.succ, rfl⟩
            have hx₀ :
                x 0 ∈ Submodule.span K (Set.range x) :=
              Submodule.subset_span ⟨0, rfl⟩
            simpa only [tail, linearTailCoordinatesFirst, Algebra.smul_def] using
              Submodule.sub_mem (Submodule.span K (Set.range x)) hxi
                (Submodule.smul_mem (Submodule.span K (Set.range x)) (c i) hx₀)
          have hspan_le :
              Submodule.span K (Set.range tail) ≤
                Submodule.span K (Set.range x) := by
            rw [Submodule.span_le]
            rintro y ⟨i, rfl⟩
            exact htail_span i
          exact fun i => hspan_le (htspan i)
        · let B : Subalgebra K A := Algebra.adjoin K (Set.range t)
          let S : Subalgebra K A := Algebra.adjoin K (Set.range tail)
          have ht_mem_S : ∀ i, t i ∈ S := by
            intro i
            change t i ∈ S.toSubmodule
            exact
              (Submodule.span_le.mpr
                (fun y hy => Algebra.subset_adjoin hy) :
                  Submodule.span K (Set.range tail) ≤ S.toSubmodule) (htspan i)
          have hBS : B ≤ S := by
            rw [Algebra.adjoin_le_iff]
            rintro y ⟨i, rfl⟩
            exact ht_mem_S i
          let : Algebra B S := (Subalgebra.inclusion hBS).toAlgebra
          have : IsScalarTower B S A :=
            IsScalarTower.of_algebraMap_eq fun _ => rfl
          let : Algebra.IsIntegral B S :=
            ⟨fun z =>
              (isIntegral_algebraMap_iff (R := B) (A := S) (B := A)).mp
                (htail_integral z z.property)⟩
          intro y hy
          exact isIntegral_trans y (hstep y hy)

end Chapter06
end FieldArithmetic
