import Nyll.SchemeTheory.NoetherNormalization.LinearChange
import Mathlib.Algebra.Polynomial.Eval.SMul
import Mathlib.RingTheory.IntegralClosure.Algebra.Basic

/-!
# Integral elements from linearized polynomial relations

This file turns the unit-leading-coefficient relation produced by the
triangular change of variables into an actual monic relation over the algebra
generated by the remaining coordinates.
-/

noncomputable section

namespace FieldArithmetic
namespace Chapter06

open MvPolynomial

variable {K : Type*} [Field K] [Infinite K]

/--
If a nonzero polynomial relation holds on a tuple, then after a triangular
linear change the first coordinate is integral over the algebra generated by
the remaining changed coordinates.

This is the monic-relation step in Fried--Jarden, Lemma 22.5.1.
-/
theorem exists_linearCoordinatesFirst_isIntegral
    {A : Type*} [CommRing A] [Algebra K A] {n : ℕ}
    (x : Fin (n + 1) → A) {F : MvPolynomial (Fin (n + 1)) K}
    (hF : F ≠ 0) (hrel : aeval x F = 0) :
    ∃ c : Fin n → K,
      IsIntegral
        (Algebra.adjoin K (Set.range (linearTailCoordinatesFirst c x))) (x 0) := by
  obtain ⟨c, hc⟩ := exists_linearChangeFirst_leadingCoeff_isUnit hF
  refine ⟨c, ?_⟩
  let t : Fin n → A := linearTailCoordinatesFirst c x
  let S : Subalgebra K A := Algebra.adjoin K (Set.range t)
  let p : Polynomial (MvPolynomial (Fin n) K) :=
    finSuccEquiv K n (linearChangeFirst c F)
  have hpunit : IsUnit p.leadingCoeff := hc
  let q : Polynomial (MvPolynomial (Fin n) K) := hpunit.unit⁻¹ • p
  have hqmonic : q.Monic := by
    exact Polynomial.monic_of_isUnit_leadingCoeff_inv_smul hpunit
  have hpzero :
      Polynomial.eval₂ (aeval t).toRingHom (x 0) p = 0 := by
    calc
      Polynomial.eval₂ (aeval t).toRingHom (x 0) p =
          aeval (Fin.cons (x 0) t) (linearChangeFirst c F) :=
        (aeval_finCons_eq_eval₂_finSuccEquiv
          (K := K) (x 0) t (linearChangeFirst c F)).symm
      _ = aeval (linearCoordinatesFirst c x) (linearChangeFirst c F) := by
        rfl
      _ = aeval x F := aeval_linearChangeFirst_linearCoordinates c x F
      _ = 0 := hrel
  have hqzero :
      Polynomial.eval₂ (aeval t).toRingHom (x 0) q = 0 := by
    dsimp only [q]
    rw [Units.smul_def, Polynomial.eval₂_smul]
    exact mul_eq_zero_of_right _ hpzero
  let coeffHom : MvPolynomial (Fin n) K →ₐ[K] S :=
    (aeval t).codRestrict S fun P => by
      change aeval t P ∈ Algebra.adjoin K (Set.range t)
      rw [← aeval_range]
      exact ⟨P, rfl⟩
  let qS : Polynomial S := q.map coeffHom.toRingHom
  change IsIntegral S (x 0)
  refine ⟨qS, ?_, ?_⟩
  · exact hqmonic.map coeffHom.toRingHom
  · change Polynomial.eval₂ (algebraMap S A) (x 0) qS = 0
    dsimp only [qS]
    rw [Polynomial.eval₂_map]
    have hcomp :
        (algebraMap S A).comp coeffHom.toRingHom = (aeval t).toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro a
        change ((coeffHom (C a) : S) : A) = aeval t (C a)
        rfl
      · intro i
        change ((coeffHom (X i) : S) : A) = aeval t (X i)
        rfl
    rw [hcomp]
    exact hqzero

/--
The same triangular change makes every original coordinate integral over the
algebra generated by the changed tail coordinates.

Indeed, each changed tail coordinate already belongs to the base algebra and
the inverse change has the form
`xᵢ = (xᵢ - cᵢ x₀) + cᵢ x₀`.
-/
theorem exists_linearCoordinates_all_isIntegral
    {A : Type*} [CommRing A] [Algebra K A] {n : ℕ}
    (x : Fin (n + 1) → A) {F : MvPolynomial (Fin (n + 1)) K}
    (hF : F ≠ 0) (hrel : aeval x F = 0) :
    ∃ c : Fin n → K, ∀ i : Fin (n + 1),
      IsIntegral
        (Algebra.adjoin K (Set.range (linearTailCoordinatesFirst c x))) (x i) := by
  obtain ⟨c, h₀⟩ := exists_linearCoordinatesFirst_isIntegral x hF hrel
  refine ⟨c, ?_⟩
  let t : Fin n → A := linearTailCoordinatesFirst c x
  let S : Subalgebra K A := Algebra.adjoin K (Set.range t)
  change IsIntegral S (x 0) at h₀
  intro i
  change IsIntegral S (x i)
  refine Fin.cases h₀ ?_ i
  intro j
  have ht_mem : t j ∈ S :=
    Algebra.subset_adjoin ⟨j, rfl⟩
  let tj : S := ⟨t j, ht_mem⟩
  have ht : IsIntegral S (t j) := by
    change IsIntegral S (algebraMap S A tj)
    exact isIntegral_algebraMap
  have hc : IsIntegral S (algebraMap K A (c j)) := by
    rw [IsScalarTower.algebraMap_apply K S A]
    exact isIntegral_algebraMap
  have hsum := ht.add (hc.mul h₀)
  simpa only [t, linearTailCoordinatesFirst, sub_add_cancel] using hsum

end Chapter06
end FieldArithmetic
