import Nyll.SchemeTheory.RingTheory.RegularLocalDimensionOne
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
import Mathlib.RingTheory.RegularLocalRing.Defs

/-!
# Height-one localizations of regular rings

This file supplies the commutative-algebra entry point needed to apply the
existing DVR form of Abhyankar's lemma to a boundary component.

The hypotheses describe geometric source data: a regular affine domain and a
codimension-one prime.  No ramification, unramifiedness, or unit conclusion is
assumed.
-/

namespace EtaleFundamentalGroups

open IsLocalRing

universe u

variable (A : Type u) [CommRing A] [IsDomain A] [IsRegularRing A]

/--
The local ring of a regular affine domain at a height-one prime is a discrete
valuation ring.

This is the bridge from a codimension-one boundary component to the DVR input
of `TameAbhyankar.SGA1`.  Regularity supplies the cotangent-space dimension of
the local ring, while localization identifies its Krull dimension with the
height of the chosen prime.
-/
theorem isDiscreteValuationRing_localizationAtPrime_of_height_eq_one
    (P : Ideal A) [P.IsPrime] (hP : P.height = 1) :
    IsDiscreteValuationRing (Localization.AtPrime P) := by
  apply SchemeTheory.isDiscreteValuationRing_of_isRegularLocalRing_dimension_one
    (Localization.AtPrime P)
  calc
    ringKrullDim (Localization.AtPrime P) = (P.height : WithBot ℕ∞) :=
      IsLocalization.AtPrime.ringKrullDim_eq_height P (Localization.AtPrime P)
    _ = (1 : WithBot ℕ∞) :=
      congrArg (fun n : ℕ∞ ↦ (n : WithBot ℕ∞)) hP

/--
The localization at the principal ideal generated by a prime element of a
regular domain is a discrete valuation ring.

Unlike the height-one formulation above, this is the form consumed by a
one-component boundary chart: primality of the parameter produces both the
prime-ideal instance and the height computation.
-/
theorem isDiscreteValuationRing_localizationAtSpan_of_prime
    (t : A) (ht : Prime t) :
    IsDiscreteValuationRing
      (@Localization.AtPrime A _ (Ideal.span {t})
        (Ideal.isPrime_span_singleton_of_prime ht)) := by
  let : (Ideal.span {t}).IsPrime :=
    Ideal.isPrime_span_singleton_of_prime ht
  apply isDiscreteValuationRing_localizationAtPrime_of_height_eq_one A
  exact Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors
    (mem_nonZeroDivisors_iff_ne_zero.mpr ht.ne_zero) ht.not_isUnit

/-- Localizing a ring at a prime containing `q` does not change the residue
field at `q`. -/
noncomputable def localizationAtPrimeMapResidueFieldRingEquiv
    (P q : Ideal A) [P.IsPrime] [q.IsPrime] (hqP : q ≤ P) :
    letI : (q.map (algebraMap A (Localization.AtPrime P))).IsPrime :=
      Ideal.isPrime_map_of_isLocalizationAtPrime P hqP
    q.ResidueField ≃+*
      (q.map (algebraMap A (Localization.AtPrime P))).ResidueField := by
  let V := Localization.AtPrime P
  let qV := q.map (algebraMap A V)
  have hdisjoint : Disjoint ((P.primeCompl : Submonoid A) : Set A) (q : Set A) :=
    Set.disjoint_compl_left_iff_subset.mpr hqP
  letI : qV.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint P.primeCompl V q
      inferInstance hdisjoint
  have hcomap : q = qV.comap (algebraMap A V) := by
    exact (IsLocalization.under_map_of_isPrime_disjoint
      P.primeCompl V (I := q) inferInstance hdisjoint).symm
  exact RingEquiv.ofBijective
    (Ideal.ResidueField.map q qV (algebraMap A V) hcomap)
    (RingHom.SurjectiveOnStalks.residueFieldMap_bijective
      (RingHom.surjectiveOnStalks_of_isLocalization P.primeCompl V)
      q qV hcomap)

end EtaleFundamentalGroups
