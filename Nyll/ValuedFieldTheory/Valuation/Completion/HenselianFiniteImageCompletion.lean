import Nyll.ValuedFieldTheory.Valuation.Completion.DVFTensorMap
import Nyll.ValuedFieldTheory.Valuation.Completion.HenselianSeparableClosedTensor
import Mathlib.Algebra.Algebra.Subalgebra.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic

/-!
# Completing the same finite intermediate field

The range of the actual tensor map is the field generated by the image of
an algebraic intermediate field. For a finite separable intermediate field
of a Henselian DVF, this identifies its own valuation completion with that
field, preserving every element of the prescribed intermediate field.
-/

noncomputable section


open scoped TensorProduct

namespace ValuationTheory.DiscreteValuationField.DVF

variable {K : Type*} [Field K] (base : DVF K)
  {S E : Type*} [Field S] [Field E] [Algebra K S]
  [Algebra base.valuation.Completion E] [Algebra K E]
  [IsScalarTower K base.valuation.Completion E]

/-- The actual tensor map has exactly the field generated by the prescribed
intermediate-field image as its range. Algebraicity suffices here. -/
theorem separableClosedTensorHom_range_adjoin_image (i : S →ₐ[K] E)
    (F : IntermediateField K S) [Algebra.IsAlgebraic K F] :
    (base.separableClosedTensorHom (i.comp F.val)).range =
      (IntermediateField.adjoin base.valuation.Completion (i '' (F : Set S))).toSubalgebra := by
  have halg : ∀ x ∈ i '' (F : Set S), IsAlgebraic base.valuation.Completion x := by
    rintro x ⟨s, hs, rfl⟩
    have hint : IsIntegral base.valuation.Completion (i s) :=
      (IsIntegral.map (i.comp F.val)
        (Algebra.IsIntegral.isIntegral (R := K) (⟨s, hs⟩ : F))).tower_top
    exact hint.isAlgebraic
  rw [IntermediateField.adjoin_toSubalgebra_of_isAlgebraic halg]
  apply le_antisymm
  · rintro x ⟨z, rfl⟩
    induction z using TensorProduct.inductionOn with
    | tmul a s =>
        change base.separableClosedTensorHom (i.comp F.val) (a ⊗ₜ[K] s) ∈
          Algebra.adjoin base.valuation.Completion (i '' (F : Set S))
        rw [separableClosedTensorHom_tmul]
        exact (Algebra.adjoin base.valuation.Completion (i '' (F : Set S))).mul_mem
          (Subalgebra.algebraMap_mem _ a)
          (Algebra.subset_adjoin ⟨(s : S), s.property, rfl⟩)
    | add z w hz hw =>
        rw [map_add]
        exact (Algebra.adjoin base.valuation.Completion (i '' (F : Set S))).add_mem hz hw
  · apply Algebra.adjoin_le
    rintro x ⟨s, hs, rfl⟩
    refine ⟨1 ⊗ₜ[K] (⟨s, hs⟩ : F), ?_⟩
    change base.separableClosedTensorHom (i.comp F.val) (1 ⊗ₜ[K] (⟨s, hs⟩ : F)) = i s
    rw [separableClosedTensorHom_tmul, map_one, one_mul]
    rfl

end ValuationTheory.DiscreteValuationField.DVF

namespace ValuationTheory.DiscreteValuationField.HenselianDVF

variable {K : Type*} [Field K] (base : HenselianDVF K)
  {S E : Type*} [Field S] [Field E] [Algebra K S]
  [Algebra base.valuation.Completion E] [Algebra K E]
  [IsScalarTower K base.valuation.Completion E]
  (i : S →ₐ[K] E) (F : IntermediateField K S) [Algebra.IsSeparable K F]

/-- Scalar extension of a prescribed separable intermediate field is the
field generated by its image under the given embedding. -/
def completionTensorImageEquiv :
    base.valuation.Completion ⊗[K] F ≃ₐ[base.valuation.Completion]
      IntermediateField.adjoin base.valuation.Completion (i '' (F : Set S)) :=
  (AlgEquiv.ofInjective (base.toDVF.separableClosedTensorHom (i.comp F.val))
    (base.separableClosedTensorHom_injective (i.comp F.val))).trans
      (Subalgebra.equivOfEq _ _
        (base.toDVF.separableClosedTensorHom_range_adjoin_image i F))

/-- This range identification is multiplication of the two specified maps. -/
@[simp] theorem completionTensorImageEquiv_tmul (a : base.valuation.Completion) (x : F) :
    (base.completionTensorImageEquiv i F (a ⊗ₜ[K] x) : E) =
      algebraMap base.valuation.Completion E a * i (x : S) :=
  base.toDVF.separableClosedTensorHom_tmul (i.comp F.val) a x

variable [FiniteDimensional K F] (target : DVF F)
  [hExtension : base.valuation.HasExtension target.valuation]

local instance : Algebra base.valuation.Completion target.valuation.Completion :=
  DVF.completionAlgebra base.toDVF target

/-- The completion of the same finite intermediate field is its image field.
The source algebra is supplied by the actual map of valuation completions. -/
def completionAdjoinImageEquiv :
    @AlgEquiv base.valuation.Completion target.valuation.Completion
      (IntermediateField.adjoin base.valuation.Completion (i '' (F : Set S)))
      _ _ _ (DVF.completionAlgebra base.toDVF target) _ :=
  (DVF.completionTensorEquiv base.toDVF target).symm.trans
    (base.completionTensorImageEquiv i F)

/-- The comparison preserves the original inclusion of each element of `F`. -/
@[simp] theorem completionAdjoinImageEquiv_coe (x : F) :
    (base.completionAdjoinImageEquiv i F target (x : target.valuation.Completion) : E) =
      i (x : S) := by
  have hpre : (DVF.completionTensorEquiv base.toDVF target).symm
      (x : target.valuation.Completion) = 1 ⊗ₜ[K] x := by
    apply (DVF.completionTensorEquiv base.toDVF target).injective
    rw [AlgEquiv.apply_symm_apply, DVF.completionTensorEquiv_tmul, map_one, one_mul]
  change (base.completionTensorImageEquiv i F
    ((DVF.completionTensorEquiv base.toDVF target).symm
      (x : target.valuation.Completion)) : E) = i (x : S)
  rw [hpre, completionTensorImageEquiv_tmul, map_one, one_mul]

end ValuationTheory.DiscreteValuationField.HenselianDVF
