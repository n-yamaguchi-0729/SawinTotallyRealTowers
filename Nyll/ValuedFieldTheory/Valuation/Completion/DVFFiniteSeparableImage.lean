import Nyll.ValuedFieldTheory.Valuation.Completion.WithValScalars
import Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.LinearAlgebra.Dimension.Free
import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic

/-!
# Finite images over the actual valuation completion

The image of a finite extension is contained in the field generated by the
images of a finite linear basis. Those images remain integral after extending
the scalars to the completion. Neither Henselianity nor separability is needed.
-/


namespace ValuationTheory.DiscreteValuationField.DVF

variable {K : Type*} [Field K] (base : DVF K)
  {S E : Type*} [Field S] [Field E] [Algebra K S]
  [Algebra base.valuation.Completion E] [Algebra K E]
  [IsScalarTower K base.valuation.Completion E]

/-- Adjoining the image of a finite intermediate field to the actual
completion gives a finite extension of that completion. -/
theorem finiteDimensional_adjoin_image (i : S →ₐ[K] E)
    (F : IntermediateField K S) [FiniteDimensional K F] :
    FiniteDimensional base.valuation.Completion
      (IntermediateField.adjoin base.valuation.Completion (i '' (F : Set S))) := by
  classical
  let b : Module.Basis (Fin (Module.finrank K F)) K F := Module.finBasis K F
  let h : F →ₐ[K] E := i.comp F.val
  let J : IntermediateField base.valuation.Completion E :=
    IntermediateField.adjoin base.valuation.Completion (Set.range fun j => h (b j))
  have hJ : FiniteDimensional base.valuation.Completion J :=
    IntermediateField.finiteDimensional_adjoin (by
      rintro x ⟨j, rfl⟩
      exact (IsIntegral.map h (Algebra.IsIntegral.isIntegral (R := K) (b j))).tower_top)
  have hspan : Submodule.span K (Set.range b) ≤
      ((J.restrictScalars K).toSubalgebra.comap h).toSubmodule := by
    apply Submodule.span_le.mpr
    rintro x ⟨j, rfl⟩
    exact IntermediateField.subset_adjoin base.valuation.Completion
      (Set.range fun j => h (b j)) ⟨j, rfl⟩
  have hall (x : F) : h x ∈ J := by
    apply hspan
    rw [b.span_eq]
    exact Submodule.mem_top
  have hle : IntermediateField.adjoin base.valuation.Completion (i '' (F : Set S)) ≤ J := by
    apply IntermediateField.adjoin_le_iff.mpr
    rintro x ⟨s, hs, rfl⟩
    exact hall ⟨s, hs⟩
  exact Module.Finite.of_injective (IntermediateField.inclusion hle).toLinearMap
    (IntermediateField.inclusion_injective hle)

end ValuationTheory.DiscreteValuationField.DVF
