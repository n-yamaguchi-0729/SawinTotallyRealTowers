import Mathlib.NumberTheory.Cyclotomic.Gal
import Mathlib.GroupTheory.Coset.Card
import Mathlib.Data.Nat.Totient
import Mathlib.Data.Nat.GCD.Basic

/-!
# Prime-order cyclotomic extensions have prime-to-prime Galois groups

The action on a primitive root embeds the automorphism group into the units
of `ZMod p`. The primitive root and its generating property come from the
cyclotomic extension itself; no irreducibility assumption is needed.
-/

namespace ValuationTheory.DiscreteValuationField

variable (K L : Type*) [Field K] [Field L] [Algebra K L]
    (p : ℕ) [Fact p.Prime] [IsCyclotomicExtension {p} K L]

/-- The Galois group of an extension generated by the `p`-th roots of unity
has order dividing `p - 1`. -/
theorem cyclotomicGalois_natCard_dvd_prime_sub_one :
    Nat.card (L ≃ₐ[K] L) ∣ p - 1 := by
  have hζ := IsCyclotomicExtension.zeta_spec p K L
  calc
    Nat.card (L ≃ₐ[K] L) ∣ Nat.card (ZMod p)ˣ :=
      Subgroup.card_dvd_of_injective (hζ.autToPow K)
        (hζ.autToPow_injective K)
    _ = Fintype.card (ZMod p)ˣ := Nat.card_eq_fintype_card
    _ = Nat.totient p := ZMod.card_units_eq_totient p
    _ = p - 1 := Nat.totient_prime (Fact.out : p.Prime)

/-- The Galois group of a `p`-th cyclotomic extension has order coprime to `p`. -/
theorem prime_coprime_cyclotomicGalois_natCard :
    p.Coprime (Nat.card (L ≃ₐ[K] L)) := by
  have hp : p.Prime := Fact.out
  have hcoprime : p.Coprime (p - 1) :=
    (Nat.coprime_self_sub_right hp.one_le).mpr (Nat.coprime_one_right p)
  exact hcoprime.of_dvd_right
    (cyclotomicGalois_natCard_dvd_prime_sub_one K L p)

end ValuationTheory.DiscreteValuationField
