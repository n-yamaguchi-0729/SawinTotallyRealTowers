module

public import Mathlib.RingTheory.DedekindDomain.Factorization
public import Mathlib.RingTheory.DiscreteValuationRing.Basic
public import Mathlib.RingTheory.FractionalIdeal.Extended
public import Mathlib.RingTheory.RamificationInertia.Ramification

/-!
# Integer powers of the maximal ideal of a DVR

The integer exponent is Mathlib's fractional-ideal `count` at the actual maximal
ideal. Classification and containment include negative powers. Extension of
fractional ideals multiplies the exponent by the actual ramification index.
-/

@[expose] public section

noncomputable section

open scoped nonZeroDivisors
open IsLocalRing IsDedekindDomain

namespace RamificationTheory.DiscreteValuationRing

variable (R K : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
variable [Field K] [Algebra R K] [IsFractionRing R K]

/-- The unique height-one prime of a DVR, with its original ideal carrier. -/
def maximalSpectrum : HeightOneSpectrum R :=
  ⟨maximalIdeal R, inferInstance, IsDiscreteValuationRing.not_a_field R⟩

/-- Every height-one prime of a DVR is its maximal ideal. -/
theorem heightOneSpectrum_eq_maximal (v : HeightOneSpectrum R) :
    v = maximalSpectrum R :=
  HeightOneSpectrum.ext (IsLocalRing.eq_maximalIdeal inferInstance)

/-- A nonzero fractional ideal is the integer power determined by its standard count. -/
theorem fractionalIdeal_eq_maximalIdeal_zpow {I : FractionalIdeal R⁰ K} (hI : I ≠ 0) :
    I = (maximalIdeal R : FractionalIdeal R⁰ K) ^
      FractionalIdeal.count K (maximalSpectrum R) I := by
  classical
  calc
    I = ∏ᶠ v : HeightOneSpectrum R,
        (v.asIdeal : FractionalIdeal R⁰ K) ^ FractionalIdeal.count K v I :=
      (FractionalIdeal.finprod_heightOneSpectrum_factorization' K hI).symm
    _ = _ := finprod_eq_single _ (maximalSpectrum R) fun v hv =>
      (hv (heightOneSpectrum_eq_maximal R v)).elim

/-- Every integer power is the principal fractional ideal generated by the same
power of any uniformizer, including its negative powers. -/
theorem maximalIdeal_zpow_eq_spanSingleton {π : R} (hπ : Irreducible π) (r : ℤ) :
    (maximalIdeal R : FractionalIdeal R⁰ K) ^ r =
      FractionalIdeal.spanSingleton R⁰ (algebraMap R K π ^ r) := by
  rw [hπ.maximalIdeal_eq, FractionalIdeal.coeIdeal_span_singleton, map_zpow₀]

/-- The integer powers of the maximal ideal are ordered by the reverse exponent order. -/
theorem maximalIdeal_zpow_le_iff (r s : ℤ) :
    (maximalIdeal R : FractionalIdeal R⁰ K) ^ r ≤
      (maximalIdeal R : FractionalIdeal R⁰ K) ^ s ↔ s ≤ r := by
  have hm : (maximalIdeal R : FractionalIdeal R⁰ K) ≠ 0 :=
    FractionalIdeal.coeIdeal_ne_zero.mpr (IsDiscreteValuationRing.not_a_field R)
  constructor
  · intro h
    have hcount := FractionalIdeal.count_mono K (maximalSpectrum R)
      (zpow_ne_zero r hm) h
    simpa only [show maximalIdeal R = (maximalSpectrum R).asIdeal from rfl,
      FractionalIdeal.count_zpow_self] using hcount
  · intro h
    have hn : ((r - s).toNat : ℤ) = r - s := Int.toNat_of_nonneg (sub_nonneg.mpr h)
    have hpow : (maximalIdeal R : FractionalIdeal R⁰ K) ^ (r - s) ≤ 1 := by
      rw [← hn, zpow_natCast, ← FractionalIdeal.coeIdeal_pow]
      exact FractionalIdeal.coeIdeal_le_one
    have hmul := mul_le_mul_right hpow ((maximalIdeal R : FractionalIdeal R⁰ K) ^ s)
    have hsum : s + (r - s) = r := by omega
    simpa only [← zpow_add₀ hm, hsum, mul_one] using hmul

/-- The exponent of a nonzero fractional ideal is unique, including for fractional powers. -/
theorem existsUnique_fractionalIdeal_eq_maximalIdeal_zpow
    {I : FractionalIdeal R⁰ K} (hI : I ≠ 0) :
    ∃! r : ℤ, I = (maximalIdeal R : FractionalIdeal R⁰ K) ^ r := by
  refine ⟨FractionalIdeal.count K (maximalSpectrum R) I,
    fractionalIdeal_eq_maximalIdeal_zpow R K hI, ?_⟩
  intro r hr
  rw [hr]
  exact (FractionalIdeal.count_zpow_self K (maximalSpectrum R) r).symm

/-- Containment of nonzero fractional ideals is detected by their standard exponents. -/
theorem fractionalIdeal_le_iff_count_le {I J : FractionalIdeal R⁰ K}
    (hI : I ≠ 0) (hJ : J ≠ 0) :
    I ≤ J ↔ FractionalIdeal.count K (maximalSpectrum R) J ≤
      FractionalIdeal.count K (maximalSpectrum R) I := by
  conv_lhs =>
    rw [fractionalIdeal_eq_maximalIdeal_zpow R K hI,
      fractionalIdeal_eq_maximalIdeal_zpow R K hJ]
  exact maximalIdeal_zpow_le_iff R K _ _

/-- The natural-power classification of integral ideals, using the same maximal ideal. -/
theorem ideal_eq_maximalIdeal_pow {I : Ideal R} (hI : I ≠ ⊥) :
    ∃ n : ℕ, I = maximalIdeal R ^ n := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  obtain ⟨n, hn⟩ := IsDiscreteValuationRing.ideal_eq_span_pow_irreducible hI hπ
  exact ⟨n, by rw [hπ.maximalIdeal_eq, Ideal.span_singleton_pow]; exact hn⟩

include K in
/-- Containment of ordinary maximal-ideal powers is the same reverse exponent order. -/
theorem maximalIdeal_pow_le_iff (r s : ℕ) :
    maximalIdeal R ^ r ≤ maximalIdeal R ^ s ↔ s ≤ r := by
  rw [← FractionalIdeal.coeIdeal_le_coeIdeal K,
    FractionalIdeal.coeIdeal_pow, FractionalIdeal.coeIdeal_pow,
    ← zpow_natCast, ← zpow_natCast, maximalIdeal_zpow_le_iff R K]
  exact Int.ofNat_le

section Extension

variable (B L : Type*) [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
variable [Algebra R B] [Module.IsTorsionFree R B] [Algebra.IsIntegral R B]
variable [Field L] [Algebra B L] [IsFractionRing B L]

/-- Extension of the base maximal ideal is the ramification-index power of the
target maximal ideal. -/
theorem map_maximalIdeal_eq_pow_ramificationIdx :
    Ideal.map (algebraMap R B) (maximalIdeal R) =
      maximalIdeal B ^ (maximalIdeal B).ramificationIdx R := by
  let : (maximalIdeal B).LiesOver (maximalIdeal R) :=
    ⟨(IsLocalRing.eq_maximalIdeal (Ideal.IsMaximal.under R (maximalIdeal B))).symm⟩
  have hmap : Ideal.map (algebraMap R B) (maximalIdeal R) ≠ ⊥ :=
    Ideal.map_ne_bot_of_ne_bot (IsDiscreteValuationRing.not_a_field R)
  obtain ⟨n, hn⟩ := ideal_eq_maximalIdeal_pow B hmap
  have he : (maximalIdeal R).ramificationIdx' (maximalIdeal B) = n := by
    apply Ideal.ramificationIdx'_spec hn.le
    intro h
    rw [hn, maximalIdeal_pow_le_iff B (FractionRing B)] at h
    omega
  rw [← Ideal.ramificationIdx'_eq_ramificationIdx (maximalIdeal R) (maximalIdeal B)
    (IsDiscreteValuationRing.not_a_field R), he]
  exact hn

/-- Base extension multiplies every integer exponent by the actual ramification index. -/
theorem extended_maximalIdeal_zpow (r : ℤ) :
    FractionalIdeal.extendedHom L B ((maximalIdeal R : FractionalIdeal R⁰ K) ^ r) =
      (maximalIdeal B : FractionalIdeal B⁰ L) ^
        (((maximalIdeal B).ramificationIdx R : ℤ) * r) := by
  rw [map_zpow₀, FractionalIdeal.extendedHom_coeIdeal_eq_map,
    map_maximalIdeal_eq_pow_ramificationIdx R B, FractionalIdeal.coeIdeal_pow,
    ← zpow_natCast, ← zpow_mul]

/-- Extension carries a maximal-ideal power into the power scaled by the actual
ramification index. -/
theorem map_mem_maximalIdeal_pow_mul {x : R} {m : ℕ}
    (hx : x ∈ maximalIdeal R ^ m) :
    algebraMap R B x ∈ maximalIdeal B ^ ((maximalIdeal B).ramificationIdx R * m) := by
  rw [pow_mul, ← map_maximalIdeal_eq_pow_ramificationIdx R B, ← Ideal.map_pow]
  exact Ideal.mem_map_of_mem (algebraMap R B) hx

/-- Contracting an upstairs power strictly above `e * (m - 1)` gives the
`m`-th power downstairs. This applies to every integral extension of DVRs. -/
theorem mem_maximalIdeal_pow_of_map_mem {x : R} {r m : ℕ}
    (hr : (maximalIdeal B).ramificationIdx R * (m - 1) < r)
    (hx : algebraMap R B x ∈ maximalIdeal B ^ r) :
    x ∈ maximalIdeal R ^ m := by
  by_cases hx0 : x = 0
  · rw [hx0]
    exact Ideal.zero_mem _
  obtain ⟨j, hj⟩ := ideal_eq_maximalIdeal_pow R
    (show Ideal.span ({x} : Set R) ≠ ⊥ from by
      rwa [ne_eq, Ideal.span_singleton_eq_bot])
  have hspan : Ideal.span ({algebraMap R B x} : Set B) =
      maximalIdeal B ^ ((maximalIdeal B).ramificationIdx R * j) := by
    rw [← Set.image_singleton, ← Ideal.map_span, hj, Ideal.map_pow,
      map_maximalIdeal_eq_pow_ramificationIdx R B, ← pow_mul]
  have hdepth := (Ideal.span_singleton_le_iff_mem _).mpr hx
  rw [hspan, maximalIdeal_pow_le_iff B (FractionRing B)] at hdepth
  have hmj : m ≤ j := by
    by_contra h
    have hjm : j ≤ m - 1 := by omega
    have hmul := Nat.mul_le_mul_left ((maximalIdeal B).ramificationIdx R) hjm
    omega
  apply (Ideal.span_singleton_le_iff_mem _).mp
  rw [hj, maximalIdeal_pow_le_iff R (FractionRing R)]
  exact hmj

end Extension

end RamificationTheory.DiscreteValuationRing
